{
  "name": "voidhaus",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0",
    "node": "24.x"
  },
  "scripts": {
    "dev": "doppler run -- vite dev",
    "build": "vite build && bun scripts/sitemap.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "lint": "biome check .",
    "lint:fix": "biome check . --write"
  },
  "dependencies": {
    "@fontsource-variable/cormorant": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@sentry/sveltekit": "^11.8.0",
    "convex": "^1.42.1",
    "stripe": "^23.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@sveltejs/adapter-vercel": "^7.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.0.0",
    "knip": "^6.26.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^5.0.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#convex/*": "./convex/_generated/*"
  }
}
