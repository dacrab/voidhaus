{
  "name": "voidhaus",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0",
    "node": "24.x"
  },
  "scripts": {
    "dev": "doppler run -- vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "lint": "biome check .",
    "lint:fix": "biome check . --write"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@sentry/sveltekit": "^11.8.0",
    "convex": "^1.42.1",
    "stripe": "^23.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@sveltejs/adapter-vercel": "7.0.2",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "knip": "6.44.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#convex/*": "./convex/_generated/*"
  }
}
