{
  "name": "voidhaus",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "doppler run -- vite dev",
    "build": "vite build && bun scripts/sitemap.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "lint": "biome check .",
    "lint:fix": "biome check . --write"
  },
  "dependencies": {
    "@fontsource-variable/cormorant": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@sentry/sveltekit": "^10.64.0",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "convex": "^1.42.1",
    "stripe": "^22.3.0",
    "svelte": "^5.56.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "knip": "^6.26.0",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.10.1",
    "svelte-check": "^4.7.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}