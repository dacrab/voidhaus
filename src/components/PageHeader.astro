---
interface Props {
  label: string;
  title: string;
  aside?: string;
}
const { label, title, aside } = Astro.props;
---

<div class="ph wrap pt-[var(--nav-h)]">
  <div class="ph-inner">
    <div class="ph-left">
      <span class="label muted" data-anim="hero">{label}</span>
      <h1 class="ph-title" data-anim="hero" data-delay="0.1" style="font-variation-settings:var(--font-weight-light)">{title}</h1>
    </div>
    {aside && <span class="label muted self-end pb-[0.3rem]" data-anim="hero" data-delay="0.2">{aside}</span>}
  </div>
  <div class="rule"></div>
</div>
