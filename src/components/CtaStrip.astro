---
interface Props {
  label?: string;
  href:   string;
  cta:    string;
}
const { label = 'Ready?', href, cta } = Astro.props;
---

<div class="cta wrap" data-anim="scroll">
  <div class="rule"></div>
  <div class="cta-inner">
    <span class="label op-35">{label}</span>
    <a {href} class="label cta-link">{cta}</a>
  </div>
  <div class="rule"></div>
</div>

<style>
  .cta { padding-block: 1.5rem 4rem; }
  .cta-inner {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 0.75rem; padding-block: 1.5rem;
  }
  .cta-link { opacity: 0.4; transition: opacity 0.2s; }
  .cta-link:hover { opacity: 1; }
</style>
