---
interface Props {
  label?:  string;
  href:    string;
  cta:     string;
}

const { label = 'Ready?', href, cta } = Astro.props;
---

<div class="cta-strip wrap" data-anim="scroll">
  <div class="rule"></div>
  <div class="cta-strip-inner">
    <span class="label op-35">{label}</span>
    <a {href} class="label cta-strip-link">{cta}</a>
  </div>
  <div class="rule"></div>
</div>

<style>
  .cta-strip { padding-block: 1.5rem 4rem; }
  .cta-strip-inner {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 0.75rem; padding-block: 1.5rem;
  }
  .cta-strip-link { opacity: 0.4; transition: opacity 0.2s; }
  .cta-strip-link:hover { opacity: 1; }
</style>
