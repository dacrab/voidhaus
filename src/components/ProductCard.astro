---
import { Picture } from 'astro:assets';
import { IMAGES } from '../assets/images';
import { formatPrice } from '../data/products';

interface Props {
  slug:      string;
  num:       string;
  name:      string;
  price:     number;
  img:       string;
  category?: string;
  imgWidth?: number;
}

const { slug, num, name, price, img, category, imgWidth = 800 } = Astro.props;
---

<article class="pc" data-category={category}>
  <a href={`/product/${slug}`} aria-label={`${name} — € ${formatPrice(price)}`}>
    <div class="pc-img-wrap">
      <Picture
        class="pc-img"
        src={IMAGES[img]}
        formats={['avif', 'webp']}
        alt={name}
        loading="lazy"
        decoding="async"
        width={imgWidth}
        transition:name={`product-img-${slug}`}
      />
    </div>
    <div class="card-info">
      <div class="card-info-l">
        <span class="label muted">{num}</span>
        <span class="card-name">{name}</span>
        {category && <span class="label muted card-cat">{category}</span>}
      </div>
      <span class="label muted">€ {formatPrice(price)}</span>
    </div>
  </a>
</article>

<style>
  .pc { background: var(--color-white); }
  .pc a { display: block; }

  .pc-img-wrap {
    aspect-ratio: 3/4;
    overflow: hidden;
    background: var(--color-off);
  }

  .pc-img img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center top;
    display: block;
    transition: transform 0.9s var(--ease-img);
  }
  .pc a:hover .pc-img img { transform: scale(1.03); }
</style>
