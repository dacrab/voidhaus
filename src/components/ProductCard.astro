---
import { Picture } from 'astro:assets';
import { IMAGES } from '@assets/images';

interface Props {
  slug:      string;
  num:       string;
  name:      string;
  price:     number;
  img:       string;
  img2?:     string;
  category?: string;
  imgWidth?: number;
}

const { slug, num, name, price, img, img2, category, imgWidth = 800 } = Astro.props;
---

<article class="pc" data-category={category}>
  <a class="block" href={`/product/${slug}`} aria-label={`${name} — € ${price.toLocaleString('en-US')}`}>
    <div class="pc-media relative aspect-[3/4] overflow-hidden bg-[var(--color-off)]">
      <Picture
        class="pc-img pc-primary"
        src={IMAGES[img]}
        formats={['avif', 'webp']}
        alt={name}
        loading="lazy"
        decoding="async"
        width={imgWidth}
      />
      {img2 && IMAGES[img2] && (
        <Picture
          class="pc-img pc-alt absolute inset-0 opacity-0 pointer-events-none"
          src={IMAGES[img2]}
          formats={['avif', 'webp']}
          alt=""
          loading="lazy"
          decoding="async"
          width={imgWidth}
          aria-hidden="true"
        />
      )}
    </div>
    <div class="card-info">
      <div class="card-info-l">
        <span class="label muted">{num}</span>
        <span class="card-name">{name}</span>
        {category && <span class="label muted">{category}</span>}
      </div>
      <span class="label muted card-price">€ {price.toLocaleString('en-US')}</span>
    </div>
  </a>
</article>

<style>
.pc-img img {
  object-fit: cover;
  object-position: center top;
  transition: transform var(--duration-slowest) var(--ease-img), opacity 0.5s ease;
}
@media (hover: hover) {
  .pc a:hover .pc-primary img { transform: scale(1.04); }
  .pc a:hover .pc-alt         { opacity: 1; }
  .pc a:hover .pc-alt img     { transform: scale(1.02); }
}
</style>
