---
import Layout from '../layouts/Layout.astro';

interface Props {
  title:       string;
  description: string;
  updated:     string;
  sibling:     { href: string; label: string };
  sections:    { title: string; body: string }[];
}

const { title, description, updated, sibling, sections } = Astro.props;
---

<Layout title={title} description={description} solidNav={true}>
  <div class="legal-page wrap">

    <div class="legal-header page-top-spacing">
      <div class="lh-inner">
        <span class="label muted">Legal</span>
        <h1 class="legal-title" data-anim="hero" data-delay="0.1">{title}</h1>
      </div>
      <div class="rule"></div>
      <p class="legal-meta label muted">Last updated: {updated}</p>
    </div>

    <div class="legal-body">
      <div class="legal-nav">
        <a href={sibling.href} class="label muted muted-link">{sibling.label} →</a>
        <a href="/stockists"   class="label muted muted-link">Stockists →</a>
      </div>

      {sections.map(s => (
        <div class="legal-section" data-anim="scroll">
          <h2 class="legal-section-title">{s.title}</h2>
          <p  class="legal-section-body">{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</Layout>

<script>
import { onReady, reveal } from '../lib/animate';
onReady(() => reveal());
</script>

<style>
  .legal-page  { padding-bottom: 6rem; }
  .legal-header { padding-bottom: 0; }

  .lh-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 1.5rem;
  }

  .legal-title {
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 5vw, 4rem);
    font-variation-settings: 'wght' 200;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-ink);
  }

  .legal-meta { padding-block: 1.25rem; }

  .legal-body { padding-top: 1rem; }

  .legal-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-block: 3rem 2rem;
    border-bottom: 1px solid var(--color-rule);
  }


  .legal-section {
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--color-rule);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .legal-section { grid-template-columns: 200px 1fr; gap: 3rem; }
  }

  .legal-section-title {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-variation-settings: 'wght' 400;
    color: var(--color-ink);
    letter-spacing: 0.01em;
  }

  .legal-section-body {
    font-size: 0.875rem;
    font-variation-settings: 'wght' 300;
    line-height: 1.9;
    color: var(--color-soft);
    max-width: 62ch;
  }
</style>
