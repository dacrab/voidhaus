---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/PageHeader.astro';

interface Props {
  title:       string;
  description: string;
  updated:     string;
  sibling:     { href: string; label: string };
  sections:    { title: string; body: string }[];
}

const { title, description, updated, sibling, sections } = Astro.props;
---

<Layout title={title} description={description} solidNav={true}>
  <PageHeader label={updated} title={title} />

  <div class="legal wrap pb-[var(--space-4xl)]">
    <div class="grid pt-[var(--space-2xl)] min-[900px]:grid-cols-[200px_1fr] min-[900px]:gap-[var(--space-4xl)] min-[900px]:items-start">

      <nav class="flex flex-col gap-[var(--space-sm)] pb-[var(--space-2xl)] max-[899px]:flex-row min-[900px]:sticky min-[900px]:top-[calc(var(--nav-h)+2rem)]" aria-label="Legal navigation">
        <a href={sibling.href} class="label muted muted-link">{sibling.label} →</a>
        <a href="/stockists"   class="label muted muted-link">Stockists →</a>
      </nav>

      <div>
        {sections.map((s, i) => (
          <div class:list={['flex flex-col gap-[var(--space-sm)] py-8 border-b border-[var(--color-rule)] min-[900px]:py-10', { 'border-t border-[var(--color-rule)] min-[900px]:border-t-0': i === 0 }]} data-anim="scroll">
            <h2 class="label text-[var(--color-ink)]">{s.title}</h2>
            <p class="text-[var(--text-base)] leading-[1.85] text-[var(--color-soft)] max-w-[60ch]" style="font-variation-settings:var(--font-weight-normal)">{s.body}</p>
          </div>
        ))}
      </div>

    </div>
  </div>
</Layout>

<script>
import { initPage, onReady } from '@lib/animate';
document.addEventListener('astro:page-load', () => {
  onReady(() => { initPage('.ph .rule'); });
});
</script>

