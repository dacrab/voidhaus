---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/PageHeader.astro';

interface Props {
  title:       string;
  description: string;
  updated:     string;
  sibling:     { href: string; label: string };
  sections:    { title: string; body: string }[];
}

const { title, description, updated, sibling, sections } = Astro.props;
---

<Layout title={title} description={description} solidNav={true}>
  <PageHeader label={updated} title={title} />

  <div class="wrap pb-4xl">
    <div class="grid pt-2xl md:grid-cols-[200px_1fr] md:gap-4xl md:items-start">

      <nav class="flex flex-col gap-sm pb-2xl max-md:flex-row md:sticky md:top-[calc(var(--nav-h)+2rem)]" aria-label="Legal navigation">
        <a href={sibling.href} class="label muted muted-link">{sibling.label} →</a>
        <a href="/stockists"   class="label muted muted-link">Stockists →</a>
      </nav>

      <div>
        {sections.map((s, i) => (
          <div class:list={['flex flex-col gap-sm py-8 border-b border-[var(--color-rule)] md:py-10', { 'border-t border-[var(--color-rule)] md:border-t-0': i === 0 }]} data-anim="scroll">
            <h2 class="label text-[var(--color-ink)]">{s.title}</h2>
            <p class="text-base fw-normal leading-[1.85] text-[var(--color-soft)] max-w-[60ch]">{s.body}</p>
          </div>
        ))}
      </div>

    </div>
  </div>
</Layout>

<script>
import { initPage, onReady } from '@lib/animate';
document.addEventListener('astro:page-load', () => {
  onReady(() => { initPage('.ph .rule'); });
});
</script>
