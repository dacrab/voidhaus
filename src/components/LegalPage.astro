---
import Layout from '../layouts/Layout.astro';

interface Props {
  title:       string;
  description: string;
  updated:     string;
  sibling:     { href: string; label: string };
  sections:    { title: string; body: string }[];
}

const { title, description, updated, sibling, sections } = Astro.props;
---

<Layout title={title} description={description} solidNav={true}>
  <div class="legal wrap">

    <div class="legal-head page-top-spacing">
      <div class="lh-top">
        <span class="label muted">Legal</span>
        <h1 class="legal-title" data-anim="hero" data-delay="0.1">{title}</h1>
      </div>
      <div class="rule"></div>
      <p class="legal-meta label muted">Last updated: {updated}</p>
    </div>

    <div class="legal-body">
      <nav class="legal-nav" aria-label="Legal navigation">
        <a href={sibling.href} class="label muted muted-link">{sibling.label} →</a>
        <a href="/stockists"   class="label muted muted-link">Stockists →</a>
      </nav>

      {sections.map(s => (
        <div class="legal-section" data-anim="scroll">
          <h2 class="section-title">{s.title}</h2>
          <p  class="section-body">{s.body}</p>
        </div>
      ))}
    </div>

  </div>
</Layout>

<script>
import { onPageLoad, pageReveal } from '../lib/animate';

onPageLoad(() => pageReveal());
</script>

<style>
  .legal { padding-bottom: 6rem; }

  .legal-head { padding-bottom: 0; }

  .lh-top {
    display: flex; flex-direction: column;
    gap: 0.75rem; padding-bottom: 1.5rem;
  }

  .legal-title {
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 5vw, 3.5rem);
    font-variation-settings: 'wght' 300;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .legal-meta { display: block; padding-block: 1rem; }

  .legal-body {
    display: grid;
    padding-top: 3rem;
  }
  @media (min-width: 900px) {
    .legal-body {
      grid-template-columns: 200px 1fr;
      gap: 6rem;
      align-items: start;
    }
  }

  .legal-nav {
    display: flex; flex-direction: column; gap: 0.75rem;
    padding-bottom: 3rem;
    position: sticky; top: calc(var(--nav-h) + 2rem);
  }
  @media (max-width: 899px) { .legal-nav { position: static; flex-direction: row; } }

  .legal-section {
    padding-block: 2rem;
    border-bottom: 1px solid var(--color-rule);
    display: flex; flex-direction: column; gap: 0.75rem;
  }
  .legal-section:first-of-type { border-top: 1px solid var(--color-rule); }
  @media (min-width: 900px) {
    .legal-section:first-of-type { border-top: none; }
    .legal-section { padding-block: 2.5rem; }
  }

  .section-title {
    font-size: 0.875rem;
    font-variation-settings: 'wght' 400;
    color: var(--color-ink);
    letter-spacing: 0;
  }

  .section-body {
    font-size: 0.875rem;
    font-variation-settings: 'wght' 300;
    line-height: 1.85;
    color: var(--color-soft);
    max-width: 60ch;
  }
</style>
