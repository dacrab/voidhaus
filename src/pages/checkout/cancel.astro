---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/PageHeader.astro';
---

<Layout title="Checkout Cancelled — VOIDHAUS" description="Your checkout was cancelled.">
  <PageHeader title="Checkout Cancelled" />
  <section class="cancel-section">
    <p class="cancel-msg">Your checkout was cancelled. Your selection is still saved.</p>
    <a href="/collection" class="label continue-link">Return to Collection →</a>
  </section>
</Layout>

<style>
  .cancel-section {
    max-width: 600px;
    margin: var(--spacing-3xl) auto;
    padding: 0 var(--spacing-lg);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }
  .cancel-msg { font-size: var(--text-base); line-height: 1.6; }
  .continue-link {
    display: inline-block;
    margin-top: var(--spacing-lg);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink);
    opacity: var(--op-muted);
    transition: opacity var(--duration-fast);
  }
  .continue-link:hover { opacity: 1; }
</style>
