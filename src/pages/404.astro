---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not Found" description="Page not found.">
  <div class="nf wrap">
    <div class="nf-inner">
      <span class="label muted">404</span>
      <h1 class="nf-title serif">Not<br/><em>found.</em></h1>
      <p class="nf-body">
        This page doesn't exist — or has been removed.<br/>
        The collection remains.
      </p>
      <div class="nf-links">
        <a href="/" class="label muted-link">← Home</a>
        <a href="/collection" class="label muted-link">Collection →</a>
      </div>
    </div>
    <div class="nf-bg" aria-hidden="true">404</div>
  </div>
</Layout>

<style>
  .nf {
    position: relative;
    min-height: calc(100svh - 5rem);
    display: flex; align-items: center;
    overflow: hidden;
  }

  .nf-inner {
    position: relative; z-index: 1;
    display: flex; flex-direction: column;
    gap: var(--space-xl); padding-block: 8rem 5rem;
  }

  .nf-title {
    font-size: clamp(3.5rem, 10vw, 8rem);
    font-style: italic; font-variation-settings: var(--font-weight-medium);
    letter-spacing: -0.03em; line-height: 0.95;
    color: var(--color-ink);
  }
  .nf-title em { font-style: normal; color: var(--color-mid); }

  .nf-body {
    font-size: var(--text-base); font-variation-settings: var(--font-weight-normal);
    line-height: 1.85; color: var(--color-soft); max-width: 32ch;
  }

  .nf-links {
    display: flex; gap: 2.5rem; align-items: center;
    padding-top: var(--space-md); border-top: 1px solid var(--color-rule);
  }

  .nf-bg {
    position: absolute; right: -0.05em; bottom: -0.15em;
    font-family: var(--font-sans);
    font-size: clamp(12rem, 35vw, 32rem);
    font-variation-settings: var(--font-weight-light);
    letter-spacing: -0.06em; line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-rule);
    pointer-events: none; user-select: none;
  }
</style>
