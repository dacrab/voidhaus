---
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import ProductCard from '../components/ProductCard.astro';
import CtaStrip from '../components/CtaStrip.astro';
import { PRODUCTS } from '../data/products';
import { IMAGES } from '../assets/images';

const featured = PRODUCTS.slice(0, 4);
---

<Layout>

  <section class="hero">
    <div class="hero-media">
      <Picture
        class="hero-img js-hero-img"
        src={IMAGES['hero']}
        formats={['avif', 'webp']}
        alt="VOIDHAUS SS 2026"
        fetchpriority="high"
        decoding="async"
        width={1800}
        transition:name="site-hero"
      />
      <div class="hero-scrim"></div>
    </div>
    <div class="hero-body wrap">
      <span class="label hero-season js-hero-season">SS 2026</span>
      <h1 class="hero-title js-hero-title">VOIDHAUS</h1>
      <a href="/collection" class="label hero-cta js-hero-cta">
        New Collection →
      </a>
    </div>
  </section>

  <section class="products wrap">
    <div class="products-head">
      <span class="label muted">SS 2026 — New Arrivals</span>
      <a href="/collection" class="label muted muted-link">All ({PRODUCTS.length}) →</a>
      <div class="rule"></div>
    </div>
    <div class="product-grid">
      {featured.map(p => <ProductCard {...p} />)}
    </div>
  </section>

  <section class="editorial" data-anim="scroll">
    <div class="ed-media">
      <Picture
        class="ed-img"
        src={IMAGES['editorial']}
        formats={['avif', 'webp']}
        alt="Voidhaus editorial SS 2026"
        loading="lazy"
        decoding="async"
        width={1800}
      />
      <div class="ed-scrim"></div>
    </div>
    <div class="ed-text wrap">
      <p class="serif ed-quote">"The most radical act<br/>is <em>silence.</em>"</p>
      <a href="/about" class="label ed-link">Read manifesto →</a>
    </div>
  </section>

  <CtaStrip label="Press & Inquiries" href="/contact" cta="studio@voidhaus.com →" />

</Layout>

<script>
import { onReady, reveal, heroParallax, lineReveal, cardsCascade } from '../lib/animate';
import gsap from 'gsap';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    // Hero image first
    heroParallax('.js-hero-img');

    // Hero text — tight orchestrated sequence, all from hidden
    const season = document.querySelector<HTMLElement>('.js-hero-season');
    const title  = document.querySelector<HTMLElement>('.js-hero-title');
    const cta    = document.querySelector<HTMLElement>('.js-hero-cta');

    gsap.set([season, title, cta], { opacity: 0 });

    const tl = gsap.timeline({ delay: 0.2 });
    tl.fromTo(season,
      { opacity: 0, y: 10 },
      { opacity: 1, y: 0, duration: 0.6, ease: 'expo.out' },
    )
    .fromTo(title,
      { opacity: 0, y: 36, skewY: 2 },
      { opacity: 1, y: 0, skewY: 0, duration: 1.0, ease: 'expo.out', clearProps: 'skewY' },
      '-=0.35',
    )
    .fromTo(cta,
      { opacity: 0, y: 12 },
      { opacity: 1, y: 0, duration: 0.6, ease: 'expo.out' },
      '-=0.5',
    );

    // Scroll-triggered elements (editorial)
    reveal();

    // Products section: rule draws in, cards cascade
    lineReveal('.products-head .rule', 0.1);
    cardsCascade('.products .pc');
  });
});
</script>

<style>
/* ── Hero ──────────────────────────────────────────────────────────────── */
.hero {
  position: relative;
  height: 100svh;
  min-height: 560px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
  margin-block-start: 0;
}

.hero-media { position: absolute; inset: 0; overflow: hidden; }

.hero-img,
.hero-img img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center 20%;
  display: block;
  transform-origin: center center;
}

.hero-scrim {
  position: absolute; inset: 0;
  background:
    linear-gradient(to bottom, transparent 40%, rgb(28 27 25 / 0.7) 100%),
    linear-gradient(to top, transparent 85%, rgb(28 27 25 / 0.1) 100%);
}

.hero-body {
  position: relative; z-index: 1;
  padding-bottom: 3rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.hero-season { color: rgb(255 255 255 / 0.55); }

.hero-title {
  font-family: var(--font-sans);
  font-size: clamp(4rem, 14vw, 13rem);
  font-variation-settings: 'wght' 200;
  letter-spacing: -0.05em;
  line-height: 0.92;
  color: rgb(255 255 255 / 0.92);
}

.hero-cta {
  color: rgb(255 255 255 / 0.55);
  transition: color 0.2s;
  align-self: flex-start;
}
.hero-cta:hover { color: #fff; }

/* ── Products ──────────────────────────────────────────────────────────── */
.products { padding-block: 4rem 3rem; }
@media (min-width: 768px) { .products { padding-block: 6rem 4rem; } }

.products-head {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
  padding-bottom: 0;
  gap: 1rem;
}

/* Override grid to 4-col on desktop for home page featured strip */
.products .product-grid {
  grid-template-columns: repeat(2, 1fr);
}
@media (min-width: 768px) { .products .product-grid { grid-template-columns: repeat(4, 1fr); } }

/* ── Editorial ─────────────────────────────────────────────────────────── */
.editorial {
  position: relative; height: 75svh; min-height: 420px;
  margin-block: 5rem; overflow: hidden;
}
@media (min-width: 768px) { .editorial { height: 85svh; margin-block: 7rem; } }

.ed-media { position: absolute; inset: 0; }
.ed-img, .ed-img img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
.ed-scrim {
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgb(28 27 25 / 0.72) 0%, rgb(28 27 25 / 0.2) 60%, transparent 100%);
}
.ed-text {
  position: absolute; inset-block-end: 3rem; inset-inline: 0;
  display: flex; flex-direction: column; gap: 1.5rem;
}
@media (min-width: 768px) { .ed-text { inset-block-end: 4rem; max-width: 52%; } }

.ed-quote {
  font-size: clamp(1.75rem, 5vw, 4rem);
  font-style: italic; line-height: 1.12; letter-spacing: -0.02em;
  color: rgb(255 255 255 / 0.9);
}
.ed-quote em { font-style: normal; color: rgb(255 255 255 / 0.4); }
.ed-link { color: rgb(255 255 255 / 0.5); transition: color 0.2s; }
.ed-link:hover { color: #fff; }

</style>
