---
import Layout from '@layouts/Layout.astro';
import { Picture } from 'astro:assets';
import ProductCard from '@components/ProductCard.astro';
import CTAStrip from '@components/CTAStrip.astro';
import { PRODUCTS } from '@data/products';
import { IMAGES } from '@assets/images';

const featured = PRODUCTS.slice(0, 4);
---

<Layout>

  <section class="hero">
    <Picture
      class="js-hero-img absolute inset-0 w-full h-full"
      src={IMAGES['hero']}
      formats={['avif', 'webp']}
      alt="VOIDHAUS SS 2026"
      fetchpriority="high"
      decoding="async"
      width={1800}
      transition:name="site-hero"
    />
    <div class="hero-scrim scrim"></div>
    <div class="relative z-10 flex flex-col">
      <span class="label js-hero-season ot-secondary hero-season">SS 2026</span>
      <h1 class="hero-title js-hero-title fw-light ot-primary">VOIDHAUS</h1>
      <div class="wrap flex items-baseline justify-between pb-2xl border-t border-white/10 pt-md">
        <span class="label js-hero-cta ot-muted tracking-[0.3em]">Scroll</span>
        <span class="label js-hero-tagline ot-muted hidden sm:block">Twelve pieces. One position.</span>
      </div>
    </div>
  </section>

  <section class="wrap py-4xl md:py-5xl">
    <div class="flex items-center justify-between pb-md">
      <span class="label muted">SS 2026 — New Arrivals</span>
      <a href="/collection" class="label muted muted-link">All ({PRODUCTS.length}) →</a>
    </div>
    <div class="rule"></div>
    <div class="product-grid featured-grid">
      {featured.map(p => <ProductCard {...p} />)}
    </div>
  </section>

  <section class="editorial" data-anim="scroll">
    <div class="absolute inset-0">
      <Picture
        class="ed-img"
        src={IMAGES['editorial']}
        formats={['avif', 'webp']}
        alt="Voidhaus editorial SS 2026"
        loading="lazy"
        decoding="async"
        width={1800}
      />
      <div class="ed-scrim scrim"></div>
    </div>
    <div class="wrap ed-text flex flex-col gap-lg">
      <p class="serif ed-quote ot-primary italic leading-[1.12] tracking-tight">"The most radical act<br/>is <em class="not-italic ot-muted">silence.</em>"</p>
      <a href="/about" class="label ot-secondary transition-colors duration-[var(--duration-fast)] hover:text-white">Read manifesto →</a>
    </div>
  </section>

  <CTAStrip label="Press & Inquiries" linkText="studio@voidhaus.com" href="/contact" />

</Layout>

<script>
import { initPage, onReady, gsap, EASE, DUR } from '@lib/animate';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    const morphed = document.documentElement.hasAttribute('data-astro-transition');

    const img = document.querySelector<HTMLElement>('.js-hero-img');
    if (img) {
      if (morphed) gsap.set(img, { opacity: 1, scale: 1.08 });
      else gsap.fromTo(img, { opacity: 0, scale: 1.12 }, { opacity: 1, scale: 1.08, duration: DUR.slow, ease: 'power3.out' });
      ScrollTrigger.create({
        trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 2,
        onUpdate: st => gsap.set(img, { yPercent: st.progress * -5 }),
      });
    }

    const title   = document.querySelector<HTMLElement>('.js-hero-title');
    const season  = document.querySelector<HTMLElement>('.js-hero-season');
    const cta     = document.querySelector<HTMLElement>('.js-hero-cta');
    const tagline = document.querySelector<HTMLElement>('.js-hero-tagline');

    if (!morphed && title) {
      gsap.timeline({ delay: 0.4 })
        .fromTo(title,   { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: DUR.major, ease: EASE }, 0)
        .fromTo(season,  { opacity: 0 },         { opacity: 1, duration: DUR.minor, ease: EASE }, 0.3)
        .fromTo(cta,     { opacity: 0, y: 12 },  { opacity: 1, y: 0, duration: DUR.minor, ease: EASE }, 0.5)
        .fromTo(tagline, { opacity: 0 },          { opacity: 1, duration: DUR.minor, ease: EASE }, 0.6)
        .call(() => initPage(), [], 0.7);
    } else {
      initPage();
    }
  });
});
</script>

<style>
/* Full-bleed hero — break out of any parent padding */
.hero {
  position: relative;
  width: 100vw;
  height: 100svh;
  min-height: 600px;
  margin-inline: calc(50% - 50vw);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}

.hero-scrim {
  position: absolute; inset: 0; pointer-events: none;
  background:
    linear-gradient(to bottom, transparent 30%, rgb(28 27 25 / 0.55) 100%),
    linear-gradient(to top, transparent 92%, rgb(28 27 25 / 0.3) 100%);
}

.hero-season {
  position: absolute;
  top: calc(var(--nav-h) + var(--spacing-lg));
  left: clamp(var(--spacing-lg), 5vw, var(--spacing-4xl));
}

.hero-title {
  font-size: clamp(3rem, 18vw, 18rem);
  letter-spacing: -0.06em;
  line-height: 0.88;
  padding-inline: clamp(var(--spacing-lg), 5vw, var(--spacing-4xl));
  padding-bottom: var(--spacing-lg);
}

/* Featured: 2-col → 4-col lg */
.featured-grid { grid-template-columns: repeat(2, 1fr); }
@media (min-width: 1024px) { .featured-grid { grid-template-columns: repeat(4, 1fr); } }

/* Editorial */
.editorial {
  position: relative;
  height: 75svh; min-height: 420px;
  margin-block: 7rem;
  overflow: hidden;
}
@media (min-width: 768px) { .editorial { height: 85svh; margin-block: 10rem; } }

.ed-scrim {
  background: linear-gradient(135deg, var(--scrim-heavy) 0%, var(--scrim-light) 60%, transparent 100%);
}

.ed-text {
  position: absolute;
  bottom: 3rem; inset-inline: 0;
}
@media (min-width: 768px) { .ed-text { bottom: 4rem; max-width: 45%; } }

.ed-quote { font-size: clamp(1.75rem, 5vw, 4rem); }
</style>
