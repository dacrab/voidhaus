---
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import ProductCard from '../components/ProductCard.astro';
import CTAStrip from '../components/CTAStrip.astro';
import { PRODUCTS } from '../data/products';
import { IMAGES } from '../assets/images';

const featured = PRODUCTS.slice(0, 4);
---

<Layout>

  <section class="hero">
    <Picture
      class="hero-img js-hero-img"
      src={IMAGES['hero']}
      formats={['avif', 'webp']}
      alt="VOIDHAUS SS 2026"
      fetchpriority="high"
      decoding="async"
      width={1800}
      transition:name="site-hero"
    />
    <div class="hero-scrim"></div>
    <div class="hero-content wrap">
      <span class="label hero-season js-hero-season">SS 2026</span>
      <h1 class="hero-title js-hero-title">VOIDHAUS</h1>
      <a href="/collection" class="label hero-cta js-hero-cta">
        New Collection →
      </a>
    </div>
  </section>

  <section class="products wrap">
    <div class="products-head">
      <span class="label muted">SS 2026 — New Arrivals</span>
      <a href="/collection" class="label muted muted-link">All ({PRODUCTS.length}) →</a>
      <div class="rule"></div>
    </div>
    <div class="product-grid">
      {featured.map(p => <ProductCard {...p} />)}
    </div>
  </section>

  <section class="editorial" data-anim="scroll">
    <div class="ed-media">
      <Picture
        class="ed-img"
        src={IMAGES['editorial']}
        formats={['avif', 'webp']}
        alt="Voidhaus editorial SS 2026"
        loading="lazy"
        decoding="async"
        width={1800}
      />
      <div class="ed-scrim scrim"></div>
    </div>
    <div class="ed-text wrap">
      <p class="serif ed-quote">"The most radical act<br/>is <em>silence.</em>"</p>
      <a href="/about" class="label ed-link">Read manifesto →</a>
    </div>
  </section>

  <CTAStrip label="Press & Inquiries" linkText="studio@voidhaus.com" href="/contact" />

</Layout>

<script>
import { reveal, lineReveal, cardsCascade, onReady, gsap, DUR, EASE } from '../lib/animate';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    const morphed = document.documentElement.hasAttribute('data-astro-transition');
      
      // Hero image - fade in with subtle scale and parallax
      const img = document.querySelector<HTMLElement>('.js-hero-img');
      if (img) {
        if (morphed) {
          gsap.set(img, { opacity: 1, scale: 1.1 });
        } else {
          gsap.fromTo(img,
            { opacity: 0, scale: 1.15 },
            { opacity: 1, scale: 1.1, duration: 1.4, ease: 'power3.out' },
          );
        }
        ScrollTrigger.create({
          trigger: '.hero',
          start: 'top top',
          end: 'bottom top',
          scrub: 1.5,
          onUpdate: st => gsap.set(img, { yPercent: st.progress * -12 }),
        });
      }

      // Hero text - orchestrated sequence
      const season = document.querySelector<HTMLElement>('.js-hero-season');
      const title = document.querySelector<HTMLElement>('.js-hero-title');
      const cta = document.querySelector<HTMLElement>('.js-hero-cta');

      if (!morphed) {
        gsap.set([season, title, cta], { opacity: 0 });
        
        const tl = gsap.timeline({ delay: 0.3 });
        tl.fromTo(season,
          { opacity: 0, y: 12 },
          { opacity: 1, y: 0, duration: 0.8, ease: 'expo.out' },
        )
        .fromTo(title,
          { opacity: 0, y: 40, skewY: 2 },
          { opacity: 1, y: 0, skewY: 0, duration: 1.2, ease: 'expo.out', clearProps: 'skewY' },
          '-=0.4',
        )
        .fromTo(cta,
          { opacity: 0, y: 16 },
          { opacity: 1, y: 0, duration: 0.8, ease: 'expo.out' },
          '-=0.6',
        );
      }

      // Products section
      lineReveal('.products-head .rule', 0.2);
      cardsCascade('.products .pc');

      // Scroll-triggered sections
      reveal();
  });
});
</script>

<style>
/* ── Hero ──────────────────────────────────────────────────────────────── */
.hero {
  position: relative;
  width: 100vw;
  height: 100svh;
  min-height: 560px;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-img picture,
.hero-img img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
  transform-origin: center center;
}

.hero-scrim {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to bottom, transparent 40%, var(--scrim-dark-heavy) 100%),
    linear-gradient(to top, transparent 85%, var(--scrim-dark-light) 100%);
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 1;
  padding-bottom: var(--space-2xl);
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.hero-season { color: var(--overlay-text-secondary); }

.hero-title {
  font-family: var(--font-sans);
  font-size: clamp(4rem, 14vw, 13rem);
  font-variation-settings: var(--font-weight-light);
  letter-spacing: -0.05em;
  line-height: 0.92;
  color: var(--overlay-text-primary);
}

.hero-cta {
  color: var(--overlay-text-secondary);
  transition: color var(--duration-fast);
  align-self: flex-start;
}
.hero-cta:hover { color: #fff; }

/* ── Products ──────────────────────────────────────────────────────────── */
.products { padding-block: var(--space-3xl) var(--space-2xl); }
@media (min-width: 768px) { .products { padding-block: var(--space-4xl) var(--space-3xl); } }

.products-head {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
  padding-bottom: 0;
  gap: var(--space-md);
}

/* Override grid to 3-col on desktop for home page featured strip */
.products .product-grid {
  grid-template-columns: repeat(2, 1fr);
}
@media (min-width: 768px) { .products .product-grid { grid-template-columns: repeat(3, 1fr); } }

/* ── Editorial ─────────────────────────────────────────────────────────── */
.editorial {
  position: relative; height: 75svh; min-height: 420px;
  margin-block: 5rem; overflow: hidden;
}
@media (min-width: 768px) { .editorial { height: 85svh; margin-block: 7rem; } }

.ed-media { position: absolute; inset: 0; }
.ed-img,
.ed-img picture {
  width: 100%;
  height: 100%;
  display: block;
}
.ed-img img { width: 100%; height: 100%; object-fit: contain; object-position: center; display: block; }
.ed-scrim {
  background: linear-gradient(135deg, var(--scrim-dark-heavy) 0%, var(--scrim-dark-light) 60%, transparent 100%);
}
.ed-text {
  position: absolute; inset-block-end: 3rem; inset-inline: 0;
  display: flex; flex-direction: column; gap: var(--space-lg);
}
@media (min-width: 768px) { .ed-text { inset-block-end: 4rem; max-width: 45%; inset-inline-start: 0; inset-inline-end: auto; } }

.ed-quote {
  font-size: clamp(1.75rem, 5vw, 4rem);
  font-style: italic; line-height: 1.12; letter-spacing: -0.02em;
  color: var(--overlay-text-primary);
}
.ed-quote em { font-style: normal; color: var(--overlay-text-muted); }
.ed-link { color: var(--overlay-text-secondary); transition: color var(--duration-fast); }
.ed-link:hover { color: #fff; }


</style>
>
