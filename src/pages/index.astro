---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';

const featured = PRODUCTS.slice(0, 4);
---

<Layout>

  <!-- ── HERO ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-media">
      <img
        class="hero-img js-hero-img"
        src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1800&q=85&auto=format&fit=crop"
        alt="VOIDHAUS SS 2026"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width="1800" height="1200"
      />
      <div class="hero-scrim"></div>
    </div>

    <div class="hero-body wrap">
      <div class="hero-top" data-anim="hero" data-delay="0">
        <span class="label" style="color:rgb(255 255 255/.6)">SS 2026</span>
        <span class="label" style="color:rgb(255 255 255/.35)">08 Pieces</span>
      </div>

      <h1 class="hero-title" data-anim="hero" data-delay="0.2">
        VOID<em>haus</em>
      </h1>

      <div class="hero-bottom" data-anim="hero" data-delay="0.45">
        <p class="hero-sub">Eight pieces. Four ateliers.<br/>One position.</p>
        <a href="/collection" class="label hero-cta">Explore →</a>
      </div>
    </div>
  </section>

  <!-- ── TICKER ────────────────────────────────────────────────────────── -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {Array(6).fill(null).map(() => (
        <>
          <span class="ticker-item label">SS 2026</span>
          <span class="ticker-sep">—</span>
          <span class="ticker-item label">Dark Luxury</span>
          <span class="ticker-sep">—</span>
          <span class="ticker-item label">Voidhaus</span>
          <span class="ticker-sep">—</span>
          <span class="ticker-item label">Uncompromising</span>
          <span class="ticker-sep">—</span>
        </>
      ))}
    </div>
  </div>

  <!-- ── PRODUCTS ───────────────────────────────────────────────────────── -->
  <section class="products wrap">
    <div class="products-head" data-anim="scroll">
      <span class="label" style="opacity:.4">New Arrivals</span>
      <a href="/collection" class="label prod-all">All pieces ({PRODUCTS.length}) →</a>
    </div>
    <div class="products-grid" id="js-products">
      {featured.map((p, i) => (
        <article class="p-card js-p-card" style={`--i:${i}`}>
          <a href={`/product/${p.slug}`}>
            <div class="p-img-wrap">
              <img
                class="p-img"
                src={p.img.replace(/w=\d+/, 'w=800')}
                alt={p.name}
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
                width="800" height="1067"
              />
            </div>
            <div class="p-info">
              <div class="p-info-l">
                <span class="label" style="opacity:.3">{p.num}</span>
                <span class="p-name">{p.name}</span>
              </div>
              <span class="label" style="opacity:.4">€ {p.price}</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- ── EDITORIAL ──────────────────────────────────────────────────────── -->
  <section class="editorial" data-anim="scroll">
    <div class="ed-media">
      <img
        class="ed-img"
        src="https://images.unsplash.com/photo-1469334031218-e382a71b716b?w=1800&q=85&auto=format&fit=crop"
        alt="Voidhaus editorial SS 2026"
        loading="lazy"
        decoding="async"
        width="1800" height="1200"
      />
      <div class="ed-scrim"></div>
    </div>
    <div class="ed-text wrap">
      <p class="serif ed-quote">"The most radical act<br/>is <em>silence.</em>"</p>
      <a href="/about" class="label ed-link">Read manifesto →</a>
    </div>
  </section>

  <!-- ── BOTTOM ────────────────────────────────────────────────────────── -->
  <div class="bottom-strip wrap" data-anim="scroll">
    <div class="rule"></div>
    <div class="bottom-inner">
      <span class="label" style="opacity:.35">Press & Inquiries</span>
      <a href="/contact" class="label bottom-link">studio@voidhaus.com →</a>
    </div>
    <div class="rule"></div>
  </div>

</Layout>

<script>
import { onReady, revealHero, revealOnScroll, staggerReveal, heroParallax } from '../lib/animate';

onReady(() => {
  heroParallax('.js-hero-img');
  revealHero();
  revealOnScroll();
  staggerReveal('.js-p-card', '#js-products', 0.05, 0.1);
});
</script>

<style>
/* Hero */
.hero {
  position: relative;
  height: 100svh;
  min-height: 560px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}

.hero-media { position: absolute; inset: 0; overflow: hidden; }

.hero-img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center 20%;
  display: block;
  transform-origin: center center;
}

.hero-scrim {
  position: absolute; inset: 0;
  background:
    linear-gradient(to bottom, transparent 35%, rgb(28 27 25 / 0.65) 100%),
    linear-gradient(to top, transparent 80%, rgb(28 27 25 / 0.12) 100%);
}

.hero-body {
  position: relative; z-index: 1;
  padding-bottom: 2.5rem;
  display: flex; flex-direction: column; gap: 1.5rem;
}
@media (min-width: 768px) { .hero-body { padding-bottom: 3.5rem; gap: 2rem; } }

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-title {
  font-family: var(--font-sans);
  font-size: clamp(4rem, 14vw, 13rem);
  font-variation-settings: 'wght' 200;
  letter-spacing: -0.04em;
  line-height: 0.92;
  color: rgb(255 255 255 / 0.92);
}
.hero-title em {
  font-family: var(--font-serif);
  font-style: italic;
  font-variation-settings: 'wght' 300;
  color: rgb(255 255 255 / 0.45);
}

.hero-bottom {
  display: flex; align-items: flex-end;
  justify-content: space-between; gap: 1rem;
}
.hero-sub {
  font-size: 0.8rem;
  font-variation-settings: 'wght' 300;
  line-height: 1.75;
  color: rgb(255 255 255 / 0.45);
}
.hero-cta { color: rgb(255 255 255 / 0.6); transition: color 0.2s; white-space: nowrap; }
.hero-cta:hover { color: #fff; }

/* Ticker */
.ticker {
  border-block: 1px solid var(--color-rule);
  overflow: hidden;
  padding-block: 0.875rem;
  background: var(--color-off);
}
.ticker-track {
  display: flex; gap: 2rem;
  width: max-content;
  animation: ticker 28s linear infinite;
}
@keyframes ticker {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
.ticker-item { color: var(--color-ink); opacity: 0.4; white-space: nowrap; }
.ticker-sep  { color: var(--color-rule); }

/* Products */
.products { padding-block: 5rem 4rem; }
@media (min-width: 768px) { .products { padding-block: 7rem 5rem; } }

.products-head {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 2.5rem;
  border-bottom: 1px solid var(--color-rule);
}
.prod-all { opacity: 0.4; transition: opacity 0.2s; }
.prod-all:hover { opacity: 1; }

.products-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  background: var(--color-rule);
  border-inline: 1px solid var(--color-rule);
  border-bottom: 1px solid var(--color-rule);
}
@media (min-width: 768px) { .products-grid { grid-template-columns: repeat(4, 1fr); } }

.p-card { background: var(--color-white); }
.p-card a { display: block; }

.p-img-wrap { aspect-ratio: 3/4; overflow: hidden; background: var(--color-off); }
.p-img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center top; display: block;
  transition: transform 0.9s var(--ease-out);
}
.p-card a:hover .p-img { transform: scale(1.04); }

.p-info {
  display: flex; align-items: flex-start;
  justify-content: space-between;
  padding: 1rem 1rem 1.25rem; gap: 0.5rem;
  border-top: 1px solid var(--color-rule);
}
@media (min-width: 768px) { .p-info { padding: 1.25rem 1.5rem 1.5rem; } }

.p-info-l { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
.p-name {
  font-size: 0.8125rem; font-variation-settings: 'wght' 300;
  color: var(--color-ink); display: block; margin-top: 0.2rem;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* Editorial */
.editorial {
  position: relative; height: 75svh; min-height: 420px;
  margin-block: 5rem; overflow: hidden;
}
@media (min-width: 768px) { .editorial { height: 85svh; margin-block: 7rem; } }

.ed-media { position: absolute; inset: 0; }
.ed-img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
.ed-scrim {
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgb(28 27 25 / 0.72) 0%, rgb(28 27 25 / 0.2) 60%, transparent 100%);
}

.ed-text {
  position: absolute; inset-block-end: 3rem; inset-inline: 0;
  display: flex; flex-direction: column; gap: 1.5rem;
}
@media (min-width: 768px) { .ed-text { inset-block-end: 4rem; max-width: 52%; } }

.ed-quote {
  font-size: clamp(1.75rem, 5vw, 4rem);
  font-style: italic; line-height: 1.12; letter-spacing: -0.02em;
  color: rgb(255 255 255 / 0.9);
}
.ed-quote em { font-style: normal; color: rgb(255 255 255 / 0.35); }
.ed-link { color: rgb(255 255 255 / 0.5); transition: color 0.2s; }
.ed-link:hover { color: #fff; }

/* Bottom */
.bottom-strip { padding-block: 2.5rem 4rem; }
.bottom-inner {
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 0.75rem; padding-block: 1.5rem;
}
.bottom-link { opacity: 0.4; transition: opacity 0.2s; }
.bottom-link:hover { opacity: 1; }
</style>
