---
import Layout from '@layouts/Layout.astro';
import { Picture } from 'astro:assets';
import ProductCard from '@components/ProductCard.astro';
import CTAStrip from '@components/CTAStrip.astro';
import { PRODUCTS } from '@data/products';
import { IMAGES } from '@assets/images';

const featured = PRODUCTS.slice(0, 4);
---

<Layout>

  <section class="hero">
    <Picture
      class="hero-img js-hero-img"
      src={IMAGES['hero']}
      formats={['avif', 'webp']}
      alt="VOIDHAUS SS 2026"
      fetchpriority="high"
      decoding="async"
      width={1800}
      transition:name="site-hero"
    />
    <div class="hero-scrim"></div>
    <div class="hero-content">
      <span class="label hero-season js-hero-season">SS 2026</span>
      <h1 class="hero-title js-hero-title">VOIDHAUS</h1>
      <div class="hero-foot wrap">
        <a href="/collection" class="hero-cta js-hero-cta">Enter Collection</a>
        <span class="label hero-tagline js-hero-season" aria-hidden="true">Twelve pieces. One position.</span>
      </div>
    </div>
  </section>

  <section class="products wrap">
    <div class="products-head">
      <span class="label muted">SS 2026 — New Arrivals</span>
      <a href="/collection" class="label muted muted-link">All ({PRODUCTS.length}) →</a>
      <div class="rule"></div>
    </div>
    <div class="product-grid">
      {featured.map(p => <ProductCard {...p} />)}
    </div>
  </section>

  <section class="editorial" data-anim="scroll">
    <div class="ed-media">
      <Picture
        class="ed-img"
        src={IMAGES['editorial']}
        formats={['avif', 'webp']}
        alt="Voidhaus editorial SS 2026"
        loading="lazy"
        decoding="async"
        width={1800}
      />
      <div class="ed-scrim scrim"></div>
    </div>
    <div class="ed-text wrap">
      <p class="serif ed-quote">"The most radical act<br/>is <em>silence.</em>"</p>
      <a href="/about" class="label ed-link">Read manifesto →</a>
    </div>
  </section>

  <CTAStrip label="Press & Inquiries" linkText="studio@voidhaus.com" href="/contact" />

</Layout>

<script>
import { initPage, onReady, gsap, EASE, DUR } from '@lib/animate';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    const morphed = document.documentElement.hasAttribute('data-astro-transition');

    const img = document.querySelector<HTMLElement>('.js-hero-img');
    if (img) {
      gsap.set(img, { opacity: morphed ? 1 : 0, scale: morphed ? 1.08 : 1.12 });
      if (!morphed) gsap.to(img, { opacity: 1, scale: 1.08, duration: 1.6, ease: 'power3.out' });
      ScrollTrigger.create({
        trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 2,
        onUpdate: st => gsap.set(img, { yPercent: st.progress * -10 }),
      });
    }

    const title = document.querySelector<HTMLElement>('.js-hero-title');
    const season = document.querySelector<HTMLElement>('.js-hero-season');
    const cta = document.querySelector<HTMLElement>('.js-hero-cta');

    if (!morphed && title) {
      gsap.set([title, season, cta], { opacity: 0 });
      gsap.timeline({ delay: 0.5 })
        .fromTo(title,  { opacity: 0, y: 50 }, { opacity: 1, y: 0, duration: 1.2, ease: EASE }, 0)
        .fromTo(season, { opacity: 0 },        { opacity: 1, duration: 0.6, ease: EASE }, 0.4)
        .fromTo(cta,    { opacity: 0, y: 8 },  { opacity: 1, y: 0, duration: 0.7, ease: EASE }, 0.6)
        .call(() => initPage(), [], 0.8);
    } else {
      initPage();
    }
  });
});
</script>

<style>
.hero {
  position: relative;
  width: 100vw;
  height: 100svh;
  min-height: 600px;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}

.hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-scrim {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to bottom, transparent 30%, rgb(28 27 25 / 0.55) 100%),
    linear-gradient(to top, transparent 92%, rgb(28 27 25 / 0.3) 100%);
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
}

.hero-season {
  position: absolute;
  top: calc(var(--nav-h) + var(--space-lg));
  left: clamp(var(--space-lg), 5vw, var(--space-4xl));
  color: var(--overlay-text-secondary);
}

.hero-title {
  font-family: var(--font-sans);
  font-size: clamp(5rem, 18vw, 18rem);
  font-variation-settings: var(--font-weight-light);
  letter-spacing: -0.06em;
  line-height: 0.88;
  color: var(--overlay-text-primary);
  padding-inline: clamp(var(--space-lg), 5vw, var(--space-4xl));
  padding-bottom: var(--space-lg);
  white-space: nowrap;
}

.hero-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: var(--space-2xl);
  border-top: 1px solid rgb(255 255 255 / 0.15);
  padding-top: var(--space-md);
}

.hero-cta {
  font-family: var(--font-sans);
  font-size: var(--text-xs);
  font-variation-settings: var(--font-weight-medium);
  letter-spacing: var(--letter-spacing-label);
  text-transform: uppercase;
  color: var(--overlay-text-primary);
  border-bottom: 1px solid rgb(255 255 255 / 0.4);
  padding-bottom: 0.1rem;
  transition: border-color var(--duration-fast), color var(--duration-fast);
}
.hero-cta:hover { border-bottom-color: #fff; color: #fff; }

.hero-tagline {
  color: var(--overlay-text-muted);
  display: none;
}
@media (min-width: 640px) { .hero-tagline { display: block; } }

.products { padding-block: var(--space-3xl) var(--space-2xl); }
@media (min-width: 768px) { .products { padding-block: var(--space-4xl) var(--space-3xl); } }

.products-head {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
  padding-bottom: 0;
  gap: var(--space-md);
}

.products .product-grid {
  grid-template-columns: repeat(2, 1fr);
}
@media (min-width: 768px) { .products .product-grid { grid-template-columns: repeat(3, 1fr); } }

.editorial {
  position: relative; height: 75svh; min-height: 420px;
  margin-block: 5rem; overflow: hidden;
}
@media (min-width: 768px) { .editorial { height: 85svh; margin-block: 7rem; } }

.ed-media { position: absolute; inset: 0; }
.ed-img,
.ed-img picture {
  display: block;
}
.ed-img img { object-fit: cover; object-position: center; }
.ed-scrim {
  background: linear-gradient(135deg, var(--scrim-dark-heavy) 0%, var(--scrim-dark-light) 60%, transparent 100%);
}
.ed-text {
  position: absolute; inset-block-end: 3rem; inset-inline: 0;
  display: flex; flex-direction: column; gap: var(--space-lg);
}
@media (min-width: 768px) { .ed-text { inset-block-end: 4rem; max-width: 45%; inset-inline-start: 0; inset-inline-end: auto; } }

.ed-quote {
  font-size: clamp(1.75rem, 5vw, 4rem);
  font-style: italic; line-height: 1.12; letter-spacing: -0.02em;
  color: var(--overlay-text-primary);
}
.ed-quote em { font-style: normal; color: var(--overlay-text-muted); }
.ed-link { color: var(--overlay-text-secondary); transition: color var(--duration-fast); }
.ed-link:hover { color: #fff; }
</style>
