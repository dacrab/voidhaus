---
export const prerender = false;
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login — VOIDHAUS</title>
  <style>
    * { margin: 0; box-sizing: border-box; }
    body {
      font-family: system-ui, sans-serif;
      background: #1c1b19; color: #f8f6f2;
      min-height: 100vh; display: flex; align-items: center; justify-content: center;
    }
    .login-card {
      width: min(380px, 90vw); padding: 3rem 2rem;
      display: flex; flex-direction: column; gap: 1.5rem;
    }
    .brand { font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; opacity: 0.4; }
    h1 { font-size: 1.5rem; font-weight: 300; letter-spacing: -0.02em; }
    label { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.5; display: block; margin-bottom: 0.4rem; }
    input {
      width: 100%; background: none; border: none; border-bottom: 1px solid rgba(255,255,255,0.15);
      color: #f8f6f2; font-size: 1rem; padding: 0.75rem 0; outline: none;
      transition: border-color 0.2s;
    }
    input:focus { border-color: rgba(255,255,255,0.5); }
    button {
      width: 100%; padding: 0.875rem; background: #f8f6f2; color: #1c1b19;
      border: none; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase;
      cursor: pointer; transition: opacity 0.2s;
    }
    button:hover { opacity: 0.85; }
    button:disabled { opacity: 0.4; cursor: not-allowed; }
    .error { font-size: 0.75rem; color: #ef4444; text-align: center; }
    .field { margin-bottom: 1rem; }
  </style>
</head>
<body>
  <form class="login-card" id="login-form">
    <span class="brand">VOIDHAUS</span>
    <h1>Admin Access</h1>
    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" placeholder="admin@voidhaus.com" required autofocus />
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" placeholder="••••••••" required />
    </div>
    <button type="submit" id="submit-btn">Enter</button>
    <p class="error" id="error" style="display:none"></p>
  </form>

  <script type="module">
    import { ConvexHttpClient } from "https://esm.sh/convex@1.39.1/browser";

    const CONVEX_URL = document.querySelector('meta[name="convex-url"]')?.content
      || window.__CONVEX_URL__
      || "";

    const convex = new ConvexHttpClient(CONVEX_URL);

    // Check if already logged in
    const existingToken = document.cookie.match(/vh-admin-session=([^;]+)/)?.[1];
    if (existingToken) {
      window.location.href = "/admin";
    }

    document.getElementById("login-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = document.getElementById("submit-btn");
      const error = document.getElementById("error");
      btn.disabled = true;
      error.style.display = "none";

      const email = document.getElementById("email").value;
      const password = document.getElementById("password").value;

      try {
        const result = await convex.mutation("auth:login", { email, password });
        if (result.error) {
          error.textContent = result.error;
          error.style.display = "block";
        } else {
          // Set session cookie
          document.cookie = `vh-admin-session=${result.token}; path=/admin; max-age=${7 * 24 * 60 * 60}; samesite=strict`;
          window.location.href = "/admin";
        }
      } catch (err) {
        error.textContent = "Connection error";
        error.style.display = "block";
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</body>
</html>
