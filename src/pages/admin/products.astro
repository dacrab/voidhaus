---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="Products" active="products">
  <div style="display:flex; justify-content:flex-end; margin-bottom:1.5rem;">
    <a href="/admin/products/new" class="admin-btn admin-btn-primary">+ Add Product</a>
  </div>
  <div class="admin-card">
    <div id="products-list">
      <p class="muted" style="font-size:0.8rem;">Loading…</p>
    </div>
  </div>
</AdminLayout>

<script>
  import { ConvexHttpClient } from "convex/browser";
  import { api } from "../../../convex/_generated/api";

  const convex = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

  async function load() {
    const products = await convex.query(api.products.list, { activeOnly: false });
    const wrap = document.getElementById("products-list")!;

    wrap.innerHTML = `<table class="admin-table">
      <thead><tr>
        <th>Num</th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Active</th><th>Actions</th>
      </tr></thead>
      <tbody>${products.map((p: any) => `<tr>
        <td>${p.num}</td>
        <td>${p.name}</td>
        <td>${p.category}</td>
        <td>€${p.price.toLocaleString()}</td>
        <td style="${p.stock < 5 ? 'color:#dc2626;font-weight:600' : ''}">${p.stock}</td>
        <td>${p.active ? '✓' : '✗'}</td>
        <td style="display:flex;gap:0.4rem;flex-wrap:wrap;">
          <a href="/admin/products/edit?slug=${p.slug}" class="admin-btn">Edit</a>
          <button class="admin-btn toggle-btn" data-id="${p._id}" data-active="${p.active}">${p.active ? 'Deactivate' : 'Activate'}</button>
        </td>
      </tr>`).join('')}</tbody>
    </table>`;

    wrap.querySelectorAll('.toggle-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.target as HTMLElement).dataset.id!;
        const active = (e.target as HTMLElement).dataset.active === 'true';
        await convex.mutation(api.products.update, { id: id as any, active: !active });
        load();
      });
    });
  }
  load();
</script>
