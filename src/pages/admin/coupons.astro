---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="Coupons" active="coupons">
  <div class="admin-card" style="margin-bottom:1.5rem;">
    <h2 class="section-title">Create Coupon</h2>
    <form id="coupon-form" class="coupon-form">
      <input type="text" name="code" placeholder="CODE" required class="admin-input" />
      <select name="type" required class="admin-input">
        <option value="percent">% Off</option>
        <option value="fixed">€ Fixed</option>
      </select>
      <input type="number" name="value" placeholder="Value" required class="admin-input small" />
      <input type="number" name="minOrder" placeholder="Min €" class="admin-input small" />
      <input type="number" name="maxUses" placeholder="Max uses" class="admin-input small" />
      <button type="submit" class="admin-btn admin-btn-primary">Create</button>
    </form>
  </div>

  <div class="admin-card">
    <div id="coupons-list">
      <p class="muted" style="font-size:0.8rem;">Loading…</p>
    </div>
  </div>
</AdminLayout>

<script>
  import { ConvexHttpClient } from "convex/browser";
  import { api } from "../../../convex/_generated/api";

  const convex = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

  async function load() {
    const coupons = await convex.query(api.coupons.list, {});
    const wrap = document.getElementById("coupons-list")!;

    if (!coupons.length) {
      wrap.innerHTML = '<p class="muted" style="font-size:0.8rem;">No coupons yet.</p>';
      return;
    }

    wrap.innerHTML = `<table class="admin-table">
      <thead><tr><th>Code</th><th>Type</th><th>Value</th><th>Min Order</th><th>Used / Max</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>${coupons.map((c: any) => `<tr>
        <td style="font-family:monospace;font-weight:600">${c.code}</td>
        <td>${c.type === 'percent' ? '% Off' : '€ Fixed'}</td>
        <td>${c.type === 'percent' ? c.value + '%' : '€' + c.value}</td>
        <td>${c.minOrder ? '€' + c.minOrder : '—'}</td>
        <td>${c.usedCount}${c.maxUses ? ' / ' + c.maxUses : ''}</td>
        <td style="color:${c.active ? '#16a34a' : '#6b7280'}">${c.active ? 'Active' : 'Inactive'}</td>
        <td>${c.active ? `<button class="admin-btn admin-btn-danger deactivate-btn" data-id="${c._id}">Deactivate</button>` : ''}</td>
      </tr>`).join('')}</tbody>
    </table>`;

    wrap.querySelectorAll('.deactivate-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        await convex.mutation(api.coupons.deactivate, { id: (e.target as HTMLElement).dataset.id as any });
        load();
      });
    });
  }

  document.getElementById("coupon-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);
    await convex.mutation(api.coupons.create, {
      code: data.get("code") as string,
      type: data.get("type") as string,
      value: Number(data.get("value")),
      minOrder: data.get("minOrder") ? Number(data.get("minOrder")) : undefined,
      maxUses: data.get("maxUses") ? Number(data.get("maxUses")) : undefined,
    });
    form.reset();
    load();
  });

  load();
</script>

<style>
  .section-title { font-size: 0.9rem; font-weight: 600; margin-bottom: 1rem; }
  .coupon-form { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
  .admin-input {
    background: var(--admin-bg); border: 1px solid var(--admin-rule); padding: 0.5rem 0.75rem;
    font-size: 0.8rem; border-radius: 4px; outline: none; color: var(--admin-ink);
  }
  .admin-input:focus { border-color: var(--admin-ink); }
  .admin-input.small { width: 90px; }
</style>
