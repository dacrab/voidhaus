---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="Orders" active="orders">
  <div class="flex gap-2 flex-wrap mb-5" id="filters">
    <button class="text-xs uppercase tracking-wide px-3 py-1.5 rounded border border-zinc-900 bg-zinc-900 text-white transition-colors" data-status="">All</button>
    <button class="text-xs uppercase tracking-wide px-3 py-1.5 rounded border border-zinc-200 bg-white text-zinc-600 hover:bg-zinc-50 transition-colors" data-status="pending">Pending</button>
    <button class="text-xs uppercase tracking-wide px-3 py-1.5 rounded border border-zinc-200 bg-white text-zinc-600 hover:bg-zinc-50 transition-colors" data-status="paid">Paid</button>
    <button class="text-xs uppercase tracking-wide px-3 py-1.5 rounded border border-zinc-200 bg-white text-zinc-600 hover:bg-zinc-50 transition-colors" data-status="shipped">Shipped</button>
    <button class="text-xs uppercase tracking-wide px-3 py-1.5 rounded border border-zinc-200 bg-white text-zinc-600 hover:bg-zinc-50 transition-colors" data-status="delivered">Delivered</button>
  </div>
  <div class="bg-white border border-zinc-200 rounded-lg p-5">
    <div id="orders-list">
      <p class="text-sm text-zinc-400">Loading…</p>
    </div>
  </div>
</AdminLayout>

<script>
  import { ConvexHttpClient } from "convex/browser";
  import { api } from "../../../convex/_generated/api";

  const convex = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
  let currentFilter = "";

  async function load(status?: string) {
    const orders = await convex.query(api.orders.list, { status: status || undefined });
    const wrap = document.getElementById("orders-list")!;
    if (!orders.length) { wrap.innerHTML = '<p class="text-sm text-zinc-400">No orders found.</p>'; return; }

    wrap.innerHTML = `<table class="w-full text-sm"><thead><tr class="border-b border-zinc-100">
      <th class="text-left text-[0.65rem] font-medium uppercase tracking-wide text-zinc-400 px-3 py-2">Date</th>
      <th class="text-left text-[0.65rem] font-medium uppercase tracking-wide text-zinc-400 px-3 py-2">Email</th>
      <th class="text-left text-[0.65rem] font-medium uppercase tracking-wide text-zinc-400 px-3 py-2">Items</th>
      <th class="text-left text-[0.65rem] font-medium uppercase tracking-wide text-zinc-400 px-3 py-2">Total</th>
      <th class="text-left text-[0.65rem] font-medium uppercase tracking-wide text-zinc-400 px-3 py-2">Status</th>
      <th class="text-left text-[0.65rem] font-medium uppercase tracking-wide text-zinc-400 px-3 py-2"></th>
    </tr></thead><tbody>${orders.map((o: any) => `<tr class="border-b border-zinc-50">
      <td class="px-3 py-3">${new Date(o._creationTime).toLocaleDateString()}</td>
      <td class="px-3 py-3">${o.customerEmail || '—'}</td>
      <td class="px-3 py-3 max-w-[200px] truncate">${o.items.map((i: any) => i.name).join(', ')}</td>
      <td class="px-3 py-3">€${o.total.toLocaleString()}</td>
      <td class="px-3 py-3 font-medium ${o.status === 'paid' ? 'text-green-600' : o.status === 'pending' ? 'text-amber-600' : o.status === 'shipped' ? 'text-blue-600' : 'text-zinc-500'}">${o.status}</td>
      <td class="px-3 py-3">
        ${o.status === 'paid' ? `<button class="text-[0.7rem] uppercase px-3 py-1 border border-zinc-200 rounded bg-white hover:bg-zinc-50 ship-btn" data-id="${o._id}">Ship</button>` : ''}
        ${o.status === 'shipped' ? `<button class="text-[0.7rem] uppercase px-3 py-1 border border-zinc-200 rounded bg-white hover:bg-zinc-50 deliver-btn" data-id="${o._id}">Delivered</button>` : ''}
      </td>
    </tr>`).join('')}</tbody></table>`;

    wrap.querySelectorAll('.ship-btn').forEach(btn => btn.addEventListener('click', async (e) => {
      await convex.mutation(api.orders.updateStatus, { id: (e.target as HTMLElement).dataset.id as any, status: 'shipped' }); load(currentFilter);
    }));
    wrap.querySelectorAll('.deliver-btn').forEach(btn => btn.addEventListener('click', async (e) => {
      await convex.mutation(api.orders.updateStatus, { id: (e.target as HTMLElement).dataset.id as any, status: 'delivered' }); load(currentFilter);
    }));
  }

  document.querySelectorAll('#filters button').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('#filters button').forEach(b => { b.className = 'text-xs uppercase tracking-wide px-3 py-1.5 rounded border border-zinc-200 bg-white text-zinc-600 hover:bg-zinc-50 transition-colors'; });
      (e.target as HTMLElement).className = 'text-xs uppercase tracking-wide px-3 py-1.5 rounded border border-zinc-900 bg-zinc-900 text-white transition-colors';
      currentFilter = (e.target as HTMLElement).dataset.status || "";
      load(currentFilter);
    });
  });
  load();
</script>
