---
export const prerender = false;
import Layout from '@layouts/Layout.astro';
---

<Layout title="Edit Product — Admin — VOIDHAUS" solidNav>
  <div class="admin-shell">
    <aside class="admin-nav">
      <span class="admin-brand label">VOIDHAUS Admin</span>
      <nav class="admin-links">
        <a href="/admin" class="label">Dashboard</a>
        <a href="/admin/products" class="label active">Products</a>
        <a href="/admin/orders" class="label">Orders</a>
        <a href="/admin/coupons" class="label">Coupons</a>
        <a href="/admin/messages" class="label">Messages</a>
      </nav>
    </aside>
    <main class="admin-main">
      <div class="admin-header">
        <h1 class="admin-title">Edit Product</h1>
        <a href="/admin/products" class="label back-link">← Back to Products</a>
      </div>
      <div id="loading"><p class="label muted">Loading…</p></div>
      <form id="edit-form" class="product-form" style="display:none">
        <input type="hidden" id="product-id" />
        <div class="form-grid">
          <div class="field">
            <label class="label" for="name">Name</label>
            <input type="text" id="name" name="name" required />
          </div>
          <div class="field">
            <label class="label" for="slug">Slug</label>
            <input type="text" id="slug" name="slug" required />
          </div>
          <div class="field">
            <label class="label" for="num">Number</label>
            <input type="text" id="num" name="num" required />
          </div>
          <div class="field">
            <label class="label" for="price">Price (€)</label>
            <input type="number" id="price" name="price" required />
          </div>
          <div class="field">
            <label class="label" for="category">Category</label>
            <select id="category" name="category" required>
              <option value="Outerwear">Outerwear</option>
              <option value="Tailoring">Tailoring</option>
              <option value="Ready-to-wear">Ready-to-wear</option>
              <option value="Knitwear">Knitwear</option>
              <option value="Tops">Tops</option>
              <option value="Footwear">Footwear</option>
              <option value="Accessories">Accessories</option>
            </select>
          </div>
          <div class="field">
            <label class="label" for="stock">Stock (total — read only)</label>
            <input type="number" id="stock" name="stock" readonly disabled />
          </div>
          <div class="field full">
            <label class="label">Per-Size Stock</label>
            <div id="size-stock-grid" class="size-stock-grid"></div>
          </div>
          <div class="field">
            <label class="label" for="material">Material</label>
            <input type="text" id="material" name="material" required />
          </div>
          <div class="field">
            <label class="label" for="origin">Origin</label>
            <input type="text" id="origin" name="origin" required />
          </div>
          <div class="field full">
            <label class="label" for="desc">Description</label>
            <textarea id="desc" name="desc" rows="3" required></textarea>
          </div>
          <div class="field">
            <label class="label" for="sizes">Sizes (comma-separated)</label>
            <input type="text" id="sizes" name="sizes" required />
          </div>
          <div class="field">
            <label class="label" for="img">Image key (legacy)</label>
            <input type="text" id="img" name="img" required />
          </div>
          <div class="field">
            <label class="label" for="img2">Secondary image key</label>
            <input type="text" id="img2" name="img2" />
          </div>
          <div class="field">
            <label class="label">Upload Primary Image</label>
            <input type="file" id="img-upload" accept="image/*" class="file-input" />
            <span id="img-upload-status" class="upload-status"></span>
          </div>
          <div class="field">
            <label class="label">Upload Secondary Image</label>
            <input type="file" id="img2-upload" accept="image/*" class="file-input" />
            <span id="img2-upload-status" class="upload-status"></span>
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="submit-btn label" id="submit-btn">Save Changes</button>
          <button type="button" class="delete-btn label" id="delete-btn">Delete Product</button>
        </div>
        <p id="status" class="status"></p>
      </form>
    </main>
  </div>
</Layout>

<script>
  import { ConvexHttpClient } from "convex/browser";
  import { api } from "../../../../convex/_generated/api";

  const convex = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
  const slug = new URLSearchParams(window.location.search).get("slug");
  let currentSizeStock: Record<string, number> = {};
  let imgStorageId: string | undefined;
  let img2StorageId: string | undefined;

  function renderSizeStockGrid(sizes: string[], sizeStock: Record<string, number>) {
    const grid = document.getElementById("size-stock-grid")!;
    grid.innerHTML = sizes.map(s => `
      <div class="size-stock-item">
        <span class="size-label">${s}</span>
        <input type="number" min="0" class="size-stock-input" data-size="${s}" value="${sizeStock[s] ?? 0}" />
      </div>
    `).join('');
    grid.querySelectorAll('.size-stock-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const size = (e.target as HTMLInputElement).dataset.size!;
        currentSizeStock[size] = Number((e.target as HTMLInputElement).value);
        const total = Object.values(currentSizeStock).reduce((s, n) => s + n, 0);
        (document.getElementById("stock") as HTMLInputElement).value = String(total);
      });
    });
  }

  async function uploadFile(file: File, statusEl: HTMLElement): Promise<string | undefined> {
    statusEl.textContent = "Uploading…";
    try {
      const uploadUrl = await convex.mutation(api.files.generateUploadUrl, {});
      const res = await fetch(uploadUrl, {
        method: "POST",
        headers: { "Content-Type": file.type },
        body: file,
      });
      const { storageId } = await res.json();
      statusEl.textContent = "✓ Uploaded";
      return storageId;
    } catch (err) {
      statusEl.textContent = "✗ Upload failed";
      return undefined;
    }
  }

  // Image upload handlers
  document.getElementById("img-upload")!.addEventListener("change", async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const id = await uploadFile(file, document.getElementById("img-upload-status")!);
    if (id) imgStorageId = id;
  });
  document.getElementById("img2-upload")!.addEventListener("change", async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const id = await uploadFile(file, document.getElementById("img2-upload-status")!);
    if (id) img2StorageId = id;
  });

  async function load() {
    if (!slug) { window.location.href = "/admin/products"; return; }
    const product = await convex.query(api.products.getBySlug, { slug });
    if (!product) { window.location.href = "/admin/products"; return; }

    document.getElementById("loading")!.style.display = "none";
    const form = document.getElementById("edit-form") as HTMLFormElement;
    form.style.display = "block";

    (document.getElementById("product-id") as HTMLInputElement).value = product._id;
    (document.getElementById("name") as HTMLInputElement).value = product.name;
    (document.getElementById("slug") as HTMLInputElement).value = product.slug;
    (document.getElementById("num") as HTMLInputElement).value = product.num;
    (document.getElementById("price") as HTMLInputElement).value = String(product.price);
    (document.getElementById("category") as HTMLSelectElement).value = product.category;
    (document.getElementById("stock") as HTMLInputElement).value = String(product.stock);
    (document.getElementById("material") as HTMLInputElement).value = product.material;
    (document.getElementById("origin") as HTMLInputElement).value = product.origin;
    (document.getElementById("desc") as HTMLTextAreaElement).value = product.desc;
    (document.getElementById("sizes") as HTMLInputElement).value = product.sizes.join(", ");
    (document.getElementById("img") as HTMLInputElement).value = product.img;
    (document.getElementById("img2") as HTMLInputElement).value = product.img2 ?? "";

    currentSizeStock = product.sizeStock ?? {};
    renderSizeStockGrid(product.sizes, currentSizeStock);
  }

  document.getElementById("edit-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = document.getElementById("submit-btn") as HTMLButtonElement;
    const status = document.getElementById("status")!;
    btn.disabled = true;
    btn.textContent = "Saving…";

    try {
      const form = e.target as HTMLFormElement;
      const data = new FormData(form);
      const id = (document.getElementById("product-id") as HTMLInputElement).value;

      const updateArgs: any = {
        id: id as any,
        name: data.get("name") as string,
        slug: data.get("slug") as string,
        num: data.get("num") as string,
        price: Number(data.get("price")),
        category: data.get("category") as string,
        material: data.get("material") as string,
        origin: data.get("origin") as string,
        desc: data.get("desc") as string,
        sizes: (data.get("sizes") as string).split(",").map((s) => s.trim()),
        sizeStock: currentSizeStock,
        img: data.get("img") as string,
        img2: (data.get("img2") as string) || undefined,
      };
      if (imgStorageId) updateArgs.imgStorageId = imgStorageId;
      if (img2StorageId) updateArgs.img2StorageId = img2StorageId;

      await convex.mutation(api.products.update, updateArgs);
      status.textContent = "✓ Saved";
      status.className = "status success";
    } catch (err: any) {
      status.textContent = `✗ ${err.message}`;
      status.className = "status error";
    } finally {
      btn.disabled = false;
      btn.textContent = "Save Changes";
    }
  });

  document.getElementById("delete-btn")!.addEventListener("click", async () => {
    if (!confirm("Delete this product permanently?")) return;
    const id = (document.getElementById("product-id") as HTMLInputElement).value;
    await convex.mutation(api.products.remove, { id: id as any });
    window.location.href = "/admin/products";
  });

  load();
</script>

<style>
  .admin-shell { display: grid; grid-template-columns: 220px 1fr; min-height: 100vh; }
  .admin-nav {
    background: var(--color-ink); color: var(--color-white);
    padding: var(--spacing-xl) var(--spacing-lg);
    display: flex; flex-direction: column; gap: var(--spacing-xl);
    position: sticky; top: 0; height: 100vh;
  }
  .admin-brand { font-size: var(--text-sm); opacity: 0.6; }
  .admin-links { display: flex; flex-direction: column; gap: var(--spacing-sm); }
  .admin-links a { color: var(--color-white); opacity: 0.7; text-decoration: none; padding: var(--spacing-xs) 0; transition: opacity var(--duration-fast); }
  .admin-links a:hover, .admin-links a.active { opacity: 1; }
  .admin-main { padding: var(--spacing-2xl) var(--spacing-xl); max-width: 900px; }
  .admin-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--spacing-xl); }
  .admin-title { font-size: var(--text-2xl); font-variation-settings: var(--fw-medium); }
  .back-link { opacity: var(--op-muted); transition: opacity var(--duration-fast); }
  .back-link:hover { opacity: 1; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-lg); }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field.full { grid-column: 1 / -1; }
  .field label { opacity: 0.6; }
  .field input, .field select, .field textarea {
    background: none; border: 1px solid var(--color-rule); padding: 10px 12px;
    font-size: 14px; font-family: inherit; color: var(--color-ink); outline: none;
    transition: border-color var(--duration-fast);
  }
  .field input:focus, .field select:focus, .field textarea:focus { border-color: var(--color-ink); }
  .form-actions { display: flex; gap: var(--spacing-md); margin-top: var(--spacing-xl); }
  .size-stock-grid { display: flex; flex-wrap: wrap; gap: 8px; }
  .size-stock-item { display: flex; align-items: center; gap: 6px; }
  .size-label { font-size: 12px; letter-spacing: 0.05em; text-transform: uppercase; opacity: 0.6; min-width: 30px; }
  .size-stock-input { width: 60px; background: none; border: 1px solid var(--color-rule); padding: 6px 8px; font-size: 13px; color: var(--color-ink); outline: none; text-align: center; }
  .size-stock-input:focus { border-color: var(--color-ink); }
  .file-input { font-size: 13px; margin-top: 4px; }
  .upload-status { font-size: 12px; opacity: 0.7; margin-left: 8px; }
  .submit-btn {
    padding: 12px 24px; background: var(--color-ink); color: var(--color-white);
    border: none; cursor: pointer; transition: opacity var(--duration-fast);
  }
  .submit-btn:hover { opacity: 0.85; }
  .submit-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .delete-btn {
    padding: 12px 24px; background: none; color: #dc2626;
    border: 1px solid #dc2626; cursor: pointer; transition: background var(--duration-fast);
  }
  .delete-btn:hover { background: #fef2f2; }
  .status { margin-top: var(--spacing-md); font-size: 14px; }
  .status.success { color: #16a34a; }
  .status.error { color: #dc2626; }
</style>
