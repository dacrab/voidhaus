---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="Messages" active="messages">
  <div id="messages-list">
    <p class="muted" style="font-size:0.8rem;">Loading…</p>
  </div>
</AdminLayout>

<script>
  import { ConvexHttpClient } from "convex/browser";
  import { api } from "../../../convex/_generated/api";

  const convex = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

  async function load() {
    const messages = await convex.query(api.messages.list, {});
    const wrap = document.getElementById("messages-list")!;

    if (!messages.length) {
      wrap.innerHTML = '<p class="muted" style="font-size:0.8rem;">No messages yet.</p>';
      return;
    }

    wrap.innerHTML = messages.map((m: any) => `
      <div class="admin-card msg-card ${m.read ? 'read' : ''}">
        <div class="msg-header">
          <strong>${m.name}</strong>
          <span class="muted">&lt;${m.email}&gt;</span>
          <span class="muted" style="margin-left:auto;">${new Date(m._creationTime).toLocaleDateString()}</span>
        </div>
        <div class="msg-subject">${m.subject}</div>
        <p class="msg-body">${m.message}</p>
        ${!m.read ? `<button class="admin-btn mark-read-btn" data-id="${m._id}">Mark Read</button>` : ''}
      </div>
    `).join('');

    wrap.querySelectorAll('.mark-read-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        await convex.mutation(api.messages.markRead, { id: (e.target as HTMLElement).dataset.id as any });
        load();
      });
    });
  }
  load();
</script>

<style>
  .msg-card { margin-bottom: 1rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .msg-card.read { opacity: 0.5; }
  .msg-header { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; flex-wrap: wrap; }
  .msg-subject { font-size: 0.75rem; color: var(--admin-muted); }
  .msg-body { font-size: 0.85rem; line-height: 1.6; }
</style>
