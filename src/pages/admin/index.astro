---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard" active="dashboard">
  <div class="stats-grid">
    <div class="admin-card stat-card">
      <span class="stat-value" id="product-count">—</span>
      <span class="stat-label">Products</span>
    </div>
    <div class="admin-card stat-card">
      <span class="stat-value" id="order-count">—</span>
      <span class="stat-label">Orders</span>
    </div>
    <div class="admin-card stat-card">
      <span class="stat-value" id="revenue">—</span>
      <span class="stat-label">Revenue</span>
    </div>
    <div class="admin-card stat-card">
      <span class="stat-value" id="low-stock">—</span>
      <span class="stat-label">Low Stock (&lt;5)</span>
    </div>
  </div>

  <section class="admin-card" style="margin-top: 2rem;">
    <h2 class="section-title">Recent Orders</h2>
    <div id="recent-orders">
      <p class="muted" style="font-size:0.8rem;">Loading…</p>
    </div>
  </section>
</AdminLayout>

<script>
  import { ConvexHttpClient } from "convex/browser";
  import { api } from "../../../convex/_generated/api";

  const convex = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

  async function load() {
    const [products, orders] = await Promise.all([
      convex.query(api.products.list, {}),
      convex.query(api.orders.list, {}),
    ]);

    document.getElementById("product-count")!.textContent = String(products.length);
    document.getElementById("order-count")!.textContent = String(orders.length);

    const paid = orders.filter((o: any) => ["paid", "shipped", "delivered"].includes(o.status));
    const revenue = paid.reduce((s: number, o: any) => s + o.total, 0);
    document.getElementById("revenue")!.textContent = `€${revenue.toLocaleString()}`;

    const lowStock = products.filter((p: any) => p.stock < 5);
    document.getElementById("low-stock")!.textContent = String(lowStock.length);

    const recent = orders.slice(0, 5);
    const wrap = document.getElementById("recent-orders")!;
    if (!recent.length) {
      wrap.innerHTML = '<p class="muted" style="font-size:0.8rem;">No orders yet.</p>';
      return;
    }
    wrap.innerHTML = `<table class="admin-table">
      <thead><tr><th>Date</th><th>Email</th><th>Total</th><th>Status</th></tr></thead>
      <tbody>${recent.map((o: any) => `<tr>
        <td>${new Date(o._creationTime).toLocaleDateString()}</td>
        <td>${o.customerEmail || '—'}</td>
        <td>€${o.total.toLocaleString()}</td>
        <td class="status-${o.status}">${o.status}</td>
      </tr>`).join('')}</tbody>
    </table>`;
  }
  load();
</script>

<style>
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; }
  .stat-card { display: flex; flex-direction: column; gap: 0.25rem; }
  .stat-value { font-size: 1.75rem; font-weight: 600; letter-spacing: -0.02em; }
  .stat-label { font-size: 0.7rem; color: var(--admin-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .section-title { font-size: 0.9rem; font-weight: 600; margin-bottom: 1rem; }
</style>
