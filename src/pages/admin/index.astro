---
export const prerender = false;
import Layout from '@layouts/Layout.astro';
---

<Layout title="Admin — VOIDHAUS" solidNav>
  <div class="admin-shell">
    <aside class="admin-nav">
      <span class="admin-brand label">VOIDHAUS Admin</span>
      <nav class="admin-links">
        <a href="/admin" class="label active">Dashboard</a>
        <a href="/admin/products" class="label">Products</a>
        <a href="/admin/orders" class="label">Orders</a>
        <a href="/admin/messages" class="label">Messages</a>
      </nav>
    </aside>
    <main class="admin-main">
      <h1 class="admin-title">Dashboard</h1>
      <div class="stats-grid" id="stats">
        <div class="stat-card">
          <span class="stat-value" id="product-count">—</span>
          <span class="stat-label label">Products</span>
        </div>
        <div class="stat-card">
          <span class="stat-value" id="order-count">—</span>
          <span class="stat-label label">Orders</span>
        </div>
        <div class="stat-card">
          <span class="stat-value" id="revenue">—</span>
          <span class="stat-label label">Revenue (paid)</span>
        </div>
        <div class="stat-card">
          <span class="stat-value" id="low-stock">—</span>
          <span class="stat-label label">Low Stock (&lt;5)</span>
        </div>
      </div>
      <h2 class="admin-subtitle">Recent Orders</h2>
      <div id="recent-orders" class="orders-table-wrap">
        <p class="label muted">Loading…</p>
      </div>
    </main>
  </div>
</Layout>

<script>
  import { ConvexHttpClient } from "convex/browser";
  import { api } from "../../../convex/_generated/api";

  const convex = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

  async function load() {
    const [products, orders] = await Promise.all([
      convex.query(api.products.list, {}),
      convex.query(api.orders.list, {}),
    ]);

    document.getElementById("product-count")!.textContent = String(products.length);
    document.getElementById("order-count")!.textContent = String(orders.length);

    const paid = orders.filter((o: any) => o.status === "paid" || o.status === "shipped" || o.status === "delivered");
    const revenue = paid.reduce((s: number, o: any) => s + o.total, 0);
    document.getElementById("revenue")!.textContent = `€${revenue.toLocaleString()}`;

    const lowStock = products.filter((p: any) => p.stock < 5);
    document.getElementById("low-stock")!.textContent = String(lowStock.length);

    const recent = orders.slice(0, 5);
    const wrap = document.getElementById("recent-orders")!;
    if (!recent.length) {
      wrap.innerHTML = '<p class="label muted">No orders yet.</p>';
      return;
    }
    wrap.innerHTML = `<table class="orders-table">
      <thead><tr><th class="label">Date</th><th class="label">Email</th><th class="label">Total</th><th class="label">Status</th></tr></thead>
      <tbody>${recent.map((o: any) => `<tr>
        <td class="label">${new Date(o._creationTime).toLocaleDateString()}</td>
        <td class="label">${o.customerEmail || '—'}</td>
        <td class="label">€${o.total.toLocaleString()}</td>
        <td class="label status-${o.status}">${o.status}</td>
      </tr>`).join('')}</tbody>
    </table>`;
  }
  load();
</script>

<style>
  .admin-shell { display: grid; grid-template-columns: 220px 1fr; min-height: 100vh; }
  .admin-nav {
    background: var(--color-ink); color: var(--color-white);
    padding: var(--spacing-xl) var(--spacing-lg);
    display: flex; flex-direction: column; gap: var(--spacing-xl);
    position: sticky; top: 0; height: 100vh;
  }
  .admin-brand { font-size: var(--text-sm); opacity: 0.6; }
  .admin-links { display: flex; flex-direction: column; gap: var(--spacing-sm); }
  .admin-links a { color: var(--color-white); opacity: 0.7; text-decoration: none; padding: var(--spacing-xs) 0; transition: opacity var(--duration-fast); }
  .admin-links a:hover, .admin-links a.active { opacity: 1; }
  .admin-main { padding: var(--spacing-2xl) var(--spacing-xl); }
  .admin-title { font-size: var(--text-2xl); font-variation-settings: var(--fw-medium); margin-bottom: var(--spacing-xl); }
  .admin-subtitle { font-size: var(--text-lg); font-variation-settings: var(--fw-medium); margin: var(--spacing-2xl) 0 var(--spacing-lg); }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--spacing-lg); }
  .stat-card { background: var(--color-off); padding: var(--spacing-xl); display: flex; flex-direction: column; gap: var(--spacing-xs); }
  .stat-value { font-size: var(--text-2xl); font-variation-settings: var(--fw-medium); }
  .stat-label { opacity: var(--op-muted); }
  .orders-table { width: 100%; border-collapse: collapse; }
  .orders-table th, .orders-table td { text-align: left; padding: var(--spacing-sm) var(--spacing-md); border-bottom: 1px solid var(--color-rule); }
  .status-paid { color: #16a34a; }
  .status-pending { color: #ca8a04; }
  .status-shipped { color: #2563eb; }
</style>
