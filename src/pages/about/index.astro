---
import Layout from '@layouts/Layout.astro';
import { Picture } from 'astro:assets';
import CTAStrip from '@components/CTAStrip.astro';
import { SITE } from '@data/site';
import { IMAGES } from '@assets/images';

const statements = [
  {
    num: '001',
    body: [
      'Voidhaus was not born from a desire to dress people. It was born from a frustration with fashion that performs humility while demanding admiration.',
      'We care. Deeply. Obsessively. But not about you noticing.',
    ],
  },
  {
    num: '002',
    heading: 'The garment as architecture.',
    body: [
      'We work from the structure outward. A coat must stand before it must move. Comfort is a result of precision, not an excuse for its absence.',
      'Every piece is designed to outlast the season it is born in.',
    ],
  },
  {
    num: '003',
    heading: 'On restraint.',
    body: [
      'We produce twelve pieces per collection. Each garment is finished by hand. Each seam is checked by eye. We will never grow faster than our ability to care.',
    ],
  },
  {
    num: '004',
    heading: 'Who we dress.',
    body: [
      'We do not design for a demographic. We design for a disposition. If you already know — you do not need us to tell you.',
    ],
  },
] as const;
---

<Layout title="Manifesto" solidNav={true}>

  <header class="wrap pt-[calc(var(--nav-h)+var(--space-2xl))] pb-[var(--space-2xl)]">
    <div class="rule js-rule"></div>
    <div class="pt-[var(--space-lg)]">
      <span class="label muted" data-anim="hero">Manifesto</span>
      <h1 class="about-title mt-[var(--space-xs)]" data-anim="hero" data-delay="0.1" style="font-variation-settings:var(--font-weight-light)">We reject<br/>the legible.</h1>
    </div>
  </header>

  <section class="statements wrap pb-[var(--space-2xl)] md:pb-[var(--space-3xl)]">
    {statements.map((s, i) => (
      <>
        <div class="stmt grid gap-[var(--space-md)] py-[var(--space-xl)] sm:grid-cols-[5rem_1fr] sm:gap-[var(--space-2xl)] sm:py-[var(--space-3xl)]" data-anim="scroll">
          <span class="label op-30">{s.num}</span>
          <div class="flex flex-col gap-5 max-w-[58ch]">
            {'heading' in s && <h2 class="stmt-h" style="font-variation-settings:var(--font-weight-normal)">{s.heading}</h2>}
            {s.body.map(p => <p class="text-[var(--text-lg)] leading-[1.8] text-[var(--color-ink-soft)]" style="font-variation-settings:var(--font-weight-normal)">{p}</p>)}
          </div>
        </div>
        <div class="rule"></div>
        {i === 1 && (
          <>
            <blockquote class="serif block italic leading-[1.12] tracking-[-0.02em] text-center py-20 md:py-28 pull-quote" data-anim="scroll">
              "The most radical act is <em class="not-italic text-[var(--color-mid)]">silence.</em>"
            </blockquote>
            <div class="rule"></div>
          </>
        )}
      </>
    ))}
  </section>

  <section class="mb-[var(--space-3xl)] md:mb-[var(--space-4xl)]" data-anim="scroll">
    <div class="relative min-h-[280px] h-[55svh] md:h-[65svh] overflow-hidden">
      <Picture
        class="atelier-img js-atelier-img absolute inset-0"
        src={IMAGES['atelier']}
        formats={['avif', 'webp']}
        alt="Voidhaus atelier"
        loading="lazy"
        decoding="async"
        width={1400}
      />
      <div class="scrim" style="background:var(--scrim-dark-light)"></div>
    </div>
    <div class="product-grid wrap">
      {SITE.ateliers.map((a, i) => (
        <div class="at-item flex flex-col gap-[0.6rem] p-7 md:p-9 bg-[var(--color-white)] transition-colors duration-[var(--duration-fast)] hover:bg-[var(--color-off)]" data-anim="stagger">
          <span class="label op-30">{String(i + 1).padStart(2, '0')}</span>
          <span class="at-city" style="font-variation-settings:var(--font-weight-normal)">{a.city}</span>
          <span class="label op-45">{a.specialty}</span>
        </div>
      ))}
    </div>
  </section>

  <CTAStrip label="Ready?" linkText="View Collection" href="/collection" />

</Layout>

<script>
import { initPage, onReady, gsap } from '@lib/animate';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    initPage('.js-rule');

    const img = document.querySelector<HTMLElement>('.js-atelier-img');
    if (img) {
      gsap.set(img, { scale: 1.12 });
      ScrollTrigger.create({
        trigger: '.atelier-media', start: 'top bottom', end: 'bottom top', scrub: 2,
        onUpdate: st => gsap.set(img, { yPercent: -8 * st.progress }),
      });
    }
  });
});
</script>

<style>
.about-title { font-size: clamp(2.5rem, 8vw, 7rem); letter-spacing: -0.04em; line-height: 1; }
.stmt-h      { font-size: clamp(1.125rem, 2.5vw, 1.625rem); letter-spacing: -0.02em; line-height: 1.2; }
.pull-quote  { font-size: clamp(1.75rem, 6vw, 4.5rem); }
.at-city     { font-size: clamp(1rem, 2.5vw, 1.5rem); letter-spacing: -0.02em; }
.atelier-img img { object-position: center; }
</style>
