---
import Layout from '@layouts/Layout.astro';
import { Picture } from 'astro:assets';
import CTAStrip from '@components/CTAStrip.astro';
import { SITE } from '@data/site';
import { IMAGES } from '@assets/images';

const statements = [
  {
    num: '001',
    body: [
      'Voidhaus was not born from a desire to dress people. It was born from a frustration with fashion that performs humility while demanding admiration.',
      'We care. Deeply. Obsessively. But not about you noticing.',
    ],
  },
  {
    num: '002',
    heading: 'The garment as architecture.',
    body: [
      'We work from the structure outward. A coat must stand before it must move. Comfort is a result of precision, not an excuse for its absence.',
      'Every piece is designed to outlast the season it is born in.',
    ],
  },
  {
    num: '003',
    heading: 'On restraint.',
    body: [
      'We produce twelve pieces per collection. Each garment is finished by hand. Each seam is checked by eye. We will never grow faster than our ability to care.',
    ],
  },
  {
    num: '004',
    heading: 'Who we dress.',
    body: [
      'We do not design for a demographic. We design for a disposition. If you already know — you do not need us to tell you.',
    ],
  },
] as const;
---

<Layout title="Manifesto" solidNav={true}>

  <header class="about-head wrap">
    <div class="rule js-rule"></div>
    <div class="about-head-inner">
      <div>
        <span class="label muted" data-anim="hero">Manifesto</span>
        <h1 class="about-title" data-anim="hero" data-delay="0.1">We reject<br/>the legible.</h1>
      </div>
    </div>
  </header>

  <section class="statements wrap">
    {statements.map((s, i) => (
      <>
        <div class="stmt" data-anim="scroll">
          <span class="label op-30 stmt-num">{s.num}</span>
          <div class="stmt-body">
            {'heading' in s && <h2 class="stmt-h">{s.heading}</h2>}
            {s.body.map(p => <p class="stmt-p">{p}</p>)}
          </div>
        </div>
        <div class="rule"></div>
        {i === 1 && (
          <>
            <blockquote class="pull-quote serif" data-anim="scroll">
              "The most radical act is <em>silence.</em>"
            </blockquote>
            <div class="rule"></div>
          </>
        )}
      </>
    ))}
  </section>

  <section class="atelier" data-anim="scroll">
    <div class="atelier-media">
      <Picture
        class="atelier-img js-atelier-img"
        src={IMAGES['atelier']}
        formats={['avif', 'webp']}
        alt="Voidhaus atelier"
        loading="lazy"
        decoding="async"
        width={1400}
      />
      <div class="atelier-scrim scrim"></div>
    </div>
    <div class="product-grid wrap">
      {SITE.ateliers.map((a, i) => (
        <div class="at-item" data-anim="stagger">
          <span class="label op-30">{String(i + 1).padStart(2, '0')}</span>
          <span class="at-city">{a.city}</span>
          <span class="label op-45">{a.specialty}</span>
        </div>
      ))}
    </div>
  </section>

  <CTAStrip label="Ready?" linkText="View Collection" href="/collection" />

</Layout>

<script>
import { initPage, onReady, gsap } from '@lib/animate';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    initPage('.js-rule');

    const img = document.querySelector<HTMLElement>('.js-atelier-img');
    if (img) {
      gsap.set(img, { scale: 1.12 });
      ScrollTrigger.create({
        trigger: '.atelier-media', start: 'top bottom', end: 'bottom top', scrub: 2,
        onUpdate: st => gsap.set(img, { yPercent: -8 * st.progress }),
      });
    }
  });
});
</script>

<style>
.about-head {
  padding-top: calc(var(--nav-h) + var(--space-2xl));
  padding-bottom: var(--space-2xl);
}

.about-head-inner {
  padding-top: var(--space-lg);
}

.about-title {
  font-size: clamp(2.5rem, 8vw, 7rem);
  font-variation-settings: var(--font-weight-light);
  letter-spacing: -0.04em;
  line-height: 1;
  margin-top: var(--space-xs);
}

.statements { padding-bottom: var(--space-2xl); }

.stmt {
  display: grid;
  gap: var(--space-md);
  padding-block: var(--space-xl);
}
@media (min-width: 640px) {
  .stmt { grid-template-columns: 5rem 1fr; gap: var(--space-2xl); padding-block: var(--space-3xl); }
}

.stmt-body { display: flex; flex-direction: column; gap: 1.25rem; max-width: 58ch; }

.stmt-h {
  font-size: clamp(1.125rem, 2.5vw, 1.625rem);
  font-variation-settings: var(--font-weight-normal);
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.stmt-p {
  font-size: var(--text-lg);
  font-variation-settings: var(--font-weight-normal);
  line-height: 1.8;
  color: var(--color-ink-soft);
}

.pull-quote {
  display: block;
  font-size: clamp(1.75rem, 6vw, 4.5rem);
  font-style: italic;
  line-height: 1.12;
  letter-spacing: -0.02em;
  text-align: center;
  padding-block: 5rem;
}
@media (min-width: 768px) { .pull-quote { padding-block: 7rem; } }
.pull-quote em { font-style: normal; color: var(--color-mid); }

.atelier { margin-bottom: var(--space-3xl); }
@media (min-width: 768px) { .atelier { margin-bottom: var(--space-4xl); } }

.atelier-media {
  position: relative;
  height: 55svh; min-height: 280px;
  overflow: hidden;
}
@media (min-width: 768px) { .atelier-media { height: 65svh; } }

.atelier-scrim { background: var(--scrim-dark-light); }

.at-item {
  background: var(--color-white);
  padding: 1.75rem 1.5rem;
  display: flex; flex-direction: column; gap: 0.6rem;
  transition: background var(--duration-fast);
}
@media (min-width: 768px) { .at-item { padding: 2.25rem 2rem; } }
.at-item:hover { background: var(--color-off); }

.at-city {
  font-size: clamp(1rem, 2.5vw, 1.5rem);
  font-variation-settings: var(--font-weight-normal);
  letter-spacing: -0.02em;
}
</style>
