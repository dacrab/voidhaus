---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE } from '../../data/site';
---

<Layout title="Manifesto">
  <PageHeader label="Manifesto" title="We reject the legible." />

  <section class="statements wrap">

    <div class="stmt" data-anim="scroll">
      <span class="label stmt-num">001</span>
      <div class="stmt-body">
        <p class="stmt-p">Voidhaus was not born from a desire to dress people. It was born from a frustration with fashion that performs humility while demanding admiration.</p>
        <p class="stmt-p">We care. Deeply. Obsessively. But not about you noticing.</p>
      </div>
    </div>
    <div class="rule"></div>

    <div class="stmt" data-anim="scroll">
      <span class="label stmt-num">002</span>
      <div class="stmt-body">
        <h2 class="stmt-h">The garment as architecture.</h2>
        <p class="stmt-p">We work from the structure outward. A coat must stand before it must move. Comfort is a result of precision, not an excuse for its absence.</p>
        <p class="stmt-p">Every piece is designed to outlast the season it is born in.</p>
      </div>
    </div>
    <div class="rule"></div>

    <div class="stmt" data-anim="scroll">
      <span class="label stmt-num">003</span>
      <div class="stmt-body">
        <h2 class="stmt-h">On restraint.</h2>
        <p class="stmt-p">We produce twelve pieces per collection. Each garment is finished by hand. Each seam is checked by eye. We will never grow faster than our ability to care.</p>
      </div>
    </div>
    <div class="rule"></div>

    <blockquote class="pull-quote serif" data-anim="scroll">
      "The most radical act is <em>silence.</em>"
    </blockquote>
    <div class="rule"></div>

    <div class="stmt" data-anim="scroll">
      <span class="label stmt-num">004</span>
      <div class="stmt-body">
        <h2 class="stmt-h">Who we dress.</h2>
        <p class="stmt-p">We do not design for a demographic. We design for a disposition. If you already know — you do not need us to tell you.</p>
      </div>
    </div>
    <div class="rule"></div>

  </section>

  <!-- Atelier image -->
  <section class="atelier" data-anim="scroll">
    <div class="atelier-img-wrap">
      <img
        class="atelier-img"
        src="https://images.unsplash.com/photo-1558769132-cb1aea458c5e?w=1400&q=85&auto=format&fit=crop"
        alt="Voidhaus atelier"
        loading="lazy" decoding="async"
        width="1400" height="900"
      />
      <div class="atelier-scrim"></div>
    </div>
    <div class="atelier-grid wrap">
      {SITE.ateliers.map((a, i) => (
        <div class="at-item js-at-item" style={`--i:${i}`}>
          <span class="label at-num">0{i + 1}</span>
          <span class="at-city">{a.city}</span>
          <span class="label at-role">{a.role}</span>
        </div>
      ))}
    </div>
  </section>

  <div class="cta-strip wrap" data-anim="scroll">
    <div class="rule"></div>
    <div class="cta-inner">
      <span class="label op-35">Ready?</span>
      <a href="/collection" class="label cta-link">View Collection →</a>
    </div>
    <div class="rule"></div>
  </div>
</Layout>

<script>
import { onReady, reveal, staggerReveal } from '../../lib/animate';

onReady(() => {
  reveal();
  staggerReveal('.js-at-item', '.atelier-grid', 0.1, 0.07);
});
</script>

<style>
.statements { padding-bottom: 3rem; }
@media (min-width: 768px) { .statements { padding-bottom: 5rem; } }

.stmt {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
  padding-block: 2.5rem;
}
@media (min-width: 640px) {
  .stmt { grid-template-columns: 5rem 1fr; gap: 3rem; padding-block: 4rem; }
}

.stmt-num { opacity: 0.3; padding-top: 0.1rem; }

.stmt-body { display: flex; flex-direction: column; gap: 1.25rem; max-width: 58ch; }

.stmt-h {
  font-family: var(--font-sans);
  font-size: clamp(1.125rem, 2.5vw, 1.625rem);
  font-variation-settings: 'wght' 300;
  letter-spacing: -0.02em;
  line-height: 1.2;
  color: var(--color-ink);
}

.stmt-p {
  font-size: 0.875rem;
  font-variation-settings: 'wght' 300;
  line-height: 1.9;
  color: var(--color-soft);
}

.pull-quote {
  display: block;
  font-size: clamp(1.75rem, 6vw, 4.5rem);
  font-style: italic;
  line-height: 1.12;
  letter-spacing: -0.02em;
  color: var(--color-ink);
  padding-block: 5rem;
  text-align: center;
}
@media (min-width: 768px) { .pull-quote { padding-block: 7rem; } }
.pull-quote em { font-style: normal; color: var(--color-mid); }

/* Atelier */
.atelier { margin-bottom: 4rem; }
@media (min-width: 768px) { .atelier { margin-bottom: 6rem; } }

.atelier-img-wrap {
  position: relative;
  height: 55svh; min-height: 280px;
  overflow: hidden;
}
@media (min-width: 768px) { .atelier-img-wrap { height: 65svh; } }

.atelier-img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; }
.atelier-scrim { position: absolute; inset: 0; background: rgb(28 27 25 / 0.18); }

.atelier-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  background: var(--color-rule);
  border-inline: 1px solid var(--color-rule);
  border-bottom: 1px solid var(--color-rule);
}
@media (min-width: 768px) { .atelier-grid { grid-template-columns: repeat(4, 1fr); } }

.at-item {
  background: var(--color-white);
  padding: 1.75rem 1.5rem;
  display: flex; flex-direction: column; gap: 0.6rem;
  transition: background 0.2s;
}
@media (min-width: 768px) { .at-item { padding: 2.25rem 2rem; } }
.at-item:hover { background: var(--color-off); }

.at-num { opacity: 0.3; }
.at-city {
  font-family: var(--font-sans);
  font-size: clamp(1rem, 2.5vw, 1.5rem);
  font-variation-settings: 'wght' 300;
  letter-spacing: -0.02em;
  color: var(--color-ink);
}
.at-role { opacity: 0.45; }

/* CTA */
.cta-strip { padding-block: 1.5rem 4rem; }
.cta-inner {
  display: flex; justify-content: space-between; align-items: center;
  flex-wrap: wrap; gap: 0.75rem; padding-block: 1.5rem;
}
.cta-link { opacity: 0.4; transition: opacity 0.2s; }
.cta-link:hover { opacity: 1; }
</style>
