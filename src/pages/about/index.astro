---
import Layout from '../../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import { SITE } from '../../data/site';
import { IMAGES } from '../../assets/images';
---

<Layout title="Manifesto" solidNav={true}>
  <div class="ph wrap page-top-spacing">
    <div class="ph-inner">
      <div class="ph-left">
        <span class="label muted" data-anim="hero" data-delay="0">Manifesto</span>
        <h1 class="ph-title" data-anim="hero" data-delay="0.15">We reject the legible.</h1>
      </div>
    </div>
    <div class="rule"></div>
  </div>

  <section class="statements wrap">

    <div class="stmt" data-anim="statement">
      <span class="label op-30 stmt-num">001</span>
      <div class="stmt-body">
        <p class="stmt-p">Voidhaus was not born from a desire to dress people. It was born from a frustration with fashion that performs humility while demanding admiration.</p>
        <p class="stmt-p">We care. Deeply. Obsessively. But not about you noticing.</p>
      </div>
    </div>
    <div class="rule"></div>

    <div class="stmt" data-anim="statement">
      <span class="label op-30 stmt-num">002</span>
      <div class="stmt-body">
        <h2 class="stmt-h">The garment as architecture.</h2>
        <p class="stmt-p">We work from the structure outward. A coat must stand before it must move. Comfort is a result of precision, not an excuse for its absence.</p>
        <p class="stmt-p">Every piece is designed to outlast the season it is born in.</p>
      </div>
    </div>
    <div class="rule"></div>

    <div class="stmt" data-anim="statement">
      <span class="label op-30 stmt-num">003</span>
      <div class="stmt-body">
        <h2 class="stmt-h">On restraint.</h2>
        <p class="stmt-p">We produce twelve pieces per collection. Each garment is finished by hand. Each seam is checked by eye. We will never grow faster than our ability to care.</p>
      </div>
    </div>
    <div class="rule"></div>

    <blockquote class="pull-quote serif" data-anim="scroll">
      "The most radical act is <em>silence.</em>"
    </blockquote>
    <div class="rule"></div>

    <div class="stmt" data-anim="statement">
      <span class="label op-30 stmt-num">004</span>
      <div class="stmt-body">
        <h2 class="stmt-h">Who we dress.</h2>
        <p class="stmt-p">We do not design for a demographic. We design for a disposition. If you already know — you do not need us to tell you.</p>
      </div>
    </div>
    <div class="rule"></div>

  </section>

  <section class="atelier" data-anim="scroll">
    <div class="atelier-img-wrap">
      <Picture
        class="atelier-img"
        src={IMAGES['atelier']}
        formats={['avif', 'webp']}
        alt="Voidhaus atelier"
        loading="lazy"
        decoding="async"
        width={1400}
      />
      <div class="atelier-scrim scrim"></div>
    </div>
    <div class="product-grid wrap">
      {SITE.ateliers.map((a, i) => (
        <div class="at-item" data-anim="stagger" style={`--i:${i}`}>
          <span class="label op-30 at-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="at-city">{a.city}</span>
          <span class="label op-45 at-role">{a.specialty}</span>
        </div>
      ))}
    </div>
  </section>

  <div class="cta wrap" data-anim="scroll">
    <div class="rule"></div>
    <div class="cta-inner">
      <span class="label op-35">Ready?</span>
      <a href="/collection" class="label muted-link">View Collection →</a>
    </div>
    <div class="rule"></div>
  </div>
</Layout>

<script>
import { reveal, lineReveal, gsap, DUR, EASE } from '../../lib/animate';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

document.addEventListener('astro:page-load', () => {
  Promise.race([document.fonts.ready, new Promise<void>(r => setTimeout(r, 300))])
    .then(() => requestAnimationFrame(() => requestAnimationFrame(() => {
      reveal();
      lineReveal('.ph .rule', 0.3);
      
      // Statement reveal
      document.querySelectorAll<HTMLElement>('[data-anim="statement"]').forEach(el => {
        const num  = el.querySelector<HTMLElement>('.stmt-num');
        const body = el.querySelectorAll<HTMLElement>('.stmt-h, .stmt-p');
        ScrollTrigger.create({
          trigger: el, start: 'top 88%', once: true,
          onEnter: () => {
            const tl = gsap.timeline();
            if (num) tl.fromTo(num, { opacity: 0, x: -8 }, { opacity: 1, x: 0, duration: DUR.sm, ease: EASE.expo }, 0);
            tl.fromTo(body, { opacity: 0, y: 18 }, { opacity: 1, y: 0, duration: DUR.md, ease: EASE.expo, stagger: 0.1 }, 0.05);
          },
        });
      });
      
      // Pull quote
      const el = document.querySelector<HTMLElement>('.pull-quote');
      if (el) {
        ScrollTrigger.create({
          trigger: el, start: 'top 88%', once: true,
          onEnter: () => gsap.fromTo(el,
            { opacity: 0, y: 24, skewY: 1 },
            { opacity: 1, y: 0, skewY: 0, duration: DUR.lg, ease: EASE.expo, clearProps: 'skewY' },
          ),
        });
      }
    })));
});
</script>

<style>
.ph-inner {
  display: flex; align-items: flex-end;
  justify-content: space-between;
  padding-bottom: var(--space-lg); gap: var(--space-md);
}

.ph-left { display: flex; flex-direction: column; gap: var(--space-xs); }

.ph-title {
  font-family: var(--font-sans);
  font-size: var(--text-display-md);
  font-variation-settings: var(--font-weight-light);
  letter-spacing: -0.04em;
  line-height: 1;
}

.statements { padding-bottom: var(--space-2xl); }
@media (min-width: 768px) { .statements { padding-bottom: var(--section-gap-md); } }

.stmt {
  display: grid;
  gap: var(--space-md);
  padding-block: var(--space-xl);
}
@media (min-width: 640px) {
  .stmt { grid-template-columns: 5rem 1fr; gap: var(--space-2xl); padding-block: var(--space-3xl); }
}

.stmt-num { padding-top: 0.1rem; }

.stmt-body { display: flex; flex-direction: column; gap: 1.25rem; max-width: 58ch; }

.stmt-h {
  font-family: var(--font-sans);
  font-size: clamp(1.125rem, 2.5vw, 1.625rem);
  font-variation-settings: var(--font-weight-normal);
  letter-spacing: -0.02em;
  line-height: 1.2;
  color: var(--color-ink);
}

.stmt-p {
  font-size: var(--text-base);
  font-variation-settings: var(--font-weight-normal);
  line-height: 1.9;
  color: var(--color-soft);
}

.pull-quote {
  display: block;
  font-size: clamp(1.75rem, 6vw, 4.5rem);
  font-style: italic;
  line-height: 1.12;
  letter-spacing: -0.02em;
  color: var(--color-ink);
  padding-block: 5rem;
  text-align: center;
}
@media (min-width: 768px) { .pull-quote { padding-block: 7rem; } }
.pull-quote em { font-style: normal; color: var(--color-mid); }

.atelier { margin-bottom: var(--space-3xl); }
@media (min-width: 768px) { .atelier { margin-bottom: var(--space-4xl); } }

.atelier-img-wrap {
  position: relative;
  height: 55svh; min-height: 280px;
  overflow: hidden;
}
@media (min-width: 768px) { .atelier-img-wrap { height: 65svh; } }

.atelier-img img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; }
.atelier-scrim { background: var(--scrim-dark-light); }

.at-item {
  background: var(--color-white);
  padding: 1.75rem 1.5rem;
  display: flex; flex-direction: column; gap: 0.6rem;
  transition: background var(--duration-fast);
}
@media (min-width: 768px) { .at-item { padding: 2.25rem 2rem; } }
.at-item:hover { background: var(--color-off); }

.at-city {
  font-family: var(--font-sans);
  font-size: clamp(1rem, 2.5vw, 1.5rem);
  font-variation-settings: var(--font-weight-normal);
  letter-spacing: -0.02em;
  color: var(--color-ink);
}

/* ── CTA Strip ─────────────────────────────────────────────────────────── */
.cta { padding-block: var(--space-lg) var(--space-3xl); }
.cta-inner {
  display: flex; justify-content: space-between; align-items: center;
  flex-wrap: wrap; gap: var(--space-sm); padding-block: var(--space-lg);
}
</style>
