---
import Layout from '@layouts/Layout.astro';
import { STOCKISTS } from '@data/stockists';

const total = STOCKISTS.reduce((n, r) => n + r.stores.length, 0);
---

<Layout title="Stockists" description="Find Voidhaus at select retailers worldwide." solidNav={true}>

  <header class="wrap pt-[calc(var(--nav-h)+var(--space-2xl))] pb-[var(--space-2xl)]">
    <div class="rule js-rule"></div>
    <div class="flex items-end justify-between pt-[var(--space-lg)] gap-[var(--space-md)]">
      <div>
        <span class="label muted" data-anim="hero">Worldwide</span>
        <h1 class="st-title mt-[var(--space-xs)]" data-anim="hero" data-delay="0.1" style="font-variation-settings:var(--font-weight-light)">Stockists</h1>
      </div>
      <span class="label muted" data-anim="hero" data-delay="0.2">{total} stores</span>
    </div>
  </header>

  <div class="wrap pb-[var(--space-4xl)]">
    {STOCKISTS.map((region, ri) => (
      <div class="pt-[var(--space-3xl)] md:pt-[var(--space-4xl)]" data-anim="scroll">
        <div class="flex items-baseline gap-[var(--space-lg)] pb-[var(--space-xl)] border-b border-[var(--color-rule)]">
          <span class="label op-30">{String(ri + 1).padStart(2, '0')}</span>
          <h2 class="region-title flex-1" style="font-variation-settings:var(--font-weight-normal)">{region.region}</h2>
          <span class="label muted">{region.stores.length} stores</span>
        </div>
        <div class="stores-grid grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-px bg-[var(--color-rule)] border-x border-b border-[var(--color-rule)] mb-[var(--space-3xl)]">
          {region.stores.map(s => (
            <div class="flex flex-col gap-[var(--space-xs)] bg-[var(--color-white)] p-[var(--space-lg)] md:p-[var(--space-xl)] transition-colors duration-[var(--duration-fast)] hover:bg-[var(--color-off)]">
              <div class="flex items-center justify-between gap-[var(--space-xs)] mb-1">
                <span class="label op-35">{s.city}</span>
                <span class="label muted">{s.country}</span>
              </div>
              <h3 class="text-[var(--text-base)] text-[var(--color-ink)] tracking-[-0.02em]" style="font-variation-settings:var(--font-weight-medium)">{s.name}</h3>
              <p class="label muted normal-case tracking-normal leading-[1.5]">{s.address}</p>
            </div>
          ))}
        </div>
        <div class="rule"></div>
      </div>
    ))}

    <div class="flex items-center justify-between flex-wrap gap-[var(--space-md)] py-[var(--space-3xl)] border-t border-[var(--color-rule)]" data-anim="scroll">
      <p class="text-[var(--text-base)] text-[var(--color-soft)]" style="font-variation-settings:var(--font-weight-normal)">Interested in stocking Voidhaus?</p>
      <a href="/contact" class="label muted-link">Get in touch →</a>
    </div>
  </div>

</Layout>

<script>
import { initPage, onReady } from '@lib/animate';
document.addEventListener('astro:page-load', () => {
  onReady(() => { initPage('.js-rule'); });
});
</script>

<style>
.st-title    { font-size: var(--text-display-md); letter-spacing: -0.04em; line-height: 1; }
.region-title { font-size: clamp(1.25rem, 3vw, 2rem); letter-spacing: -0.02em; }
</style>
