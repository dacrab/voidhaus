---
import Layout from '@layouts/Layout.astro';
import { STOCKISTS } from '@data/stockists';

const total = STOCKISTS.reduce((n, r) => n + r.stores.length, 0);
---

<Layout title="Stockists" description="Find Voidhaus at select retailers worldwide." solidNav={true}>

  <header class="page-header wrap">
    <div class="rule js-rule"></div>
    <div class="flex items-end justify-between pt-lg gap-md">
      <div>
        <span class="label muted" data-anim="hero">Worldwide</span>
        <h1 class="st-title fw-light mt-xs" data-anim="hero" data-delay="0.1">Stockists</h1>
      </div>
      <span class="label muted" data-anim="hero" data-delay="0.2">{total} stores</span>
    </div>
  </header>

  <div class="wrap pb-4xl">
    {STOCKISTS.map((region, ri) => (
      <div class="pt-3xl md:pt-4xl" data-anim="scroll">
        <div class="flex items-baseline gap-lg pb-xl border-b border-[var(--color-rule)]">
          <span class="label op-30">{String(ri + 1).padStart(2, '0')}</span>
          <h2 class="region-title fw-normal flex-1">{region.region}</h2>
          <span class="label muted">{region.stores.length} stores</span>
        </div>
        <div class="product-grid mb-3xl">
          {region.stores.map(s => (
            <div class="flex flex-col gap-xs bg-[var(--color-white)] p-lg md:p-xl transition-colors duration-[var(--duration-fast)] hover:bg-[var(--color-off)]">
              <div class="flex items-center justify-between gap-xs mb-1">
                <span class="label op-35">{s.city}</span>
                <span class="label muted">{s.country}</span>
              </div>
              <h3 class="text-base fw-medium tracking-tight">{s.name}</h3>
              <p class="label muted normal-case tracking-normal leading-[1.5]">{s.address}</p>
            </div>
          ))}
        </div>
        <div class="rule"></div>
      </div>
    ))}

    <div class="flex items-center justify-between flex-wrap gap-md py-3xl border-t border-[var(--color-rule)]" data-anim="scroll">
      <p class="text-base fw-normal text-[var(--color-soft)]">Interested in stocking Voidhaus?</p>
      <a href="/contact" class="label muted-link">Get in touch →</a>
    </div>
  </div>

</Layout>

<script>
import { initPage, onReady } from '@lib/animate';
document.addEventListener('astro:page-load', () => {
  onReady(() => { initPage('.js-rule'); });
});
</script>

<style>
.st-title     { font-size: var(--text-display); letter-spacing: -0.04em; line-height: 1; }
.region-title { font-size: clamp(1.25rem, 3vw, 2rem); letter-spacing: -0.02em; }
</style>
