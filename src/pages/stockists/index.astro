---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';

const stockists = [
  {
    region: 'Europe',
    stores: [
      { city: 'Milan',     name: 'Antonia',          address: 'Via Cusani 5, 20121',          country: 'Italy' },
      { city: 'Milan',     name: '10 Corso Como',    address: 'Corso Como 10, 20154',          country: 'Italy' },
      { city: 'Paris',     name: 'Colette',           address: '213 Rue Saint-Honoré, 75001',  country: 'France' },
      { city: 'Paris',     name: 'L\'Eclaireur',      address: '3 Rue des Rosiers, 75004',      country: 'France' },
      { city: 'London',    name: 'Dover Street Market', address: '18-22 Haymarket, SW1Y 4DG',  country: 'UK' },
      { city: 'Antwerp',   name: 'Louis',             address: 'Lombardenvest 2, 2000',         country: 'Belgium' },
      { city: 'Berlin',    name: 'Voo Store',         address: 'Oranienstr. 24, 10999',         country: 'Germany' },
    ],
  },
  {
    region: 'Americas',
    stores: [
      { city: 'New York',  name: 'Opening Ceremony', address: '35 Howard Street, NY 10013',    country: 'USA' },
      { city: 'New York',  name: 'Barneys New York',  address: '660 Madison Ave, NY 10065',    country: 'USA' },
      { city: 'Los Angeles', name: 'H.Lorenzo',       address: '8660 Sunset Blvd, CA 90069',   country: 'USA' },
      { city: 'Toronto',   name: 'Ssense',            address: '90 St Paul St W, H2Y 1Z1',     country: 'Canada' },
    ],
  },
  {
    region: 'Asia Pacific',
    stores: [
      { city: 'Tokyo',     name: 'United Arrows',    address: '3-28-1 Jingumae, Shibuya',      country: 'Japan' },
      { city: 'Tokyo',     name: 'Isetan',           address: '3-14-1 Shinjuku, 160-0022',     country: 'Japan' },
      { city: 'Seoul',     name: 'Boon The Shop',    address: '2F, 86 Cheongdam-dong',         country: 'Korea' },
      { city: 'Hong Kong', name: 'Lane Crawford',    address: 'IFC Mall, 8 Finance Street',    country: 'HK' },
      { city: 'Sydney',    name: 'Incu',             address: '76 Oxford Street, Paddington',  country: 'Australia' },
    ],
  },
];
---

<Layout title="Stockists" description="Find Voidhaus at select retailers worldwide." solidNav={true}>
  <PageHeader label="Worldwide" title="Stockists" aside={`${stockists.reduce((t, r) => t + r.stores.length, 0)} stores`} />

  <div class="stockists wrap">
    {stockists.map((region, ri) => (
      <div class="region" data-anim="scroll" style={`--delay:${ri * 0.1}s`}>
        <div class="region-header">
          <span class="label op-30 region-num">{String(ri + 1).padStart(2, '0')}</span>
          <h2 class="region-title">{region.region}</h2>
          <span class="label muted region-count">{region.stores.length} stores</span>
        </div>
        <div class="stores-grid">
          {region.stores.map(s => (
            <div class="store">
              <div class="store-top">
                <span class="store-city label op-35">{s.city}</span>
                <span class="store-country label muted">{s.country}</span>
              </div>
              <h3 class="store-name">{s.name}</h3>
              <p class="store-address label muted">{s.address}</p>
            </div>
          ))}
        </div>
        <div class="rule"></div>
      </div>
    ))}

    <div class="stockists-cta" data-anim="scroll">
      <p class="cta-text">
        Interested in stocking Voidhaus?
      </p>
      <a href="/contact" class="label cta-link">Get in touch →</a>
    </div>
  </div>
</Layout>

<script>
import { onPageLoad, pageReveal, staggerReveal } from '../../lib/animate';

onPageLoad(() => {
  pageReveal();
  staggerReveal('.store', '.stores-grid', 0, 0.06);
});
</script>

<style>
  .stockists { padding-bottom: 6rem; }

  .region { padding-block: 3.5rem 0; }
  @media (min-width: 768px) { .region { padding-block: 5rem 0; } }

  .region-header {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: 0;
  }

  .region-title {
    font-family: var(--font-sans);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-variation-settings: 'wght' 300;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    flex: 1;
  }

  .stores-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-rule);
    border-inline: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }
  @media (min-width: 768px) { .stores-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1280px) { .stores-grid { grid-template-columns: repeat(4, 1fr); } }

  .store {
    background: var(--color-white);
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: background 0.2s;
  }
  @media (min-width: 768px) { .store { padding: 2rem 1.5rem; } }
  .store:hover { background: var(--color-off); }

  .store-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .store-name {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-variation-settings: 'wght' 400;
    color: var(--color-ink);
    letter-spacing: 0.01em;
  }

  .store-address {
    text-transform: none;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  .stockists-cta {
    padding-block: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    border-top: 1px solid var(--color-rule);
  }

  .cta-text {
    font-size: 0.875rem;
    font-variation-settings: 'wght' 300;
    color: var(--color-soft);
  }

  .cta-link {
    color: var(--color-ink);
    opacity: 0.5;
    transition: opacity 0.2s;
  }
  .cta-link:hover { opacity: 1; }
</style>
