---
import Layout from '../../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import { PRODUCTS, SHARED_DETAILS } from '../../data/products';
import SizeGuide from '../../components/SizeGuide.svelte';
import { IMAGES } from '../../assets/images';

export function getStaticPaths() {
  return PRODUCTS.map(p => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product: p } = Astro.props;

const details: [string, string][] = [
  ['Material', p.material],
  ['Origin',   p.origin],
  ...SHARED_DETAILS,
];

const idx  = PRODUCTS.findIndex(x => x.slug === p.slug);
const prev = PRODUCTS[idx - 1] ?? null;
const next = PRODUCTS[idx + 1] ?? null;
---

<Layout title={p.name} description={p.desc} type="product" solidNav={true}>
  <div class="product-page">

    <div class="product-images">
      <div class="img-primary">
        <Picture
          class="product-img js-main-img"
          src={IMAGES[p.img]}
          formats={['avif', 'webp']}
          alt={p.name}
          fetchpriority="high"
          decoding="async"
          width={1200}
          transition:name={`product-img-${p.slug}`}
        />
      </div>
      {p.img2 && (
        <div class="img-secondary" aria-hidden="true">
          <Picture
            class="product-img"
            src={IMAGES[p.img2]}
            formats={['avif', 'webp']}
            alt=""
            loading="lazy"
            decoding="async"
            width={900}
          />
        </div>
      )}
    </div>

    <div class="product-info">
      <div class="info-top" data-anim="hero" data-delay="0">
        <a href="/collection" class="label muted-link">← Collection</a>
        <span class="label op-30">{p.num}</span>
      </div>

      <h1 class="product-name" data-anim="hero" data-delay="0.15">
        {p.name}
      </h1>

      <p class="product-desc" data-anim="scroll">{p.desc}</p>

      <div class="product-story" data-anim="scroll">
        <h2 class="story-title serif">Craftsmanship</h2>
        <p class="story-text">
          Each piece is crafted with meticulous attention to detail in our atelier.
          We source materials from heritage suppliers who share our commitment to quality
          and sustainability. The result is clothing that improves with age, developing
          a unique character that becomes distinctly yours.
        </p>
      </div>

      <dl class="details" data-anim="scroll">
        {details.map(([k, v]) => (
          <div class="detail-row">
            <dt class="label detail-key">{k}</dt>
            <dd class="label detail-val">{v}</dd>
          </div>
        ))}
      </dl>

      <div class="sizes" data-anim="scroll">
        <div class="sizes-header">
          <span class="label sizes-lbl">Size</span>
          <SizeGuide category={p.category} client:load />
        </div>
        <div class="size-row" role="group" aria-label="Select size">
          {p.sizes.map((s, i) => (
            <button
              class:list={['sz-btn', 'label', { active: i === 1 }]}
              type="button"
              aria-pressed={i === 1}
            >
              {s}
            </button>
          ))}
        </div>
      </div>

      <div class="cta-block" data-anim="scroll">
        <div class="price-row">
          <span class="product-price serif">€ {p.price.toLocaleString('en-US', { minimumFractionDigits: 0 })}</span>
          <span class="label muted">Incl. VAT</span>
        </div>
        <button
          class="add-btn"
          id="js-add"
          type="button"
          data-product={JSON.stringify({ slug: p.slug, name: p.name, price: p.price.toLocaleString('en-US', { minimumFractionDigits: 0 }), img: IMAGES[p.img].src, num: p.num })}
        >
          <span class="label add-text">Add to Selection</span>
        </button>
        <span class="label ship-note">Complimentary worldwide shipping</span>
      </div>
    </div>
  </div>

  <div class="p-nav wrap">
    <div class="rule"></div>
    <div class="p-nav-inner">
      {prev
        ? <a href={`/product/${prev.slug}`} class="label muted-link">← {prev.name}</a>
        : <a href="/collection" class="label muted-link">← Collection</a>}
      {next
        ? <a href={`/product/${next.slug}`} class="label muted-link">{next.name} →</a>
        : <a href="/collection" class="label muted-link">Collection →</a>}
    </div>
    <div class="rule"></div>
  </div>
</Layout>

<script>
import { gsap, DUR, EASE, onReady } from '../../lib/animate';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    const el = document.querySelector<HTMLElement>('.js-main-img');
    const morphed = document.documentElement.hasAttribute('data-astro-transition');
    if (el) {
      if (morphed) {
        gsap.set(el, { opacity: 1, scale: 1 });
      } else {
        gsap.fromTo(el, { opacity: 0, scale: 1.05 }, { opacity: 1, scale: 1, duration: DUR.lg + 0.2, ease: 'power3.out' });
      }
    }

    gsap.fromTo(
      ['.product-name', '.product-desc', '.details', '.sizes', '.cta-block']
        .map(s => document.querySelector(s)).filter(Boolean),
      { opacity: 0, y: 18 },
      { opacity: 1, y: 0, duration: DUR.md, ease: EASE.expo, stagger: 0.08, delay: 0.3 },
    );

    const szBtns = document.querySelectorAll<HTMLElement>('.sz-btn');
    szBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        szBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
      });
    });

    const addBtn = document.getElementById('js-add') as HTMLButtonElement | null;
    const addText = addBtn?.querySelector<HTMLElement>('.add-text');

    addBtn?.addEventListener('click', () => {
      if (!addText) return;
      const size = document.querySelector<HTMLElement>('.sz-btn.active')?.textContent?.trim() ?? '';
      if (!size) { addBtn.setAttribute('aria-label', 'Please select a size'); return; }
      let product: Record<string, string>;
      try { product = JSON.parse(addBtn.dataset.product ?? '{}'); }
      catch { return; }
      window.dispatchEvent(new CustomEvent('vh:add-to-cart', { detail: { ...product, size } }));
      gsap.timeline()
        .to(addText, { opacity: 0, duration: 0.13, ease: 'power2.in' })
        .set(addText, { textContent: 'Added ✓' })
        .to(addText, { opacity: 1, duration: 0.2, ease: 'power2.out' })
        .to(addText, { opacity: 0, duration: 0.13, delay: 1.6, ease: 'power2.in' })
        .set(addText, { textContent: 'Add to Selection' })
        .to(addText, { opacity: 1, duration: 0.2, ease: 'power2.out' });
    });
  });
});
</script>

<style>
.product-page {
  display: flex;
  flex-direction: column;
}
@media (min-width: 768px) {
  .product-page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: calc(100svh - var(--nav-h));
    align-items: start;
    padding-top: var(--nav-h);
  }
}

/* Images */
.product-images {
  display: flex;
  flex-direction: column;
  gap: 1px;
  background: var(--color-rule);
}
@media (min-width: 768px) {
  .product-images {
    position: sticky;
    top: var(--nav-h);
    height: calc(100svh - var(--nav-h));
    overflow: hidden;
    background: none;
    gap: 0;
  }
}

.img-primary {
  aspect-ratio: 3/4;
  overflow: hidden;
  background: var(--color-off);
}
@media (min-width: 768px) { .img-primary { aspect-ratio: unset; height: 100%; } }

.img-secondary {
  aspect-ratio: 3/2;
  overflow: hidden;
  background: var(--color-paper);
}
@media (min-width: 768px) { .img-secondary { display: none; } }

.product-img,
.product-img picture {
  width: 100%;
  height: 100%;
  display: block;
}

.product-img img {
  width: 100%; height: 100%;
  object-fit: contain; object-position: center;
  display: block;
}

/* Info */
.product-info {
  padding: calc(var(--nav-h) + var(--space-xl)) var(--space-lg) var(--space-4xl);
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}
@media (min-width: 768px) {
  .product-info {
    padding: var(--space-3xl) var(--space-3xl) var(--space-4xl);
    position: sticky;
    top: var(--nav-h);
    height: calc(100svh - var(--nav-h));
    overflow-y: auto;
    scrollbar-width: none;
    justify-content: center;
  }
  .product-info::-webkit-scrollbar { display: none; }
}
@media (min-width: 1280px) { .product-info { padding: var(--space-3xl) var(--space-4xl) var(--space-4xl); } }

.info-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-name {
  font-family: var(--font-sans);
  font-size: clamp(1.75rem, 4.5vw, 3.25rem);
  font-variation-settings: var(--font-weight-normal);
  letter-spacing: -0.03em;
  line-height: 1.05;
  color: var(--color-ink);
  scroll-margin-top: calc(var(--nav-h) + var(--space-lg));
}

.product-desc {
  font-size: var(--text-lg);
  font-variation-settings: var(--font-weight-normal);
  line-height: 1.8;
  color: var(--color-ink-soft);
  max-width: 36ch;
}

.product-story {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  max-width: 36ch;
}

.story-title {
  font-size: var(--text-xl);
  font-variation-settings: var(--font-weight-medium);
  color: var(--color-ink);
}

.story-text {
  font-size: var(--text-base);
  line-height: 1.8;
  color: var(--color-soft);
}

.details { border-top: 1px solid var(--color-rule); }
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-block: 0.875rem;
  border-bottom: 1px solid var(--color-rule);
  gap: var(--space-md);
}
.detail-key { opacity: var(--opacity-muted); flex-shrink: 0; }
.detail-val { color: var(--color-ink-soft); text-align: right; text-transform: none; letter-spacing: var(--letter-spacing-normal); }

.sizes { display: flex; flex-direction: column; gap: 0.875rem; }
.sizes-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sizes-lbl { opacity: var(--opacity-muted); }
.size-row { display: flex; flex-wrap: wrap; gap: 0.4rem; }

.sz-btn {
  background: none;
  border: 1px solid var(--color-rule);
  color: var(--color-soft);
  padding: var(--space-xs) 0.875rem;
  transition: border-color var(--duration-fast), color var(--duration-fast);
}
.sz-btn:hover  { border-color: var(--color-mid); color: var(--color-ink); }
.sz-btn.active { border-color: var(--color-ink); color: var(--color-ink); }

.cta-block { display: flex; flex-direction: column; gap: var(--space-md); }

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-block: 1rem;
  border-top: 1px solid var(--color-rule);
  border-bottom: 1px solid var(--color-rule);
}
.product-price {
  font-size: var(--text-2xl);
  font-style: italic;
  font-variation-settings: var(--font-weight-medium);
  letter-spacing: -0.01em;
  color: var(--color-ink);
}

.add-btn {
  width: 100%;
  background: var(--color-ink);
  border: none;
  padding: 1.125rem 1.5rem;
  transition: background var(--duration-fast);
}
.add-btn:hover { background: var(--color-ink-soft); }
.add-text {
  color: var(--color-white);
  letter-spacing: var(--letter-spacing-button);
  display: block;
  text-align: center;
}

.ship-note { opacity: var(--opacity-disabled); display: block; text-align: center; }

.p-nav { padding-block: 2.5rem; }
.p-nav-inner {
  display: flex;
  justify-content: space-between;
  padding-block: 1.5rem;
}
</style>
em;
}
</style>
