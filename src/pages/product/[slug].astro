---
import Layout from '@layouts/Layout.astro';
import { Picture } from 'astro:assets';
import { PRODUCTS, SHARED_DETAILS } from '@data/products';
import SizeGuide from '@components/SizeGuide.svelte';
import { IMAGES } from '@assets/images';

export function getStaticPaths() {
  return PRODUCTS.map(p => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product: p } = Astro.props;

const details: [string, string][] = [
  ['Material', p.material],
  ['Origin',   p.origin],
  ...SHARED_DETAILS,
];

const idx  = PRODUCTS.findIndex(x => x.slug === p.slug);
const prev = PRODUCTS[idx - 1] ?? null;
const next = PRODUCTS[idx + 1] ?? null;
---

<Layout title={p.name} description={p.desc} type="product" solidNav={true}>

  <div class="pdp-layout">

    <!-- Images -->
    <div data-scroll-panel class="pdp-images">
      <div class="overflow-hidden bg-[var(--color-off)] aspect-[3/4] md:aspect-auto md:min-h-full">
        <Picture
          class="pdp-img js-main-img"
          src={IMAGES[p.img]}
          formats={['avif', 'webp']}
          alt={p.name}
          fetchpriority="high"
          decoding="async"
          width={1200}
        />
      </div>
      {p.img2 && (
        <div class="overflow-hidden bg-[var(--color-paper)] md:flex-1 md:min-h-[60vh]" aria-hidden="true">
          <Picture
            class="pdp-img"
            src={IMAGES[p.img2]}
            formats={['avif', 'webp']}
            alt=""
            loading="lazy"
            decoding="async"
            width={900}
          />
        </div>
      )}
    </div>

    <!-- Info -->
    <div data-pdp-info data-scroll-panel class="pdp-info">

      <div class="flex items-center justify-between">
        <a href="/collection" class="label muted-link">← Collection</a>
        <span class="label op-30">{p.num}</span>
      </div>

      <h1 class="pdp-name fw-light">{p.name}</h1>

      <p class="pdp-desc fw-normal">{p.desc}</p>

      <dl class="pdp-details">
        {details.map(([k, v]) => (
          <div class="detail-row">
            <dt class="label op-30 shrink-0">{k}</dt>
            <dd class="label detail-val">{v}</dd>
          </div>
        ))}
      </dl>

      <div class="flex flex-col gap-[0.875rem]">
        <div class="flex items-center justify-between">
          <span class="label muted">Size</span>
          <SizeGuide category={p.category} client:load />
        </div>
        <div class="flex flex-wrap gap-[0.4rem]" role="group" aria-label="Select size">
          {p.sizes.map((s, i) => (
            <button class:list={['sz-btn', 'label', { active: i === 1 }]} type="button" aria-pressed={i === 1}>{s}</button>
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-md">
        <div class="price-row">
          <span class="pdp-price serif fw-medium italic tracking-tight">€ {p.price.toLocaleString('en-US')}</span>
          <span class="label muted">Incl. VAT</span>
        </div>
        <button
          class="btn-outline"
          id="js-add" type="button"
          data-product={JSON.stringify({ slug: p.slug, name: p.name, price: p.price, img: IMAGES[p.img].src, num: p.num })}
          data-slug={p.slug}
        >
          <span class="label add-text w-full text-center tracking-[var(--ls-button)]">Add to Selection</span>
        </button>
        <span class="label op-30 block text-center">Complimentary worldwide shipping</span>
      </div>

    </div>
  </div>

  <nav class="wrap py-10" aria-label="Product navigation">
    <div class="rule"></div>
    <div class="flex justify-between py-6">
      {prev ? <a href={`/product/${prev.slug}`} class="label muted-link">← {prev.name}</a>
             : <a href="/collection"             class="label muted-link">← Collection</a>}
      {next ? <a href={`/product/${next.slug}`} class="label muted-link">{next.name} →</a>
             : <a href="/collection"             class="label muted-link">Collection →</a>}
    </div>
    <div class="rule"></div>
  </nav>

</Layout>

<script>
import { onReady, gsap, DUR, EASE, STAGGER } from '@lib/animate';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    const morphed = document.documentElement.hasAttribute('data-astro-transition');

    const img = document.querySelector<HTMLElement>('.js-main-img');
    if (img) {
      if (morphed) gsap.set(img, { opacity: 1, scale: 1 });
      else gsap.fromTo(img, { opacity: 0, scale: 1.04 }, { opacity: 1, scale: 1, duration: DUR.major, ease: 'power3.out' });
    }

    const panel = document.querySelector<HTMLElement>('[data-pdp-info]');
    const targets = panel ? ([...panel.children] as HTMLElement[]) : [];
    gsap.fromTo(targets,
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: DUR.major, ease: EASE, stagger: STAGGER, delay: morphed ? 0 : 0.2, clearProps: 'transform,will-change' },
    );

    const szBtns = document.querySelectorAll<HTMLButtonElement>('.sz-btn');
    szBtns.forEach(btn => btn.addEventListener('click', () => {
      szBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
    }));

    const addBtn  = document.getElementById('js-add') as HTMLButtonElement | null;
    const addText = addBtn?.querySelector<HTMLElement>('.add-text');

    // Stock check
    const slug = addBtn?.dataset.slug;
    if (slug && addBtn && addText) {
      const convexUrl = (import.meta as any).env?.PUBLIC_CONVEX_URL || window.__CONVEX_URL__;
      if (convexUrl) {
        fetch(`${convexUrl}/api/query`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ path: 'products:getBySlug', args: { slug } }),
        })
          .then(r => r.json())
          .then(data => {
            if (data?.value?.stock === 0) {
              addBtn.disabled = true;
              addBtn.classList.add('sold-out');
              addText.textContent = 'Sold Out';
            }
          })
          .catch(() => {});
      }
    }

    addBtn?.addEventListener('click', () => {
      if (!addText || addBtn.disabled) return;
      const size = document.querySelector<HTMLElement>('.sz-btn.active')?.textContent?.trim() ?? '';
      if (!size) return;
      let product: Record<string, string>;
      try { product = JSON.parse(addBtn.dataset.product ?? '{}'); } catch { return; }
      window.dispatchEvent(new CustomEvent('vh:add-to-cart', { detail: { ...product, size } }));
      gsap.timeline()
        .to(addText,  { opacity: 0, duration: 0.15, ease: 'power2.in' })
        .set(addText, { textContent: 'Added ✓' })
        .to(addText,  { opacity: 1, duration: 0.2,  ease: 'power2.out' })
        .to(addText,  { opacity: 0, duration: 0.15, delay: 1.5, ease: 'power2.in' })
        .set(addText, { textContent: 'Add to Selection' })
        .to(addText,  { opacity: 1, duration: 0.2,  ease: 'power2.out' });
    });
  });
});
</script>

<style>
/* Layout */
.pdp-layout {
  display: flex;
  flex-direction: column;
  padding-top: var(--nav-h);
}
@media (min-width: 768px) {
  .pdp-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100svh;
    align-items: start;
  }
}

.pdp-images {
  display: flex;
  flex-direction: column;
  gap: 1px;
  background: var(--color-rule);
}
@media (min-width: 768px) {
  .pdp-images {
    position: sticky;
    top: var(--nav-h);
    height: calc(100svh - var(--nav-h));
    overflow-y: auto;
    scrollbar-width: none;
    background: none;
  }
  .pdp-images::-webkit-scrollbar { display: none; }
}

.pdp-info {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xl);
  padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-4xl);
}
@media (min-width: 768px) {
  .pdp-info {
    padding: var(--spacing-4xl) var(--spacing-3xl);
    position: sticky;
    top: var(--nav-h);
    height: calc(100svh - var(--nav-h));
    overflow-y: auto;
    scrollbar-width: none;
  }
  .pdp-info::-webkit-scrollbar { display: none; }
}
@media (min-width: 1280px) { .pdp-info { padding-inline: var(--spacing-4xl); } }

/* Elements */
.pdp-img img { object-position: center top; }
.pdp-name  { font-size: clamp(2.25rem, 5.5vw, 4.5rem); letter-spacing: -0.04em; line-height: 1; }
.pdp-price { font-size: clamp(1.75rem, 3vw, 2.5rem); }

.pdp-desc {
  font-size: var(--text-lg);
  line-height: 1.8;
  color: var(--color-ink-soft);
  max-width: 36ch;
}

.pdp-details { border-top: 1px solid var(--color-rule); }
.detail-row {
  display: flex; justify-content: space-between; align-items: center;
  padding-block: 0.875rem; border-bottom: 1px solid var(--color-rule);
  gap: var(--spacing-md);
}
.detail-val { color: var(--color-ink-soft); text-align: right; text-transform: none; letter-spacing: 0; }

.price-row {
  display: flex; align-items: baseline; justify-content: space-between;
  padding-block: 1rem;
  border-top: 1px solid var(--color-rule);
  border-bottom: 1px solid var(--color-rule);
}

.sz-btn {
  background: none; border: 1px solid var(--color-rule);
  color: var(--color-soft); padding: var(--spacing-xs) 0.875rem;
  min-height: 44px;
  transition: border-color var(--duration-fast), color var(--duration-fast);
}
.sz-btn:hover  { border-color: var(--color-mid); color: var(--color-ink); }
.sz-btn.active { border-color: var(--color-ink); color: var(--color-ink); }

.sold-out { opacity: 0.4; cursor: not-allowed; border-color: var(--color-rule); }
.sold-out:hover { background: none; }
</style>
