---
import Layout from '@layouts/Layout.astro';
import { Picture } from 'astro:assets';
import { PRODUCTS, SHARED_DETAILS } from '@data/products';
import SizeGuide from '@components/SizeGuide.svelte';
import { IMAGES } from '@assets/images';

export function getStaticPaths() {
  return PRODUCTS.map(p => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product: p } = Astro.props;

const details: [string, string][] = [
  ['Material', p.material],
  ['Origin',   p.origin],
  ...SHARED_DETAILS,
];

const idx  = PRODUCTS.findIndex(x => x.slug === p.slug);
const prev = PRODUCTS[idx - 1] ?? null;
const next = PRODUCTS[idx + 1] ?? null;
---

<Layout title={p.name} description={p.desc} type="product" solidNav={true}>

  <div class="pdp">

    <!-- Images -->
    <div class="pdp-images">
      <div class="img-wrap img-primary">
        <Picture
          class="pdp-img js-main-img"
          src={IMAGES[p.img]}
          formats={['avif', 'webp']}
          alt={p.name}
          fetchpriority="high"
          decoding="async"
          width={1200}
        />
      </div>
      {p.img2 && (
        <div class="img-wrap img-secondary" aria-hidden="true">
          <Picture
            class="pdp-img"
            src={IMAGES[p.img2]}
            formats={['avif', 'webp']}
            alt=""
            loading="lazy"
            decoding="async"
            width={900}
          />
        </div>
      )}
    </div>

    <!-- Info panel -->
    <div class="pdp-info">

      <div class="info-top">
        <a href="/collection" class="label muted-link">← Collection</a>
        <span class="label op-30">{p.num}</span>
      </div>

      <h1 class="pdp-name">{p.name}</h1>

      <p class="pdp-desc">{p.desc}</p>

      <dl class="details">
        {details.map(([k, v]) => (
          <div class="detail-row">
            <dt class="label detail-key">{k}</dt>
            <dd class="label detail-val">{v}</dd>
          </div>
        ))}
      </dl>

      <div class="sizes">
        <div class="sizes-head">
          <span class="label muted">Size</span>
          <SizeGuide category={p.category} client:load />
        </div>
        <div class="size-row" role="group" aria-label="Select size">
          {p.sizes.map((s, i) => (
            <button
              class:list={['sz-btn', 'label', { active: i === 1 }]}
              type="button"
              aria-pressed={i === 1}
            >{s}</button>
          ))}
        </div>
      </div>

      <div class="cta-block">
        <div class="price-row">
          <span class="pdp-price serif">€ {p.price.toLocaleString('en-US')}</span>
          <span class="label muted">Incl. VAT</span>
        </div>
        <button
          class="add-btn"
          id="js-add"
          type="button"
          data-product={JSON.stringify({ slug: p.slug, name: p.name, price: p.price.toLocaleString('en-US'), img: IMAGES[p.img].src, num: p.num })}
        >
          <span class="label add-text">Add to Selection</span>
        </button>
        <span class="label ship-note">Complimentary worldwide shipping</span>
      </div>

    </div>
  </div>

  <!-- Prev / next nav -->
  <nav class="pdp-nav wrap" aria-label="Product navigation">
    <div class="rule"></div>
    <div class="pdp-nav-inner">
      {prev
        ? <a href={`/product/${prev.slug}`} class="label muted-link">← {prev.name}</a>
        : <a href="/collection"             class="label muted-link">← Collection</a>}
      {next
        ? <a href={`/product/${next.slug}`} class="label muted-link">{next.name} →</a>
        : <a href="/collection"             class="label muted-link">Collection →</a>}
    </div>
    <div class="rule"></div>
  </nav>

</Layout>

<script>
import { onReady, gsap, DUR, EASE } from '@lib/animate';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    const morphed = document.documentElement.hasAttribute('data-astro-transition');

    // Hero image entrance
    const img = document.querySelector<HTMLElement>('.js-main-img');
    if (img) {
      if (morphed) gsap.set(img, { opacity: 1, scale: 1 });
      else gsap.fromTo(img, { opacity: 0, scale: 1.04 }, { opacity: 1, scale: 1, duration: DUR.slower, ease: 'power3.out' });
    }

    // Info panel stagger
    const infoEls = ['.info-top', '.pdp-name', '.pdp-desc', '.details', '.sizes', '.cta-block']
      .map(s => document.querySelector<HTMLElement>(s)).filter(Boolean) as HTMLElement[];
    gsap.fromTo(infoEls,
      { opacity: 0, y: 16 },
      { opacity: 1, y: 0, duration: DUR.slow, ease: EASE, stagger: 0.07, delay: morphed ? 0 : 0.2, clearProps: 'transform,will-change' },
    );

    // Size selection
    const szBtns = document.querySelectorAll<HTMLButtonElement>('.sz-btn');
    szBtns.forEach(btn => btn.addEventListener('click', () => {
      szBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
    }));

    // Add to cart
    const addBtn  = document.getElementById('js-add') as HTMLButtonElement | null;
    const addText = addBtn?.querySelector<HTMLElement>('.add-text');
    addBtn?.addEventListener('click', () => {
      if (!addText) return;
      const size = document.querySelector<HTMLElement>('.sz-btn.active')?.textContent?.trim() ?? '';
      if (!size) return;
      let product: Record<string, string>;
      try { product = JSON.parse(addBtn.dataset.product ?? '{}'); } catch { return; }
      window.dispatchEvent(new CustomEvent('vh:add-to-cart', { detail: { ...product, size } }));
      gsap.timeline()
        .to(addText,  { opacity: 0, duration: 0.15, ease: 'power2.in' })
        .set(addText, { textContent: 'Added ✓' })
        .to(addText,  { opacity: 1, duration: 0.2,  ease: 'power2.out' })
        .to(addText,  { opacity: 0, duration: 0.15, delay: 1.5, ease: 'power2.in' })
        .set(addText, { textContent: 'Add to Selection' })
        .to(addText,  { opacity: 1, duration: 0.2,  ease: 'power2.out' });
    });
  });
});
</script>

<style>
/* ── Layout ── */
.pdp {
  display: flex;
  flex-direction: column;
  padding-top: var(--nav-h);
}
@media (min-width: 768px) {
  .pdp {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100svh;
    align-items: start;
  }
}

/* ── Images ── */
.pdp-images {
  display: flex;
  flex-direction: column;
  gap: 1px;
  background: var(--color-rule);
}
@media (min-width: 768px) {
  .pdp-images {
    position: sticky;
    top: var(--nav-h);
    height: calc(100svh - var(--nav-h));
    overflow-y: auto;
    scrollbar-width: none;
    background: none;
  }
  .pdp-images::-webkit-scrollbar { display: none; }
}

.img-wrap { overflow: hidden; background: var(--color-off); }

.img-primary { aspect-ratio: 3/4; }
@media (min-width: 768px) { .img-primary { aspect-ratio: unset; min-height: 100%; } }

@media (min-width: 768px) { .img-secondary { flex: 1; min-height: 60vh; } }

.pdp-img img { object-position: center top; }

/* ── Info panel ── */
.pdp-info {
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
  padding: var(--space-xl) var(--space-lg) var(--space-4xl);
}
@media (min-width: 768px) {
  .pdp-info {
    padding: var(--space-4xl) var(--space-3xl);
    position: sticky;
    top: var(--nav-h);
    height: calc(100svh - var(--nav-h));
    overflow-y: auto;
    scrollbar-width: none;
  }
  .pdp-info::-webkit-scrollbar { display: none; }
}
@media (min-width: 1280px) { .pdp-info { padding-inline: var(--space-4xl); } }

.info-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pdp-name {
  font-size: clamp(2.25rem, 5.5vw, 4.5rem);
  font-variation-settings: var(--font-weight-light);
  letter-spacing: -0.04em;
  line-height: 1;
}

.pdp-desc {
  font-size: var(--text-lg);
  font-variation-settings: var(--font-weight-normal);
  line-height: 1.8;
  color: var(--color-ink-soft);
  max-width: 36ch;
}

/* ── Details table ── */
.details { border-top: 1px solid var(--color-rule); }
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-block: 0.875rem;
  border-bottom: 1px solid var(--color-rule);
  gap: var(--space-md);
}
.detail-key { opacity: var(--opacity-muted); flex-shrink: 0; }
.detail-val { color: var(--color-ink-soft); text-align: right; text-transform: none; letter-spacing: 0; }

/* ── Sizes ── */
.sizes { display: flex; flex-direction: column; gap: 0.875rem; }
.sizes-head { display: flex; align-items: center; justify-content: space-between; }
.size-row   { display: flex; flex-wrap: wrap; gap: 0.4rem; }

.sz-btn {
  background: none;
  border: 1px solid var(--color-rule);
  color: var(--color-soft);
  padding: var(--space-xs) 0.875rem;
  transition: border-color var(--duration-fast), color var(--duration-fast);
}
.sz-btn:hover  { border-color: var(--color-mid); color: var(--color-ink); }
.sz-btn.active { border-color: var(--color-ink); color: var(--color-ink); }

/* ── CTA ── */
.cta-block { display: flex; flex-direction: column; gap: var(--space-md); }

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-block: 1rem;
  border-top: 1px solid var(--color-rule);
  border-bottom: 1px solid var(--color-rule);
}

.pdp-price {
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-style: italic;
  font-variation-settings: var(--font-weight-medium);
  letter-spacing: -0.02em;
}

.add-btn {
  width: 100%;
  background: none;
  border: 1px solid var(--color-ink);
  padding: 1.25rem 1.5rem;
  transition: background var(--duration-base), color var(--duration-base);
}
.add-btn:hover { background: var(--color-ink); }
.add-btn:hover .add-text { color: var(--color-white); }

.add-text {
  display: block;
  text-align: center;
  color: var(--color-ink);
  letter-spacing: var(--letter-spacing-button);
  transition: color var(--duration-base);
}

.ship-note { opacity: var(--opacity-disabled); display: block; text-align: center; }

/* ── Prev/next nav ── */
.pdp-nav { padding-block: 2.5rem; }
.pdp-nav-inner {
  display: flex;
  justify-content: space-between;
  padding-block: 1.5rem;
}
</style>
