---
import Layout from '../../layouts/Layout.astro';
import { Picture, getImage } from 'astro:assets';
import { PRODUCTS, SHARED_DETAILS } from '../../data/products';
import SizeGuide from '../../components/SizeGuide.svelte';
import { IMAGES } from '../../assets/images';

export function getStaticPaths() {
  return PRODUCTS.map(p => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product: p } = Astro.props;

const details: [string, string][] = [
  ['Material', p.material],
  ['Origin',   p.origin],
  ...SHARED_DETAILS,
];

// Resolve optimised cart thumbnail URL at build time
const cartImg = await getImage({ src: IMAGES[p.img], width: 200, height: 267, format: 'webp' });
---

<Layout title={p.name} description={p.desc} type="product" solidNav={true}>
  <div class="product-page">

    <!-- Sticky image (desktop) / stacked (mobile) -->
    <div class="product-images">
      <div class="img-primary">
        <Picture
          class="product-img js-main-img"
          src={IMAGES[p.img]}
          formats={['avif', 'webp']}
          alt={p.name}
          fetchpriority="high"
          decoding="async"
          width={1200}
          transition:name={`product-img-${p.slug}`}
        />
      </div>
      <div class="img-secondary" aria-hidden="true">
        <Picture
          class="product-img"
          src={IMAGES[p.img2]}
          formats={['avif', 'webp']}
          alt=""
          loading="lazy"
          decoding="async"
          width={900}
        />
      </div>
    </div>

    <!-- Info panel -->
    <div class="product-info">
      <div class="info-top" data-anim="hero" data-delay="0">
        <a href="/collection" class="label muted-link">← Collection</a>
        <span class="label op-30">{p.num}</span>
      </div>

      <h1 class="product-name" data-anim="hero" data-delay="0.15">
        {p.name}
      </h1>

      <p class="product-desc" data-anim="scroll">{p.desc}</p>

      <dl class="details" data-anim="scroll">
        {details.map(([k, v]) => (
          <div class="detail-row">
            <dt class="label detail-key">{k}</dt>
            <dd class="label detail-val">{v}</dd>
          </div>
        ))}
      </dl>

      <div class="sizes" data-anim="scroll">
        <div class="sizes-header">
          <span class="label sizes-lbl">Size</span>
          <SizeGuide category={p.category} client:load />
        </div>
        <div class="size-row" role="group" aria-label="Select size">
          {p.sizes.map((s, i) => (
            <button
              class:list={['sz-btn', 'label', { active: i === 1 }]}
              type="button"
              aria-pressed={i === 1}
            >
              {s}
            </button>
          ))}
        </div>
      </div>

      <div class="cta-block" data-anim="scroll">
        <div class="price-row">
          <span class="product-price serif">€ {p.price}</span>
          <span class="label muted">Incl. VAT</span>
        </div>
        <button
          class="add-btn"
          id="js-add"
          type="button"
          data-product={JSON.stringify({ slug: p.slug, name: p.name, price: p.price, img: cartImg.src, num: p.num })}
        >
          <span class="label add-text">Add to Selection</span>
        </button>
        <span class="label ship-note">Complimentary worldwide shipping</span>
      </div>
    </div>
  </div>

  <div class="p-nav wrap">
    <div class="rule"></div>
    <div class="p-nav-inner">
      <a href="/collection" class="label muted-link">← All pieces</a>
      <a href="/collection" class="label muted-link">Next →</a>
    </div>
    <div class="rule"></div>
  </div>
</Layout>

<script>
import { onReady, reveal, imageEntrance } from '../../lib/animate';
import { initToggleGroup } from '../../lib/toggle';
import gsap from 'gsap';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    imageEntrance('.js-main-img');
    reveal();

    const szBtns = document.querySelectorAll<HTMLElement>('.sz-btn');
    initToggleGroup('.sz-btn', btn => {
      szBtns.forEach(b => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
    });

    const addBtn  = document.getElementById('js-add') as HTMLButtonElement | null;
    const addText = addBtn?.querySelector<HTMLElement>('.add-text');

    addBtn?.addEventListener('click', () => {
      if (!addText) return;
      const product = JSON.parse(addBtn.dataset.product ?? '{}');
      const size    = document.querySelector<HTMLElement>('.sz-btn.active')?.textContent?.trim() ?? '';
      window.dispatchEvent(new CustomEvent('vh:add-to-cart', { detail: { ...product, size } }));
      gsap.timeline()
        .to(addText,  { opacity: 0, duration: 0.14, ease: 'power2.in' })
        .set(addText, { textContent: 'Added ✓' })
        .to(addText,  { opacity: 1, duration: 0.22, ease: 'power2.out' })
        .to(addText,  { opacity: 0, duration: 0.14, delay: 1.8, ease: 'power2.in' })
        .set(addText, { textContent: 'Add to Selection' })
        .to(addText,  { opacity: 1, duration: 0.2, ease: 'power2.out' });
    });
  });
});
</script>

<style>
.product-page {
  display: flex;
  flex-direction: column;
}
@media (min-width: 768px) {
  .product-page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: calc(100svh - var(--nav-h));
    align-items: start;
    padding-top: var(--nav-h);
  }
}

/* Images */
.product-images {
  display: flex;
  flex-direction: column;
  gap: 1px;
  background: var(--color-rule);
}
@media (min-width: 768px) {
  .product-images {
    position: sticky;
    top: var(--nav-h);
    height: calc(100svh - var(--nav-h));
    overflow: hidden;
    background: none;
    gap: 0;
  }
}

.img-primary {
  aspect-ratio: 3/4;
  overflow: hidden;
  background: var(--color-off);
}
@media (min-width: 768px) { .img-primary { aspect-ratio: unset; height: 100%; } }

.img-secondary {
  aspect-ratio: 3/2;
  overflow: hidden;
  background: var(--color-paper);
}
@media (min-width: 768px) { .img-secondary { display: none; } }

.product-img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center top;
  display: block;
}

/* Info */
.product-info {
  padding: 2.5rem 1.5rem 5rem;
  display: flex;
  flex-direction: column;
  gap: 2.25rem;
}
@media (min-width: 768px) {
  .product-info {
    padding: 4rem 4rem 5rem;
    position: sticky;
    top: var(--nav-h);
    height: calc(100svh - var(--nav-h));
    overflow-y: auto;
    scrollbar-width: none;
    justify-content: center;
  }
  .product-info::-webkit-scrollbar { display: none; }
}
@media (min-width: 1280px) { .product-info { padding: 4rem 6rem 5rem; } }

.info-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-name {
  display: block;
  font-family: var(--font-sans);
  font-size: clamp(1.75rem, 4.5vw, 3.25rem);
  font-variation-settings: 'wght' 300;
  letter-spacing: -0.03em;
  line-height: 1.05;
  color: var(--color-ink);
}

.product-desc {
  font-size: 0.875rem;
  font-variation-settings: 'wght' 300;
  line-height: 1.85;
  color: var(--color-soft);
  max-width: 36ch;
}

.details { border-top: 1px solid var(--color-rule); }
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-block: 0.875rem;
  border-bottom: 1px solid var(--color-rule);
  gap: 1rem;
}
.detail-key { opacity: 0.4; flex-shrink: 0; }
.detail-val { color: var(--color-ink-soft); text-align: right; text-transform: none; letter-spacing: 0.02em; }

.sizes { display: flex; flex-direction: column; gap: 0.875rem; }
.sizes-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sizes-lbl { opacity: 0.4; }
.size-row { display: flex; flex-wrap: wrap; gap: 0.4rem; }

.sz-btn {
  background: none;
  border: 1px solid var(--color-rule);
  color: var(--color-soft);
  padding: 0.5rem 0.875rem;
  transition: border-color 0.2s, color 0.2s;
}
.sz-btn:hover  { border-color: var(--color-mid); color: var(--color-ink); }
.sz-btn.active { border-color: var(--color-ink); color: var(--color-ink); }

.cta-block { display: flex; flex-direction: column; gap: 1rem; }

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-block: 1rem;
  border-top: 1px solid var(--color-rule);
  border-bottom: 1px solid var(--color-rule);
}
.product-price {
  font-size: 1.75rem;
  font-style: italic;
  font-variation-settings: 'wght' 400;
  letter-spacing: -0.01em;
  color: var(--color-ink);
}

.add-btn {
  width: 100%;
  background: var(--color-ink);
  border: none;
  padding: 1.125rem 1.5rem;
  transition: background 0.2s;
}
.add-btn:hover { background: var(--color-ink-soft); }
.add-text {
  color: var(--color-white);
  letter-spacing: 0.2em;
  display: block;
  text-align: center;
}

.ship-note { opacity: 0.35; display: block; text-align: center; }

.p-nav { padding-block: 2.5rem; }
.p-nav-inner {
  display: flex;
  justify-content: space-between;
  padding-block: 1.5rem;
}
</style>
