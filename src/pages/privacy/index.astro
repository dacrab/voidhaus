  {
    title: '7. Security',
    body: 'All data transmitted to and from this site is encrypted via TLS. We implement industry-standard security measures and review them regularly.',
  },
  {
    title: '8. Changes',
    body: 'We may update this policy periodically. Material changes will be communicated via email where we hold your contact details. Continued use of the site constitutes acceptance.',
  },
  {
    title: '9. Contact',
    body: 'For privacy-related enquiries: studio@voidhaus.com · Voidhaus S.r.l., Via della Spiga 19, 20121 Milan, Italy.',
  },
];
---

<LegalPage
  title="Privacy Policy"
  description="How Voidhaus collects and uses your data."
  updated="March 2026"
  sibling={{ href: '/terms', label: 'Terms & Conditions' }}
  {sections}
/>
