---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Privacy Policy — VOIDHAUS" description="How Voidhaus collects and uses your data.">
  <div class="legal-page wrap">

    <div class="legal-header page-top-spacing">
      <div class="lh-inner">
        <span class="label muted">Legal</span>
        <h1 class="legal-title" data-anim="hero" data-delay="0.1">Privacy Policy</h1>
      </div>
      <div class="rule"></div>
      <p class="legal-meta label muted">Last updated: March 2026</p>
    </div>

    <div class="legal-body">

      <div class="legal-nav">
        <a href="/terms" class="label legal-sibling muted">Terms & Conditions →</a>
        <a href="/stockists" class="label legal-sibling muted">Stockists →</a>
      </div>

      {[
        {
          title: '1. Who We Are',
          body: 'Voidhaus is a luxury fashion house operating under Voidhaus S.r.l., Via della Spiga 19, 20121 Milan, Italy. This Privacy Policy explains how we collect, use, and protect your personal data when you interact with our website or services.',
        },
        {
          title: '2. Data We Collect',
          body: 'We collect information you provide directly — including your name, email address, and correspondence when you contact us. We also collect anonymous usage data (page views, session duration) via privacy-respecting analytics. We do not sell your data to third parties.',
        },
        {
          title: '3. How We Use Your Data',
          body: 'We use your data to respond to enquiries, process selections, send order updates (where applicable), and improve our services. We will only contact you for marketing purposes if you have explicitly opted in.',
        },
        {
          title: '4. Cookies',
          body: 'This site uses minimal, strictly necessary cookies — for session management and cart persistence (localStorage). We do not use tracking cookies or third-party advertising networks.',
        },
        {
          title: '5. Data Retention',
          body: 'Contact enquiry data is retained for 24 months. Cart data is stored locally in your browser and is never transmitted to our servers unless you complete a purchase.',
        },
        {
          title: '6. Your Rights',
          body: 'Under GDPR, you have the right to access, correct, or delete your personal data. To exercise these rights, contact us at studio@voidhaus.com. We will respond within 30 days.',
        },
        {
          title: '7. Security',
          body: 'All data transmitted to and from this site is encrypted via TLS. We implement industry-standard security measures and review them regularly.',
        },
        {
          title: '8. Changes',
          body: 'We may update this policy periodically. Material changes will be communicated via email where we hold your contact details. Continued use of the site constitutes acceptance.',
        },
        {
          title: '9. Contact',
          body: 'For privacy-related enquiries: studio@voidhaus.com · Voidhaus S.r.l., Via della Spiga 19, 20121 Milan, Italy.',
        },
      ].map(s => (
        <div class="legal-section" data-anim="scroll">
          <h2 class="legal-section-title">{s.title}</h2>
          <p class="legal-section-body">{s.body}</p>
        </div>
      ))}

    </div>
  </div>
</Layout>

<script>
import { onReady, revealHero, revealOnScroll } from '../../lib/animate';
onReady(() => { revealHero(); revealOnScroll(); });
</script>

<style>
  .legal-page { padding-bottom: 6rem; }

  .legal-header { padding-bottom: 0; }

  .lh-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 1.5rem;
  }

  .legal-title {
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 5vw, 4rem);
    font-variation-settings: 'wght' 200;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-ink);
  }

  .legal-meta { padding-block: 1.25rem; }

  .legal-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    padding-top: 1rem;
  }
  @media (min-width: 900px) {
    .legal-body {
      grid-template-columns: 200px 1fr;
    }
  }

  .legal-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-block: 3rem 2rem;
    border-bottom: 1px solid var(--color-rule);
    grid-column: 1 / -1;
  }

  .legal-sibling {
    transition: opacity 0.2s;
  }
  .legal-sibling:hover { opacity: 1 !important; }

  .legal-section {
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--color-rule);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    grid-column: 1 / -1;
  }
  @media (min-width: 900px) {
    .legal-section {
      grid-template-columns: 200px 1fr;
      gap: 3rem;
      grid-column: 1 / -1;
    }
  }

  .legal-section-title {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-variation-settings: 'wght' 400;
    color: var(--color-ink);
    letter-spacing: 0.01em;
  }

  .legal-section-body {
    font-size: 0.875rem;
    font-variation-settings: 'wght' 300;
    line-height: 1.9;
    color: var(--color-soft);
    max-width: 62ch;
  }
</style>
