---
import Layout from '@layouts/Layout.astro';
import { SITE } from '@data/site';

const subjects = ['General', 'Order', 'Press', 'Stockist'] as const;

const info = [
  { key: 'Studio',  lines: SITE.address },
  { key: 'General', lines: [SITE.email.studio] },
  { key: 'Press',   lines: [SITE.email.press] },
  { key: 'Hours',   lines: [SITE.hours] },
] as const;
---

<Layout title="Contact" solidNav={true}>

  <header class="wrap pt-[calc(var(--nav-h)+var(--space-2xl))] pb-[var(--space-2xl)]">
    <div class="rule js-rule"></div>
    <div class="pt-[var(--space-lg)]">
      <span class="label muted" data-anim="hero">Contact</span>
      <h1 class="contact-title mt-[var(--space-xs)]" data-anim="hero" data-delay="0.1" style="font-variation-settings:var(--font-weight-light)">Let's speak.</h1>
    </div>
  </header>

  <div class="wrap grid grid-cols-1 gap-[var(--space-3xl)] pb-[var(--space-4xl)] min-[900px]:grid-cols-[1fr_300px] min-[900px]:gap-[var(--space-4xl)] min-[900px]:items-start min-[1280px]:grid-cols-[1fr_340px]">

    <form class="flex flex-col gap-[var(--space-xl)]" id="js-form" novalidate data-anim="scroll">
      <span class="label muted block mb-[var(--space-xl)]">Message</span>

      <div class="grid grid-cols-1 gap-[var(--space-xl)] min-[480px]:grid-cols-2">
        <div class="flex flex-col gap-[0.65rem]">
          <label class="label muted" for="name">Name</label>
          <input class="field-inp" type="text" id="name" name="name" placeholder="Your name" autocomplete="name" required />
        </div>
        <div class="flex flex-col gap-[0.65rem]">
          <label class="label muted" for="email">Email</label>
          <input class="field-inp" type="email" id="email" name="email" placeholder="your@email.com" autocomplete="email" required />
        </div>
      </div>

      <fieldset class="border-none p-0 flex flex-col gap-[0.65rem]">
        <legend class="label muted">Subject</legend>
        <div class="flex flex-wrap gap-[0.4rem]">
          {subjects.map((s, i) => (
            <button type="button" class:list={['chip', 'label', { active: i === 0 }]} data-subject={s}>{s}</button>
          ))}
        </div>
        <input type="hidden" id="js-subject" name="subject" value={subjects[0]} />
      </fieldset>

      <div class="flex flex-col gap-[0.65rem]">
        <label class="label muted" for="msg">Message</label>
        <textarea class="field-inp resize-none" id="msg" name="message" placeholder="Write here…" rows="5"></textarea>
      </div>

      <button class="flex items-center justify-between bg-transparent border border-[var(--color-ink)] text-[var(--color-ink)] px-5 py-[var(--space-md)] w-full transition-[background,color] duration-[var(--duration-fast)] hover:bg-[var(--color-ink)] hover:text-[var(--color-white)]" id="js-submit" type="submit">
        <span class="label submit-text">Send Message</span>
        <span aria-hidden="true">→</span>
      </button>
    </form>

    <aside data-anim="scroll">
      <span class="label muted block mb-[var(--space-xl)]">Information</span>
      <dl class="border-t border-[var(--color-rule)]">
        {info.map(({ key, lines }) => (
          <div class="grid grid-cols-[4.5rem_1fr] gap-[var(--space-md)] py-[1.125rem] border-b border-[var(--color-rule)] items-start">
            <dt class="label op-35">{key}</dt>
            <dd class="flex flex-col gap-[0.15rem]">
              {lines.map(l => <span class="text-[var(--text-sm)] text-[var(--color-ink-soft)] leading-[1.6]" style="font-variation-settings:var(--font-weight-normal)">{l}</span>)}
            </dd>
          </div>
        ))}
      </dl>
    </aside>

  </div>

</Layout>

<script>
import { initPage, onReady, gsap } from '@lib/animate';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    initPage('.js-rule');

    const chips   = document.querySelectorAll<HTMLElement>('.chip');
    const subject = document.getElementById('js-subject') as HTMLInputElement | null;
    chips.forEach(chip => chip.addEventListener('click', () => {
      chips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      if (subject) subject.value = chip.dataset.subject ?? '';
    }));

    document.getElementById('js-form')?.addEventListener('submit', e => {
      e.preventDefault();
      const form  = e.target as HTMLFormElement;
      const name  = form.querySelector<HTMLInputElement>('#name');
      const email = form.querySelector<HTMLInputElement>('#email');
      if (!name?.value.trim() || !email?.value.includes('@')) return;
      const text = document.querySelector<HTMLElement>('.submit-text');
      if (!text) return;
      gsap.timeline()
        .to('#js-submit', { opacity: 0.4, duration: 0.15, ease: 'power2.in' })
        .set(text, { textContent: 'Sent ✓' })
        .to('#js-submit', { opacity: 1, duration: 0.2, ease: 'power2.out' });
    });
  });
});
</script>

<style>
.contact-title { font-size: clamp(2.5rem, 8vw, 7rem); letter-spacing: -0.04em; line-height: 1; }
.field-inp {
  background: none; border: none; border-bottom: 1px solid var(--color-rule);
  color: var(--color-ink); font-family: var(--font-sans);
  font-variation-settings: var(--font-weight-normal);
  font-size: max(16px, 0.875rem); padding-block: 0.75rem;
  outline: none; width: 100%;
  transition: border-bottom-color var(--duration-fast);
}
.field-inp:focus        { border-bottom-color: var(--color-mid); }
.field-inp::placeholder { color: var(--color-mid); }
.chip {
  background: none; border: 1px solid var(--color-rule);
  color: var(--color-soft); padding: 0.45rem 1rem;
  transition: border-color var(--duration-fast), color var(--duration-fast);
}
.chip:hover  { border-color: var(--color-mid); color: var(--color-ink); }
.chip.active { border-color: var(--color-ink); color: var(--color-ink); }
</style>
