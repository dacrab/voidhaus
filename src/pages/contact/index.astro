---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/PageHeader.astro';
import { SITE } from '@data/site';

const subjects = ['General', 'Order', 'Press', 'Stockist'] as const;

const info = [
  { key: 'Studio',  lines: SITE.address },
  { key: 'General', lines: [SITE.email.studio] },
  { key: 'Press',   lines: [SITE.email.press] },
  { key: 'Hours',   lines: [SITE.hours] },
] as const;
---

<Layout title="Contact" solidNav={true}>
  <PageHeader label="Contact" title="Let's speak." />

  <div class="contact-body wrap">

    <form class="contact-form" id="js-form" novalidate data-anim="scroll">
      <span class="label muted form-lbl">Message</span>

      <div class="field-row">
        <div class="field">
          <label class="label muted field-label" for="name">Name</label>
          <input class="field-inp" type="text" id="name" name="name"
            placeholder="Your name" autocomplete="name" required />
        </div>
        <div class="field">
          <label class="label muted field-label" for="email">Email</label>
          <input class="field-inp" type="email" id="email" name="email"
            placeholder="your@email.com" autocomplete="email" required />
        </div>
      </div>

      <fieldset class="field subject-field">
        <legend class="label muted">Subject</legend>
        <div class="chips">
          {subjects.map((s, i) => (
            <button type="button" class:list={['chip', 'label', { active: i === 0 }]}
              data-subject={s}>
              {s}
            </button>
          ))}
        </div>
        <input type="hidden" id="js-subject" name="subject" value={subjects[0]} />
      </fieldset>

      <div class="field">
        <label class="label muted field-label" for="msg">Message</label>
        <textarea class="field-inp field-ta" id="msg" name="message"
          placeholder="Write here…" rows="5"></textarea>
      </div>

      <button class="submit-btn" id="js-submit" type="submit">
        <span class="label submit-text">Send Message</span>
        <span aria-hidden="true">→</span>
      </button>
    </form>

    <aside class="contact-info" data-anim="scroll">
      <span class="label muted form-lbl">Information</span>
      <dl class="info-list">
        {info.map(({ key, lines }) => (
          <div class="info-row">
            <dt class="label op-35 info-key">{key}</dt>
            <dd class="info-vals">
              {lines.map(l => <span class="info-val">{l}</span>)}
            </dd>
          </div>
        ))}
      </dl>
    </aside>

  </div>
</Layout>

<script>
import { initPage, onReady, gsap } from '@lib/animate';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    initPage('.ph .rule');

    const chips = document.querySelectorAll<HTMLElement>('.chip');
    const subject = document.getElementById('js-subject') as HTMLInputElement | null;
    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        chips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        if (subject) subject.value = chip.dataset.subject ?? '';
      });
    });

    document.getElementById('js-form')?.addEventListener('submit', e => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const name = form.querySelector<HTMLInputElement>('#name');
      const email = form.querySelector<HTMLInputElement>('#email');
      if (!name?.value.trim() || !email?.value.includes('@')) return;
      const text = document.querySelector<HTMLElement>('.submit-text');
      if (!text) return;
      gsap.timeline()
        .to('#js-submit', { opacity: 0.4, duration: 0.15, ease: 'power2.in' })
        .set(text, { textContent: 'Sent ✓' })
        .to('#js-submit', { opacity: 1, duration: 0.2, ease: 'power2.out' });
    });
  });
});
</script>

<style>
.contact-body {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-3xl);
  padding-bottom: var(--space-4xl);
}
@media (min-width: 900px) {
  .contact-body { grid-template-columns: 1fr 300px; gap: var(--space-4xl); align-items: start; }
}
@media (min-width: 1280px) { .contact-body { grid-template-columns: 1fr 340px; } }

.form-lbl { display: block; margin-bottom: var(--space-xl); }

.contact-form { display: flex; flex-direction: column; gap: var(--space-xl); }

.field-row {
  display: grid; grid-template-columns: 1fr; gap: var(--space-xl);
}
@media (min-width: 480px) { .field-row { grid-template-columns: 1fr 1fr; } }

.field { display: flex; flex-direction: column; gap: 0.65rem; }
.field-inp {
  background: none; border: none;
  border-bottom: 1px solid var(--color-rule);
  color: var(--color-ink);
  font-family: var(--font-sans);
  font-variation-settings: var(--font-weight-normal);
  font-size: max(16px, 0.875rem);
  padding-block: 0.75rem;
  outline: none; width: 100%;
  transition: border-bottom-color var(--duration-fast);
}
.field-inp:focus { border-bottom-color: var(--color-mid); }
.field-inp::placeholder { color: var(--color-mid); }
.field-ta { resize: none; }

.subject-field { border: none; padding: 0; display: flex; flex-direction: column; gap: 0.65rem; }
.chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.chip {
  background: none; border: 1px solid var(--color-rule);
  color: var(--color-soft); padding: 0.45rem 1rem;
  transition: border-color var(--duration-fast), color var(--duration-fast);
}
.chip:hover  { border-color: var(--color-mid); color: var(--color-ink); }
.chip.active { border-color: var(--color-ink); color: var(--color-ink); }

.submit-btn {
  display: flex; align-items: center; justify-content: space-between;
  background: none; border: 1px solid var(--color-ink);
  color: var(--color-ink); padding: var(--space-md) 1.25rem;
  width: 100%; transition: background var(--duration-fast), color var(--duration-fast);
}
.submit-btn:hover { background: var(--color-ink); color: var(--color-white); }

.info-list { border-top: 1px solid var(--color-rule); }
.info-row {
  display: grid; grid-template-columns: 4.5rem 1fr;
  gap: var(--space-md); padding-block: 1.125rem;
  border-bottom: 1px solid var(--color-rule); align-items: start;
}
.info-vals { display: flex; flex-direction: column; gap: 0.15rem; }
.info-val {
  font-size: var(--text-sm); font-variation-settings: var(--font-weight-normal);
  color: var(--color-ink-soft); line-height: 1.6;
}
</style>
