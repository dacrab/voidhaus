---
import Layout from '@layouts/Layout.astro';
import { Picture } from 'astro:assets';
import ProductCard from '@components/ProductCard.astro';
import CTAStrip from '@components/CTAStrip.astro';
import { PRODUCTS } from '@data/products';
import { SITE } from '@data/site';
import { IMAGES } from '@assets/images';

const chapters = [
  {
    num:      '01',
    title:    'Weight',
    sub:      'On the architecture of outerwear',
    img:      IMAGES['coat-primary'],
    products: PRODUCTS.filter(p => p.category === 'Outerwear'),
  },
  {
    num:      '02',
    title:    'Structure',
    sub:      'Tailoring, knitwear, the dressed body',
    img:      IMAGES['trousers-primary'],
    products: PRODUCTS.filter(p => ['Tailoring', 'Ready-to-wear', 'Knitwear', 'Tops'].includes(p.category)),
  },
  {
    num:      '03',
    title:    'Surface',
    sub:      'Leather, canvas, the carried object',
    img:      IMAGES['boots-primary'],
    products: PRODUCTS.filter(p => ['Footwear', 'Accessories'].includes(p.category)),
  },
] as const;
---

<Layout title="Lookbook" solidNav={true}>

  <header class="lb-header wrap">
    <div class="rule js-rule"></div>
    <div class="lb-header-inner">
      <div>
        <span class="label muted">{SITE.season}</span>
        <h1 class="lb-title" data-anim="hero">Lookbook</h1>
      </div>
      <span class="label muted" data-anim="hero" data-delay="0.1">Three chapters</span>
    </div>
  </header>

  {chapters.map((ch, i) => (
    <section class="chapter" id={`chapter-${ch.num}`}>

      <div class="chapter-hero js-hero">
        <Picture
          class="chapter-img js-img"
          src={ch.img}
          formats={['avif', 'webp']}
          alt={ch.title}
          loading={i === 0 ? undefined : 'lazy'}
          decoding="async"
          width={1600}
        />
        <div class="chapter-scrim scrim"></div>
        <div class="chapter-cap wrap">
          <span class="label chapter-num">Chapter {ch.num}</span>
          <h2 class="chapter-title serif">{ch.title}</h2>
          <p class="label chapter-sub">{ch.sub}</p>
        </div>
      </div>

      <div class="product-grid wrap">
        {ch.products.map(p => <ProductCard {...p} imgWidth={700} />)}
      </div>

      {i < chapters.length - 1 && (
        <div class="chapter-divider wrap"><div class="rule"></div></div>
      )}

    </section>
  ))}

  <CTAStrip label={`${SITE.season} — All pieces`} linkText="View Collection" href="/collection" />

</Layout>

<script>
import { initPage, onReady, gsap } from '@lib/animate';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    initPage('.js-rule');

    document.querySelectorAll<HTMLElement>('.js-hero').forEach(hero => {
      const img = hero.querySelector<HTMLElement>('.js-img');
      if (!img) return;
      gsap.set(img, { scale: 1.12 });
      ScrollTrigger.create({
        trigger: hero, start: 'top bottom', end: 'bottom top', scrub: 2,
        onUpdate: st => gsap.set(img, { yPercent: -10 * st.progress }),
      });
    });
  });
});
</script>

<style>
.lb-header {
  padding-top: calc(var(--nav-h) + var(--space-2xl));
  padding-bottom: var(--space-2xl);
}

.lb-header-inner {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-top: var(--space-lg);
  gap: var(--space-md);
}

.lb-title {
  font-size: var(--text-display-md);
  font-variation-settings: var(--font-weight-light);
  letter-spacing: -0.04em;
  line-height: 1;
  margin-top: var(--space-xs);
}

.chapter-hero {
  position: relative;
  height: 88svh;
  min-height: 480px;
  overflow: hidden;
}

.chapter-img {
  position: absolute;
  inset: 0;
}

.chapter-img img { object-position: center top; }

.chapter-scrim {
  background: linear-gradient(to bottom, transparent 35%, rgb(28 27 25 / 0.7) 100%);
}

.chapter-cap {
  position: absolute;
  inset-block-end: 3.5rem;
  inset-inline: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}
@media (min-width: 768px) { .chapter-cap { inset-block-end: 5rem; } }

.chapter-num { color: var(--overlay-text-muted); }

.chapter-title {
  font-size: clamp(3.5rem, 11vw, 9rem);
  font-style: italic;
  font-variation-settings: var(--font-weight-medium);
  letter-spacing: -0.03em;
  line-height: 0.92;
  color: var(--overlay-text-primary);
}

.chapter-sub { color: var(--overlay-text-secondary); }

.product-grid.wrap {
  padding-block: 0;
}

.chapter-divider {
  padding-block: var(--space-3xl);
}
@media (min-width: 768px) { .chapter-divider { padding-block: var(--space-4xl); } }
</style>
