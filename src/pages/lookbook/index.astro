---
import Layout from '../../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS } from '../../data/products';
import { SITE } from '../../data/site';
import { IMAGES } from '../../assets/images';

const spreads = [
  {
    issue:    '01',
    title:    'Weight',
    subtitle: 'On the architecture of outerwear',
    img:      IMAGES['coat-primary'],
    heroSlug: 'obsidian-coat',
    products: PRODUCTS.filter(p => p.category === 'Outerwear'),
  },
  {
    issue:    '02',
    title:    'Structure',
    subtitle: 'Tailoring, knitwear, the dressed body',
    img:      IMAGES['trousers-primary'],
    heroSlug: 'ash-trousers',
    products: PRODUCTS.filter(p => ['Tailoring', 'Ready-to-wear', 'Knitwear', 'Tops'].includes(p.category)),
  },
  {
    issue:    '03',
    title:    'Surface',
    subtitle: 'Leather, canvas, the carried object',
    img:      IMAGES['boots-primary'],
    heroSlug: 'eclipse-boots',
    products: PRODUCTS.filter(p => ['Footwear', 'Accessories'].includes(p.category)),
  },
] as const;
---

<Layout title="Lookbook" solidNav={true}>
  <div class="ph wrap page-top-spacing">
    <div class="ph-inner">
      <div class="ph-left">
        <span class="label muted" data-anim="hero" data-delay="0">{SITE.season}</span>
        <h1 class="ph-title" data-anim="hero" data-delay="0.15">Lookbook</h1>
      </div>
      <span class="label muted ph-aside" data-anim="hero" data-delay="0.25">Three chapters</span>
    </div>
    <div class="rule"></div>
  </div>

  {spreads.map((s, si) => (
    <section class="spread" id={`chapter-${s.issue}`}>

      <div class="spread-hero">
        <Picture
          class="spread-img"
          src={s.img}
          formats={['avif', 'webp']}
          alt={s.title}
          loading={si === 0 ? undefined : 'lazy'}
          decoding="async"
          width={1600}
          transition:name={`product-img-${s.heroSlug}`}
        />
        <div class="spread-scrim scrim"></div>
        <div class="spread-cap wrap">
          <span class="label spread-issue">Chapter {s.issue}</span>
          <h2 class="spread-title serif">{s.title}</h2>
          <p class="label spread-sub">{s.subtitle}</p>
        </div>
      </div>

      <div class="product-grid wrap" id={`spread-${s.issue}`}>
        {s.products.map((p) => (
          <ProductCard {...p} imgWidth={700} />
        ))}
      </div>

      {si < spreads.length - 1 && (
        <div class="spread-gap wrap"><div class="rule"></div></div>
      )}

    </section>
  ))}

  <div class="cta wrap" data-anim="scroll">
    <div class="rule"></div>
    <div class="cta-inner">
      <span class="label op-35">{SITE.season} — All pieces</span>
      <a href="/collection" class="label muted-link">View Collection →</a>
    </div>
    <div class="rule"></div>
  </div>
</Layout>

<script>
import { reveal, lineReveal, gsap } from '../../lib/animate';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

document.addEventListener('astro:page-load', () => {
  Promise.race([document.fonts.ready, new Promise<void>(r => setTimeout(r, 300))])
    .then(() => requestAnimationFrame(() => requestAnimationFrame(() => {
      reveal();
      lineReveal('.ph .rule', 0.35);
      
      // Chapter parallax
      document.querySelectorAll<HTMLElement>('.spread-hero').forEach(hero => {
        const img = hero.querySelector<HTMLElement>('.spread-img');
        const cap = hero.querySelector<HTMLElement>('.spread-cap');
        if (!img) return;
        gsap.set(img, { scale: 1.16 });
        ScrollTrigger.create({
          trigger: hero, start: 'top bottom', end: 'bottom top', scrub: 1.8,
          onUpdate: st => {
            gsap.set(img, { yPercent: -14 * st.progress });
            if (cap) gsap.set(cap, { yPercent: 4 * st.progress });
          },
        });
      });
    })));
});
</script>

<style>
.ph-inner {
  display: flex; align-items: flex-end;
  justify-content: space-between;
  padding-bottom: var(--space-lg); gap: var(--space-md);
}

.ph-left { display: flex; flex-direction: column; gap: var(--space-xs); }

.ph-title {
  font-family: var(--font-sans);
  font-size: var(--text-display-md);
  font-variation-settings: var(--font-weight-light);
  letter-spacing: -0.04em;
  line-height: 1;
}

.ph-aside { align-self: flex-end; padding-bottom: 0.3rem; }

.spread-hero {
  position: relative;
  height: 85svh; min-height: 440px;
  overflow: hidden;
}
@media (min-width: 768px) { .spread-hero { height: 90svh; } }

.spread-img img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center;
  display: block;
}

.spread-scrim {
  background: linear-gradient(to bottom, transparent 40%, var(--scrim-dark-heavy) 100%);
}

.spread-cap {
  position: absolute;
  inset-block-end: 3.5rem;
  inset-inline: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}
@media (min-width: 768px) { .spread-cap { inset-block-end: 4.5rem; } }

.spread-issue { color: var(--overlay-text-muted); }

.spread-title {
  font-size: clamp(3rem, 10vw, 8rem);
  font-style: italic;
  font-variation-settings: var(--font-weight-medium);
  letter-spacing: -0.03em;
  line-height: 0.95;
  color: var(--overlay-text-primary);
}

.spread-sub { color: var(--overlay-text-muted); }

.spread-gap { padding-block: 5rem; }
@media (min-width: 768px) { .spread-gap { padding-block: 7rem; } }

/* ── CTA Strip ─────────────────────────────────────────────────────────── */
.cta { padding-block: var(--space-lg) var(--space-3xl); }
.cta-inner {
  display: flex; justify-content: space-between; align-items: center;
  flex-wrap: wrap; gap: var(--space-sm); padding-block: var(--space-lg);
}
</style>
