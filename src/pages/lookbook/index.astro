---
import Layout from '../../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import PageHeader from '../../components/PageHeader.astro';
import ProductCard from '../../components/ProductCard.astro';
import CtaStrip from '../../components/CtaStrip.astro';
import { PRODUCTS } from '../../data/products';
import { SPREADS } from '../../data/lookbook';
import { SITE } from '../../data/site';
import { IMAGES } from '../../assets/images';

const spreads = SPREADS.map(s => ({
  ...s,
  img:      IMAGES[s.imgKey],
  products: PRODUCTS.filter(p => s.categories.includes(p.category)),
}));
---

<Layout title="Lookbook" solidNav={true}>
  <PageHeader label={SITE.season} title="Lookbook" aside="Three chapters" />

  {spreads.map((s, si) => (
    <section class="spread" id={`chapter-${s.issue}`}>

      <div class="spread-hero">
        <Picture
          class="spread-img"
          src={s.img}
          formats={['avif', 'webp']}
          alt={s.title}
          loading={si === 0 ? undefined : 'lazy'}
          decoding="async"
          width={1600}
          transition:name={`product-img-${s.heroSlug}`}
        />
        <div class="spread-scrim scrim"></div>
        <div class="spread-cap wrap">
          <span class="label spread-issue">Chapter {s.issue}</span>
          <h2 class="spread-title serif">{s.title}</h2>
          <p class="label spread-sub">{s.subtitle}</p>
        </div>
      </div>

      <div class="product-grid wrap" id={`spread-${s.issue}`}>
        {s.products.map((p) => (
          <ProductCard {...p} imgWidth={700} />
        ))}
      </div>

      {si < spreads.length - 1 && (
        <div class="spread-gap wrap"><div class="rule"></div></div>
      )}

    </section>
  ))}

  <CtaStrip label={`${SITE.season} — All pieces`} href="/collection" cta="View Collection →" />
</Layout>

<script>
import { onPageLoad, pageReveal, chapterParallax } from '../../lib/animate';

onPageLoad(() => {
  pageReveal(0.35);
  chapterParallax();
});
</script>

<style>
.spread-hero {
  position: relative;
  height: 85svh; min-height: 440px;
  overflow: hidden;
}
@media (min-width: 768px) { .spread-hero { height: 90svh; } }

.spread-img img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center;
  display: block;
}

.spread-scrim {
  background: linear-gradient(to bottom, transparent 40%, rgb(28 27 25 / 0.72) 100%);
}

.spread-cap {
  position: absolute;
  inset-block-end: 3.5rem;
  inset-inline: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
@media (min-width: 768px) { .spread-cap { inset-block-end: 4.5rem; } }

.spread-issue { color: rgb(255 255 255 / 0.4); }

.spread-title {
  font-size: clamp(3rem, 10vw, 8rem);
  font-style: italic;
  font-variation-settings: 'wght' 400;
  letter-spacing: -0.03em;
  line-height: 0.95;
  color: rgb(255 255 255 / 0.92);
}

.spread-sub { color: rgb(255 255 255 / 0.4); }

.spread-gap { padding-block: 5rem; }
@media (min-width: 768px) { .spread-gap { padding-block: 7rem; } }
</style>
