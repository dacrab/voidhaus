---
import Layout from '@layouts/Layout.astro';
import { Picture } from 'astro:assets';
import ProductCard from '@components/ProductCard.astro';
import CTAStrip from '@components/CTAStrip.astro';
import { PRODUCTS } from '@data/products';
import { SITE } from '@data/site';
import { IMAGES } from '@assets/images';

const chapters = [
  {
    num:      '01',
    title:    'Weight',
    sub:      'On the architecture of outerwear',
    img:      IMAGES['coat-primary'],
    products: PRODUCTS.filter(p => p.category === 'Outerwear'),
  },
  {
    num:      '02',
    title:    'Structure',
    sub:      'Tailoring, knitwear, the dressed body',
    img:      IMAGES['trousers-primary'],
    products: PRODUCTS.filter(p => ['Tailoring', 'Ready-to-wear', 'Knitwear', 'Tops'].includes(p.category)),
  },
  {
    num:      '03',
    title:    'Surface',
    sub:      'Leather, canvas, the carried object',
    img:      IMAGES['boots-primary'],
    products: PRODUCTS.filter(p => ['Footwear', 'Accessories'].includes(p.category)),
  },
] as const;
---

<Layout title="Lookbook" solidNav={true}>

  <header class="page-header wrap">
    <div class="rule js-rule"></div>
    <div class="flex items-end justify-between pt-lg gap-md">
      <div>
        <span class="label muted">{SITE.season}</span>
        <h1 class="lb-title fw-light mt-xs" data-anim="hero">Lookbook</h1>
      </div>
      <span class="label muted" data-anim="hero" data-delay="0.1">Three chapters</span>
    </div>
  </header>

  {chapters.map((ch, i) => (
    <section id={`chapter-${ch.num}`}>

      <div class="js-hero relative min-h-[480px] h-[88svh] overflow-hidden">
        <Picture
          class="js-img absolute inset-0"
          src={ch.img}
          formats={['avif', 'webp']}
          alt={ch.title}
          loading={i === 0 ? undefined : 'lazy'}
          decoding="async"
          width={1600}
        />
        <div class="chapter-scrim scrim"></div>
        <div class="wrap absolute bottom-14 md:bottom-20 inset-x-0 flex flex-col gap-sm">
          <span class="label ot-muted">Chapter {ch.num}</span>
          <h2 class="chapter-title serif fw-medium italic leading-[0.92] tracking-[-0.03em] ot-primary">{ch.title}</h2>
          <p class="label ot-secondary">{ch.sub}</p>
        </div>
      </div>

      <div class="product-grid wrap">
        {ch.products.map(p => <ProductCard {...p} imgWidth={700} />)}
      </div>

      {i < chapters.length - 1 && (
        <div class="wrap py-4xl md:py-5xl"><div class="rule"></div></div>
      )}

    </section>
  ))}

  <CTAStrip label={`${SITE.season} — All pieces`} linkText="View Collection" href="/collection" />

</Layout>

<script>
import { initPage, onReady, gsap, DUR } from '@lib/animate';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    initPage('.js-rule');
    document.querySelectorAll<HTMLElement>('.js-hero').forEach(hero => {
      const img = hero.querySelector<HTMLElement>('.js-img');
      if (!img) return;
      gsap.fromTo(img, { opacity: 0, scale: 1.12 }, { opacity: 1, scale: 1.08, duration: DUR.slow, ease: 'power3.out' });
      ScrollTrigger.create({
        trigger: hero, start: 'top bottom', end: 'bottom top', scrub: 2,
        onUpdate: st => gsap.set(img, { yPercent: -5 * st.progress }),
      });
    });
  });
});
</script>

<style>
.lb-title      { font-size: var(--text-display); letter-spacing: -0.04em; line-height: 1; }
.chapter-title { font-size: clamp(3.5rem, 11vw, 9rem); }
.chapter-scrim { background: linear-gradient(to bottom, transparent 35%, rgb(28 27 25 / 0.7) 100%); }
.js-img img    { object-position: center top; }
</style>
