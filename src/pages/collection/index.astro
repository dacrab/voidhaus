---
import Layout from '@layouts/Layout.astro';
import ProductCard from '@components/ProductCard.astro';
import { PRODUCTS, CATEGORIES } from '@data/products';
import { SITE } from '@data/site';
---

<Layout title="Collection" solidNav={true}>

  <div class="page-header wrap">
    <div class="flex items-baseline justify-between flex-wrap gap-md pb-lg">
      <h1 class="coll-title fw-normal" data-anim="hero">Collection</h1>
      <span class="label muted" data-anim="hero" data-delay="0.15">{SITE.season} — {PRODUCTS.length} pieces</span>
    </div>
    <div class="flex gap-lg md:gap-xl pb-md overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="group" aria-label="Filter by category" data-anim="hero" data-delay="0.2">
      {CATEGORIES.map((f, i) => (
        <button class:list={['filter-btn', 'label', { active: i === 0 }]} data-filter={f} type="button" aria-pressed={i === 0 ? 'true' : 'false'}>{f}</button>
      ))}
    </div>
    <div class="rule js-rule"></div>
  </div>

  <div class="product-grid wrap" id="js-grid">
    {PRODUCTS.map(p => <ProductCard {...p} />)}
  </div>

</Layout>

<script>
import { initPage, onReady, gsap, DUR, EASE } from '@lib/animate';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    initPage('.js-rule');
    const cards = document.querySelectorAll<HTMLElement>('.pc');
    const btns  = document.querySelectorAll<HTMLElement>('.filter-btn');
    btns.forEach(btn => btn.addEventListener('click', () => {
      btns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      const f = btn.dataset.filter;
      cards.forEach(card => {
        const show = f === 'All' || card.dataset.category === f;
        gsap.to(card, { autoAlpha: show ? 1 : 0.1, scale: show ? 1 : 0.97, duration: DUR.major, ease: EASE });
      });
    }));
  });
});
</script>

<style>
.coll-title { font-size: clamp(1.75rem, 5vw, 3.5rem); letter-spacing: -0.03em; line-height: 1; }
.filter-btn {
  background: none; border: none; padding: 0.75rem 0.5rem;
  min-height: 44px;
  color: var(--color-ink); opacity: var(--op-disabled);
  white-space: nowrap; flex-shrink: 0;
  transition: opacity var(--duration-fast);
}
.filter-btn:hover  { opacity: var(--op-hover); }
.filter-btn.active { opacity: 1; }
</style>
