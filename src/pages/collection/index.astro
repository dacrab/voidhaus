---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS, CATEGORIES } from '../../data/products';
import { SITE } from '../../data/site';
---

<Layout title="Collection" solidNav={true}>

  <div class="coll-top wrap">
    <div class="coll-top-inner">
      <h1 class="coll-title" data-anim="hero" data-delay="0">Collection</h1>
      <span class="label muted coll-count" data-anim="hero" data-delay="0.15">
        {SITE.season} — {PRODUCTS.length} pieces
      </span>
    </div>

    <div class="filters" role="group" aria-label="Filter by category" data-anim="hero" data-delay="0.2">
      {CATEGORIES.map((f, i) => (
        <button
          class:list={['filter-btn', 'label', { active: i === 0 }]}
          data-filter={f}
          type="button"
        >
          {f}
        </button>
      ))}
    </div>
    <div class="rule"></div>
  </div>

  <div class="product-grid wrap" id="js-grid">
    {PRODUCTS.map(p => <ProductCard {...p} />)}
  </div>

</Layout>

<script>
import { initPage, onReady, gsap, DUR, EASE } from '../../lib/animate';

document.addEventListener('astro:page-load', () => {
  onReady(() => {
    initPage('.coll-top .rule');

    const cards = document.querySelectorAll<HTMLElement>('.pc');
    const btns = document.querySelectorAll<HTMLElement>('.filter-btn');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const f = btn.dataset.filter;
        cards.forEach(card => {
          const show = f === 'All' || card.dataset.category === f;
          gsap.to(card, { autoAlpha: show ? 1 : 0.1, scale: show ? 1 : 0.97, duration: DUR.base, ease: 'power2.out' });
        });
      });
    });
  });
});
</script>

<style>
/* Extra top padding accounts for the fixed nav height */
.coll-top { padding-top: calc(var(--nav-h) + var(--space-2xl)); }
@media (min-width: 768px) { .coll-top { padding-top: calc(var(--nav-h) + var(--space-3xl)); } }

.coll-top-inner {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: var(--space-lg);
  gap: var(--space-md);
  flex-wrap: wrap;
}

.coll-title {
  font-family: var(--font-sans);
  font-size: clamp(1.75rem, 5vw, 3.5rem);
  font-variation-settings: var(--font-weight-normal);
  letter-spacing: -0.03em;
  line-height: 1;
  color: var(--color-ink);
}

.filters {
  display: flex;
  gap: var(--space-lg);
  padding-bottom: var(--space-md);
  overflow-x: auto;
  scrollbar-width: none;
}
.filters::-webkit-scrollbar { display: none; }
@media (min-width: 768px) { .filters { gap: var(--space-xl); } }

.filter-btn {
  background: none; border: none;
  color: var(--color-ink); opacity: var(--opacity-disabled);
  transition: opacity var(--duration-fast);
  white-space: nowrap; flex-shrink: 0; padding: 0;
}
.filter-btn:hover  { opacity: var(--opacity-hover); }
.filter-btn.active { opacity: 1; }

</style>
