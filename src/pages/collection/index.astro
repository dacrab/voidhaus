---
import Layout from '../../layouts/Layout.astro';
import { PRODUCTS, CATEGORIES } from '../../data/products';
---

<Layout title="Collection">

  <!-- Straight to grid — no hero, no preamble -->
  <div class="coll-top wrap">
    <div class="coll-top-inner">
      <h1 class="coll-title" data-anim="hero" data-delay="0">Collection</h1>
      <span class="label muted coll-count" data-anim="hero" data-delay="0.15">
        SS 2026 — {PRODUCTS.length} pieces
      </span>
    </div>

    <!-- Filters inline with header -->
    <div class="filters" role="group" aria-label="Filter by category" data-anim="hero" data-delay="0.2">
      {CATEGORIES.map((f, i) => (
        <button
          class:list={['filter-btn', 'label', { active: i === 0 }]}
          data-filter={f}
          type="button"
        >
          {f}
        </button>
      ))}
    </div>
    <div class="rule"></div>
  </div>

  <!-- Grid — no animations, products just appear -->
  <div class="grid wrap" id="js-grid">
    {PRODUCTS.map((p, i) => (
      <article class="card" data-category={p.category}>
        <a href={`/product/${p.slug}`}>
          <div class="card-img-wrap">
            <img
              class="card-img card-img--primary"
              src={p.img.replace(/w=\d+/, 'w=800')}
              alt={p.name}
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
              width="800" height="1067"
            />
            <img
              class="card-img card-img--secondary"
              src={p.img2.replace(/w=\d+/, 'w=800')}
              alt=""
              loading="lazy"
              decoding="async"
              width="800" height="1067"
              aria-hidden="true"
            />
          </div>
          <div class="card-info">
            <div class="card-info-l">
              <span class="label muted">{p.num}</span>
              <span class="card-name">{p.name}</span>
              <span class="label muted card-cat">{p.category}</span>
            </div>
            <span class="label muted">€ {p.price}</span>
          </div>
        </a>
      </article>
    ))}
  </div>

</Layout>

<script>
import { onReady, revealHero } from '../../lib/animate';
import { initToggleGroup } from '../../lib/toggle';
import gsap from 'gsap';

onReady(() => {
  revealHero();

  const cards = document.querySelectorAll<HTMLElement>('.card');
  initToggleGroup('.filter-btn', btn => {
    const f = btn.dataset.filter;
    cards.forEach(card => {
      const show = f === 'All' || card.dataset.category === f;
      gsap.to(card, { opacity: show ? 1 : 0.12, duration: 0.3, ease: 'power2.out' });
    });
  });
});
</script>

<style>
/* Top bar */
.coll-top {
  padding-top: 5rem;
  padding-bottom: 0;
}
@media (min-width: 768px) { .coll-top { padding-top: 7rem; } }

.coll-top-inner {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 1.5rem;
  gap: 1rem;
  flex-wrap: wrap;
}

.coll-title {
  font-family: var(--font-sans);
  font-size: clamp(1.75rem, 5vw, 3.5rem);
  font-variation-settings: 'wght' 300;
  letter-spacing: -0.03em;
  line-height: 1;
  color: var(--color-ink);
}

/* Filters */
.filters {
  display: flex;
  gap: 1.5rem;
  padding-bottom: 1rem;
  overflow-x: auto;
  scrollbar-width: none;
}
.filters::-webkit-scrollbar { display: none; }
@media (min-width: 768px) { .filters { gap: 2rem; } }

.filter-btn {
  background: none; border: none;
  color: var(--color-ink); opacity: 0.3;
  transition: opacity 0.2s;
  white-space: nowrap; flex-shrink: 0; padding: 0;
}
.filter-btn:hover { opacity: 0.65; }
.filter-btn.active { opacity: 1; }

/* Grid — instant appearance, no reveal animation */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  background: var(--color-rule);
  border-inline: 1px solid var(--color-rule);
  border-bottom: 1px solid var(--color-rule);
}
@media (min-width: 768px)  { .grid { grid-template-columns: repeat(3, 1fr); } }
@media (min-width: 1280px) { .grid { grid-template-columns: repeat(4, 1fr); } }

.card { background: var(--color-white); }
.card a { display: block; }

/* Hover image swap */
.card-img-wrap {
  position: relative;
  aspect-ratio: 2/3;
  overflow: hidden;
  background: var(--color-off);
}

.card-img {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  object-fit: cover; object-position: center top;
  display: block;
  transition: opacity 0.55s ease;
}

.card-img--primary   { opacity: 1; z-index: 1; }
.card-img--secondary { opacity: 0; z-index: 2; }
.card a:hover .card-img--secondary { opacity: 1; }

.card-info {
  display: flex; align-items: flex-start;
  justify-content: space-between;
  padding: 1rem 1rem 1.25rem; gap: 0.5rem;
  border-top: 1px solid var(--color-rule);
}
@media (min-width: 768px) { .card-info { padding: 1.25rem 1.5rem 1.75rem; } }

.card-info-l { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
.card-name {
  font-size: 0.8125rem; font-variation-settings: 'wght' 300;
  color: var(--color-ink); display: block; margin-top: 0.2rem;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.card-cat { display: block; margin-top: 0.1rem; }
</style>
