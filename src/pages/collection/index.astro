---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS, CATEGORIES } from '../../data/products';
---

<Layout title="Collection" solidNav={true}>

  <div class="coll-top wrap">
    <div class="coll-top-inner">
      <h1 class="coll-title" data-anim="hero" data-delay="0">Collection</h1>
      <span class="label muted coll-count" data-anim="hero" data-delay="0.15">
        SS 2026 — {PRODUCTS.length} pieces
      </span>
    </div>

    <div class="filters" role="group" aria-label="Filter by category" data-anim="hero" data-delay="0.2">
      {CATEGORIES.map((f, i) => (
        <button
          class:list={['filter-btn', 'label', { active: i === 0 }]}
          data-filter={f}
          type="button"
        >
          {f}
        </button>
      ))}
    </div>
    <div class="rule"></div>
  </div>

  <div class="product-grid wrap" id="js-grid">
    {PRODUCTS.map(p => <ProductCard {...p} />)}
  </div>

</Layout>

<script>
import { onPageLoad, cardsCascade, lineReveal, reveal } from '../../lib/animate';
import { initToggleGroup } from '../../lib/toggle';
import gsap from 'gsap';

onPageLoad(() => {
  reveal();
  lineReveal('.coll-top .rule', 0.3);
  cardsCascade('.pc');

  const cards = document.querySelectorAll<HTMLElement>('.pc');
  initToggleGroup('.filter-btn', btn => {
    const f = btn.dataset.filter;
    cards.forEach(card => {
      const show = f === 'All' || card.dataset.category === f;
      gsap.to(card, { autoAlpha: show ? 1 : 0.1, scale: show ? 1 : 0.97, duration: 0.28, ease: 'power2.out' });
    });
  });
});
</script>

<style>
/* Extra top padding accounts for the fixed nav height */
.coll-top {
  padding-top: calc(var(--nav-h) + 3rem);
  padding-bottom: 0;
}
@media (min-width: 768px) { .coll-top { padding-top: calc(var(--nav-h) + 5rem); } }

.coll-top-inner {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 1.5rem;
  gap: 1rem;
  flex-wrap: wrap;
}

.coll-title {
  font-family: var(--font-sans);
  font-size: clamp(1.75rem, 5vw, 3.5rem);
  font-variation-settings: 'wght' 300;
  letter-spacing: -0.03em;
  line-height: 1;
  color: var(--color-ink);
}

.filters {
  display: flex;
  gap: 1.5rem;
  padding-bottom: 1rem;
  overflow-x: auto;
  scrollbar-width: none;
}
.filters::-webkit-scrollbar { display: none; }
@media (min-width: 768px) { .filters { gap: 2rem; } }

.filter-btn {
  background: none; border: none;
  color: var(--color-ink); opacity: 0.3;
  transition: opacity 0.2s;
  white-space: nowrap; flex-shrink: 0; padding: 0;
}
.filter-btn:hover  { opacity: 0.65; }
.filter-btn.active { opacity: 1; }

</style>
