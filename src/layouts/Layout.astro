---
import '../styles/global.css';
import Nav from '../components/Nav.svelte';
import Cart from '../components/Cart.svelte';
import ForSale from '../components/ForSale.svelte';
import { SITE } from '../data/site';

interface Props {
  title?:       string;
  description?: string;
  image?:       string;
}

const {
  title       = SITE.name,
  description = SITE.tagline,
  image       = '/og.jpg',
} = Astro.props;

const fullTitle  = title === SITE.name ? title : `${title} — ${SITE.name}`;
const canonical  = new URL(Astro.url.pathname, Astro.site ?? 'https://voidhaus.com').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={image} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:site_name"   content={SITE.name} />

    <!-- Twitter -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={image} />

    <title>{fullTitle}</title>

    <script>
      // Newsletter form — simple feedback, no backend for demo
      document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('nl-form')?.addEventListener('submit', e => {
          e.preventDefault();
          const form   = e.target as HTMLFormElement;
          const input  = form.querySelector<HTMLInputElement>('.nl-input');
          const btn    = form.querySelector<HTMLButtonElement>('.nl-btn');
          if (!input || !btn) return;
          // Simple validation
          if (!input.value.includes('@')) {
            input.style.borderBottom = '1px solid var(--color-ink)';
            input.focus();
            return;
          }
          btn.textContent = 'Subscribed ✓';
          btn.style.opacity = '1';
          input.value = '';
          input.disabled = true;
          btn.disabled  = true;
        });
      });
    </script>

    <!-- FOUC prevention — inline, runs before first paint -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      if (document.fonts?.ready) {
        document.fonts.ready.then(function() {
          document.documentElement.classList.add('fonts-loaded');
        });
        setTimeout(function() {
          document.documentElement.classList.add('fonts-loaded');
        }, 600);
      } else {
        document.documentElement.classList.add('fonts-loaded');
      }
    </script>
  </head>
  <body>
    <ForSale client:load />
    <Nav client:load />
    <Cart client:load />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <!-- Newsletter strip -->
      <div class="newsletter wrap">
        <div class="nl-inner">
          <div class="nl-left">
            <span class="label muted">Newsletter</span>
            <p class="nl-text">Dispatches from the atelier. Infrequent. Worth reading.</p>
          </div>
          <form class="nl-form" id="nl-form" novalidate>
            <input
              class="nl-input"
              type="email"
              name="email"
              placeholder="your@email.com"
              autocomplete="email"
              aria-label="Email address"
            />
            <button class="nl-btn label" type="submit">Subscribe</button>
          </form>
        </div>
      </div>

      <!-- Footer bottom -->
      <div class="wrap footer-bottom">
        <div class="rule"></div>
        <div class="footer-inner">
          <span class="label muted">© 2026 {SITE.name}</span>
          <nav class="footer-links" aria-label="Legal">
            <a href="/stockists" class="label muted footer-link">Stockists</a>
            <a href="/privacy"   class="label muted footer-link">Privacy</a>
            <a href="/terms"     class="label muted footer-link">Terms</a>
          </nav>
          <span class="label muted footer-cities">Milan · Antwerp · Florence · Tokyo</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    border-top: 1px solid var(--color-rule);
    margin-top: 5rem;
  }

  /* Newsletter */
  .newsletter {
    padding-block: 3rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .nl-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .nl-left { display: flex; flex-direction: column; gap: 0.4rem; }

  .nl-text {
    font-size: 0.8125rem;
    font-variation-settings: 'wght' 300;
    color: var(--color-soft);
    max-width: 32ch;
  }

  .nl-form {
    display: flex;
    gap: 0;
    border: 1px solid var(--color-rule);
    flex-shrink: 0;
  }

  .nl-input {
    background: none;
    border: none;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-variation-settings: 'wght' 300;
    font-size: max(16px, 0.8125rem);
    padding: 0.75rem 1rem;
    outline: none;
    width: 220px;
    transition: border-color 0.2s;
  }
  .nl-input::placeholder { color: var(--color-mid); }

  .nl-btn {
    background: none;
    border: none;
    border-left: 1px solid var(--color-rule);
    color: var(--color-ink);
    opacity: 0.5;
    padding: 0.75rem 1rem;
    white-space: nowrap;
    transition: opacity 0.2s, background 0.2s;
  }
  .nl-btn:hover { opacity: 1; background: var(--color-off); }

  @media (max-width: 640px) {
    .nl-form { width: 100%; }
    .nl-input { flex: 1; width: auto; }
  }

  /* Footer bottom */
  .footer-bottom { padding-block: 1.5rem 2rem; }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 1.5rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .footer-link {
    transition: opacity 0.2s;
  }
  .footer-link:hover { opacity: 1 !important; }

  .footer-cities { display: none; }
  @media (min-width: 640px) { .footer-cities { display: block; } }
</style>
