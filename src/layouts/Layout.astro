---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.svelte';
import Cart from '../components/Cart.svelte';
import ForSale from '../components/ForSale.svelte';
import { SITE } from '../data/site';

interface Props {
  title?:       string;
  description?: string;
  image?:       string;
  type?:        'website' | 'product';
  solidNav?:    boolean;
}

const {
  title       = SITE.name,
  description = SITE.tagline,
  image       = '/og.jpg',
  type        = 'website',
  solidNav    = false,
} = Astro.props;

const baseUrl   = Astro.site ?? new URL('https://voidhaus.vercel.app');
const fullTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, baseUrl).href;
const ogImage   = image.startsWith('http') ? image : new URL(image, baseUrl).href;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#faf9f7" />
    <link rel="icon"             href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="canonical"        href={canonical} />
    <link rel="sitemap"          href="/sitemap-index.xml" />
    <Font cssVariable="--font-sans"  preload />
    <Font cssVariable="--font-serif" preload />
    <ClientRouter />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots"      content="index, follow" />

    <meta property="og:type"        content={type} />
    <meta property="og:site_name"   content={SITE.name} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:locale"      content="en_US" />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ClothingStore',
      name: SITE.name,
      description: SITE.tagline,
      url: canonical,
      logo: new URL('/favicon.svg', baseUrl).href,
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.address[0],
        addressLocality: 'Milan',
        postalCode: '20121',
        addressCountry: 'IT',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        email: SITE.email.studio,
        contactType: 'customer service',
      },
    })} />

    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>

  <body>
    <Nav client:load solidNav={solidNav} />
    <ForSale client:load />
    <Cart client:load />

    <main id="main">
      <slot />
    </main>

    <script>
      document.getElementById('nl-form')?.addEventListener('submit', e => {
        e.preventDefault();
        const form  = e.target as HTMLFormElement;
        const input = form.querySelector<HTMLInputElement>('.nl-input');
        const btn   = form.querySelector<HTMLButtonElement>('.nl-btn');
        if (!input || !btn || !input.value.includes('@')) { input?.focus(); return; }
        btn.textContent = 'Subscribed ✓';
        btn.classList.add('subscribed');
        input.value    = '';
        input.disabled = true;
        btn.disabled   = true;
      });
    </script>

    <footer class="site-footer">
      <div class="newsletter wrap">
        <div class="nl-inner">
          <div class="nl-left">
            <span class="label muted">Newsletter</span>
            <p class="nl-text">Dispatches from the atelier. Infrequent. Worth reading.</p>
          </div>
          <form class="nl-form" id="nl-form" novalidate>
            <input
              class="nl-input"
              type="email"
              name="email"
              placeholder="your@email.com"
              autocomplete="email"
              aria-label="Email address for newsletter"
              required
            />
            <button class="nl-btn label" type="submit">Subscribe</button>
          </form>
        </div>
      </div>

      <div class="wrap footer-bottom">
        <div class="rule"></div>
        <div class="footer-inner">
          <span class="label muted">© {new Date().getFullYear()} {SITE.name}</span>
          <nav class="footer-links" aria-label="Legal navigation">
            <a href="/stockists" class="label muted muted-link">Stockists</a>
            <a href="/privacy"   class="label muted muted-link">Privacy</a>
            <a href="/terms"     class="label muted muted-link">Terms</a>
          </nav>
          <span class="label muted footer-cities">{SITE.ateliers.map(a => a.city).join(' · ')}</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-footer { border-top: 1px solid var(--color-rule); margin-top: 5rem; }

  .newsletter { padding-block: 3rem; border-bottom: 1px solid var(--color-rule); }
  .nl-inner   { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .nl-left    { display: flex; flex-direction: column; gap: 0.4rem; }
  .nl-text    { font-size: 0.8125rem; font-variation-settings: 'wght' 300; color: var(--color-soft); max-width: 32ch; }
  .nl-form    { display: flex; border: 1px solid var(--color-rule); flex-shrink: 0; }
  .nl-input {
    background: none; border: none;
    color: var(--color-ink); font-family: var(--font-sans);
    font-variation-settings: 'wght' 300;
    font-size: max(16px, 0.8125rem);
    padding: 0.75rem 1rem; outline: none; width: 220px;
  }
  .nl-input::placeholder { color: var(--color-mid); }
  .nl-btn {
    background: none; border: none; border-left: 1px solid var(--color-rule);
    color: var(--color-ink); opacity: 0.5; padding: 0.75rem 1rem;
    white-space: nowrap; transition: opacity 0.2s, background 0.2s;
  }
  .nl-btn:hover, .nl-btn.subscribed { opacity: 1; background: var(--color-off); }
  @media (max-width: 640px) { .nl-form { width: 100%; } .nl-input { flex: 1; width: auto; } }

  .footer-bottom { padding-block: 1.5rem 2rem; }
  .footer-inner {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 0.75rem; padding-top: 1.5rem;
  }
  .footer-links  { display: flex; gap: 1.5rem; align-items: center; }
  .footer-cities { display: none; }
  @media (min-width: 640px) { .footer-cities { display: block; } }
</style>
