---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.svelte';
import Cart from '../components/Cart.svelte';
import { SITE } from '@data/site';

interface Props {
  title?:       string;
  description?: string;
  image?:       string;
  type?:        'website' | 'product';
  solidNav?:    boolean;
}

const {
  title       = SITE.name,
  description = SITE.tagline,
  image       = '/favicon.svg',
  type        = 'website',
  solidNav    = false,
} = Astro.props;

const baseUrl   = Astro.site ?? new URL('https://voidhaus.vercel.app');
const fullTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, baseUrl).href;
const ogImage   = image.startsWith('http') ? image : new URL(image, baseUrl).href;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#faf9f7" />
    <link rel="icon"             href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="canonical"        href={canonical} />
    <link rel="sitemap"          href="/sitemap-index.xml" />
    <Font cssVariable="--font-sans"  preload />
    <Font cssVariable="--font-serif" preload />
    <ClientRouter />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots"      content="index, follow" />

    <meta property="og:type"        content={type} />
    <meta property="og:site_name"   content={SITE.name} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:locale"      content="en_US" />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ClothingStore',
      name: SITE.name,
      description: SITE.tagline,
      url: canonical,
      logo: new URL('/favicon.svg', baseUrl).href,
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.address[0],
        addressLocality:  SITE.address[1].split(',')[0].trim(),
        addressCountry:   SITE.addressCountry,
      },
      contactPoint: {
        '@type': 'ContactPoint',
        email: SITE.email.studio,
        contactType: 'customer service',
      },
    })} />

    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>

  <body>
    <div class="cursor" id="js-cursor" aria-hidden="true"></div>
    <Nav client:load solidNav={solidNav} />
    <Cart client:load />

    <main id="main">
      <slot />
    </main>

    <script>
      // Custom cursor — re-query each frame so view transitions don't break the reference
      if (window.matchMedia('(hover: hover)').matches) {
        let mx = -100, my = -100;
        document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });
        document.addEventListener('mousedown', () => document.getElementById('js-cursor')?.classList.add('click'));
        document.addEventListener('mouseup',   () => document.getElementById('js-cursor')?.classList.remove('click'));
        document.addEventListener('mouseover', e => {
          const t = (e.target as Element).closest('a, button, [role="button"]');
          document.getElementById('js-cursor')?.classList.toggle('hover', !!t);
        });
        (function loop() {
          document.getElementById('js-cursor')?.style.setProperty('transform', `translate(calc(${mx}px - 50%), calc(${my}px - 50%))`);
          requestAnimationFrame(loop);
        })();
      }

      // Page entry ceremony — brief black overlay that fades out
      const veil = document.createElement('div');
      veil.style.cssText = 'position:fixed;inset:0;background:#1a1816;z-index:10000;pointer-events:none;transition:opacity 0.8s cubic-bezier(0.16,1,0.3,1)';
      document.body.prepend(veil);
      requestAnimationFrame(() => requestAnimationFrame(() => { veil.style.opacity = '0'; }));
      veil.addEventListener('transitionend', () => veil.remove(), { once: true });

      document.getElementById('nl-form')?.addEventListener('submit', e => {
        e.preventDefault();
        const form  = e.target as HTMLFormElement;
        const input = form.querySelector<HTMLInputElement>('.nl-input');
        const btn   = form.querySelector<HTMLButtonElement>('.nl-btn');
        if (!input || !btn || !input.value.includes('@')) { input?.focus(); return; }
        btn.textContent = 'Subscribed ✓';
        btn.classList.add('subscribed');
        input.value    = '';
        input.disabled = true;
        btn.disabled   = true;
      });
    </script>

    <footer class="site-footer">
      <div class="newsletter wrap">
        <div class="nl-inner">
          <div class="nl-left">
            <span class="label muted">Newsletter</span>
            <p class="nl-text">Dispatches from the atelier. Infrequent. Worth reading.</p>
          </div>
          <form class="nl-form" id="nl-form" novalidate>
            <input
              class="nl-input"
              type="email"
              name="email"
              placeholder="your@email.com"
              autocomplete="email"
              aria-label="Email address for newsletter"
              required
            />
            <button class="nl-btn label" type="submit">Subscribe</button>
          </form>
        </div>
      </div>

      <div class="wrap footer-bottom">
        <div class="rule"></div>
        <div class="footer-inner">
          <span class="label muted">© {new Date().getFullYear()} {SITE.name}</span>
          <nav class="footer-links" aria-label="Legal navigation">
            <a href="/stockists" class="label muted muted-link">Stockists</a>
            <a href="/privacy"   class="label muted muted-link">Privacy</a>
            <a href="/terms"     class="label muted muted-link">Terms</a>
          </nav>
          <span class="label muted footer-cities">{SITE.ateliers.map(a => a.city).join(' · ')}</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-footer { border-top: 1px solid var(--color-rule); margin-top: var(--space-3xl); }

  .newsletter { padding-block: var(--space-2xl); border-bottom: 1px solid var(--color-rule); }
  .nl-inner   { display: flex; align-items: center; justify-content: space-between; gap: var(--space-xl); flex-wrap: wrap; }
  .nl-left    { display: flex; flex-direction: column; gap: var(--space-xs); }
  .nl-text    { font-size: var(--text-sm); font-variation-settings: var(--font-weight-normal); color: var(--color-soft); max-width: 32ch; }
  .nl-form    { display: flex; border: 1px solid var(--color-rule); flex-shrink: 0; }
  .nl-input {
    background: none; border: none;
    color: var(--color-ink); font-family: var(--font-sans);
    font-variation-settings: var(--font-weight-normal);
    font-size: max(16px, 0.8125rem);
    padding: var(--space-sm) var(--space-md); outline: none; width: 220px;
  }
  .nl-input::placeholder { color: var(--color-mid); }
  .nl-btn {
    background: none; border: none; border-left: 1px solid var(--color-rule);
    color: var(--color-ink); opacity: var(--opacity-secondary); padding: var(--space-sm) var(--space-md);
    white-space: nowrap; transition: opacity var(--duration-fast), background var(--duration-fast);
  }
  .nl-btn:hover, .nl-btn.subscribed { opacity: 1; background: var(--color-off); }
  @media (max-width: 640px) { .nl-form { width: 100%; } .nl-input { flex: 1; width: auto; } }

  .footer-bottom { padding-block: 1.5rem 2rem; }
  .footer-inner {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: var(--space-sm); padding-top: var(--space-lg);
  }
  .footer-links  { display: flex; gap: var(--space-lg); align-items: center; }
  .footer-cities { display: none; }
  @media (min-width: 640px) { .footer-cities { display: block; } }
</style>
