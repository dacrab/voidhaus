---
import '@styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Nav from '@components/Nav.svelte';
import Cart from '@components/Cart.svelte';
import { SITE } from '@data/site';

interface Props {
  title?:       string;
  description?: string;
  image?:       string;
  type?:        'website' | 'product';
  solidNav?:    boolean;
}

const {
  title       = SITE.name,
  description = SITE.tagline,
  image       = '/favicon.svg',
  type        = 'website',
  solidNav    = false,
} = Astro.props;

const baseUrl   = Astro.site ?? new URL('https://voidhaus.vercel.app');
const fullTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, baseUrl).href;
const ogImage   = image.startsWith('http') ? image : new URL(image, baseUrl).href;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8f6f2" />
    <link rel="icon"             href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="canonical"        href={canonical} />
    <link rel="sitemap"          href="/sitemap-index.xml" />
    <link rel="manifest"         href="/manifest.json" />
    <Font cssVariable="--font-sans"  preload />
    <Font cssVariable="--font-serif" preload />
    <ClientRouter />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots"      content="index, follow" />

    <meta property="og:type"        content={type} />
    <meta property="og:site_name"   content={SITE.name} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:locale"      content="en_US" />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ClothingStore',
      name: SITE.name,
      description: SITE.tagline,
      url: canonical,
      logo: new URL('/favicon.svg', baseUrl).href,
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.address[0],
        addressLocality:  SITE.address[1].split(',')[0].trim(),
        addressCountry:   SITE.addressCountry,
      },
      contactPoint: {
        '@type': 'ContactPoint',
        email: SITE.email.studio,
        contactType: 'customer service',
      },
    })} />

    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <script is:inline define:vars={{ convexUrl: import.meta.env.PUBLIC_CONVEX_URL || '' }}>window.__CONVEX_URL__ = convexUrl;</script>
  </head>

  <body>
    <div id="js-veil" aria-hidden="true">
      <span class="veil-mark">VOIDHAUS</span>
    </div>
    <div class="cursor" id="js-cursor" aria-hidden="true"></div>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[10000] focus:bg-[var(--color-white)] focus:px-md focus:py-sm focus:text-[var(--color-ink)] focus:border focus:border-[var(--color-ink)]">Skip to content</a>
    <Nav client:load solidNav={solidNav} />
    <Cart client:load />

    <main id="main">
      <slot />
    </main>

    <script>
      import { initScrollLifecycle } from '@lib/animate';

      // One-time setup — persists across view transitions.
      initScrollLifecycle();

      if (window.matchMedia('(hover: hover)').matches) {
        document.documentElement.classList.add('custom-cursor-active');
        let cursor = document.getElementById('js-cursor');
        document.addEventListener('astro:after-swap', () => { cursor = document.getElementById('js-cursor'); });

        let mx = -100, my = -100, dirty = false;
        document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; dirty = true; });
        document.addEventListener('mousedown', () => cursor?.classList.add('click'));
        document.addEventListener('mouseup',   () => cursor?.classList.remove('click'));
        document.addEventListener('mouseover', e => {
          const t = (e.target as Element).closest('a, button, [role="button"]');
          cursor?.classList.toggle('hover', !!t);
          if (t) {
            const isProduct = t.closest('.pc');
            const isExternal = t instanceof HTMLAnchorElement && t.hostname !== location.hostname;
            cursor?.setAttribute('data-label', isProduct ? 'View' : isExternal ? 'Open' : '');
          } else {
            cursor?.removeAttribute('data-label');
          }
        });
        (function loop() {
          if (dirty) {
            cursor?.style.setProperty('transform', `translate(calc(${mx}px - 50%), calc(${my}px - 50%))`);
            dirty = false;
          }
          requestAnimationFrame(loop);
        })();
      }

      // Per-page setup — re-runs after every view transition.
      function setupPage() {
        const veil = document.getElementById('js-veil');
        if (veil) {
          if (document.documentElement.hasAttribute('data-astro-transition')) {
            veil.remove();
          } else {
            const mark = veil.querySelector('.veil-mark') as HTMLElement | null;
            if (mark) {
              mark.style.opacity = '1';
              setTimeout(() => {
                mark.style.opacity = '0';
                mark.style.transform = 'scale(0.92)';
                setTimeout(() => {
                  veil.classList.add('out');
                  veil.addEventListener('transitionend', () => veil.remove(), { once: true });
                }, 400);
              }, 800);
            } else {
              requestAnimationFrame(() => requestAnimationFrame(() => veil.classList.add('out')));
              veil.addEventListener('transitionend', () => veil.remove(), { once: true });
            }
          }
        }

        document.getElementById('nl-form')?.addEventListener('submit', e => {
          e.preventDefault();
          const form  = e.target as HTMLFormElement;
          const input = form.querySelector<HTMLInputElement>('.nl-input');
          const btn   = form.querySelector<HTMLButtonElement>('.nl-btn');
          if (!input || !btn || !input.value.includes('@')) { input?.focus(); return; }
          btn.textContent = 'Subscribed ✓';
          btn.classList.add('subscribed');
          input.value    = '';
          input.disabled = true;
          btn.disabled   = true;
        });
      }

      document.addEventListener('astro:page-load', setupPage);
    </script>

    <footer class="border-t border-[var(--color-rule)] mt-3xl">
      <div class="wrap py-2xl border-b border-[var(--color-rule)]">
        <div class="flex items-center justify-between gap-xl flex-wrap">
          <div class="flex flex-col gap-xs">
            <span class="label muted">Newsletter</span>
            <p class="text-sm fw-normal text-[var(--color-soft)] max-w-[32ch]">Dispatches from the atelier. Infrequent. Worth reading.</p>
          </div>
          <form class="nl-form flex border border-[var(--color-rule)] shrink-0 max-sm:w-full" id="nl-form" novalidate>
            <input
              class="nl-input bg-transparent border-none text-[var(--color-ink)] fw-normal px-md py-sm outline-none w-[220px] max-sm:flex-1 max-sm:w-auto placeholder:text-[var(--color-mid)]"
              style="font-size:max(16px,0.8125rem)"
              type="email" name="email" placeholder="your@email.com"
              autocomplete="email" aria-label="Email address for newsletter" required
            />
            <button
              class="nl-btn label bg-transparent border-none border-l border-[var(--color-rule)] text-[var(--color-ink)] opacity-[var(--op-secondary)] px-md py-md whitespace-nowrap transition-[opacity,background] duration-[var(--duration-fast)] hover:opacity-100 hover:bg-[var(--color-off)] [&.subscribed]:opacity-100 [&.subscribed]:bg-[var(--color-off)]"
              type="submit">Subscribe</button>
          </form>
        </div>
      </div>

      <div class="wrap py-6 pb-8">
        <div class="rule"></div>
        <div class="flex items-center justify-between flex-wrap gap-sm pt-lg">
          <span class="label muted">© {new Date().getFullYear()} {SITE.name}</span>
          <nav class="flex gap-lg items-center" aria-label="Legal navigation">
            <a href="/stockists" class="label muted muted-link" style="padding-block:0.5rem">Stockists</a>
            <a href="/privacy"   class="label muted muted-link" style="padding-block:0.5rem">Privacy</a>
            <a href="/terms"     class="label muted muted-link" style="padding-block:0.5rem">Terms</a>
          </nav>
          <span class="label muted hidden sm:block">{SITE.ateliers.map(a => a.city).join(' · ')}</span>
        </div>
      </div>
    </footer>
  <Analytics />
  <SpeedInsights />
  <script is:inline>
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');
  </script>
  </body>
</html>
