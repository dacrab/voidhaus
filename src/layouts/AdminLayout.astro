---
interface Props {
  title: string;
  active: 'dashboard' | 'products' | 'orders' | 'coupons' | 'messages';
}
const { title, active } = Astro.props;

const links = [
  { href: '/admin', label: 'Dashboard', id: 'dashboard' },
  { href: '/admin/products', label: 'Products', id: 'products' },
  { href: '/admin/orders', label: 'Orders', id: 'orders' },
  { href: '/admin/coupons', label: 'Coupons', id: 'coupons' },
  { href: '/admin/messages', label: 'Messages', id: 'messages' },
] as const;
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
  <style>
    *, *::before, *::after { margin: 0; box-sizing: border-box; }
    :root {
      --admin-sidebar: 240px;
      --admin-bg: #fafafa;
      --admin-ink: #1c1b19;
      --admin-muted: #6b7280;
      --admin-rule: #e5e5e5;
      --admin-card: #fff;
      --admin-radius: 8px;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      background: var(--admin-bg); color: var(--admin-ink);
      line-height: 1.5; -webkit-font-smoothing: antialiased;
    }
    .admin-shell {
      display: grid; grid-template-columns: var(--admin-sidebar) 1fr;
      min-height: 100vh; width: 100%;
    }
    .admin-sidebar {
      background: var(--admin-ink); color: #fff;
      padding: 2rem 1.25rem;
      display: flex; flex-direction: column; gap: 2rem;
      position: fixed; top: 0; left: 0; bottom: 0;
      width: var(--admin-sidebar); overflow-y: auto;
    }
    .admin-brand {
      font-size: 0.65rem; letter-spacing: 0.15em;
      text-transform: uppercase; opacity: 0.5;
    }
    .admin-nav { display: flex; flex-direction: column; gap: 2px; }
    .admin-nav a {
      color: #fff; text-decoration: none;
      font-size: 0.8rem; padding: 0.6rem 0.75rem;
      border-radius: 6px; opacity: 0.6;
      transition: opacity 0.15s, background 0.15s;
    }
    .admin-nav a:hover { opacity: 0.9; background: rgba(255,255,255,0.06); }
    .admin-nav a.active { opacity: 1; background: rgba(255,255,255,0.1); }
    .admin-content {
      margin-left: var(--admin-sidebar);
      padding: 2.5rem 3rem;
      min-height: 100vh;
      width: calc(100vw - var(--admin-sidebar));
    }
    .admin-page-title {
      font-size: 1.5rem; font-weight: 600;
      margin-bottom: 2rem; letter-spacing: -0.02em;
    }

    /* Shared admin components */
    .admin-card {
      background: var(--admin-card); border: 1px solid var(--admin-rule);
      border-radius: var(--admin-radius); padding: 1.5rem;
    }
    .admin-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
    .admin-table th {
      text-align: left; padding: 0.6rem 0.75rem;
      font-size: 0.65rem; letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--admin-muted); border-bottom: 1px solid var(--admin-rule);
      font-weight: 500;
    }
    .admin-table td {
      padding: 0.75rem; border-bottom: 1px solid var(--admin-rule);
      vertical-align: middle;
    }
    .admin-table tr:last-child td { border-bottom: none; }
    .admin-btn {
      font-size: 0.7rem; letter-spacing: 0.04em; text-transform: uppercase;
      padding: 0.4rem 0.75rem; border: 1px solid var(--admin-rule);
      background: var(--admin-card); border-radius: 4px;
      cursor: pointer; transition: background 0.15s;
      color: var(--admin-ink); text-decoration: none; display: inline-block;
    }
    .admin-btn:hover { background: var(--admin-bg); }
    .admin-btn-primary {
      background: var(--admin-ink); color: #fff; border-color: var(--admin-ink);
    }
    .admin-btn-primary:hover { opacity: 0.85; background: var(--admin-ink); }
    .admin-btn-danger { color: #dc2626; border-color: #fecaca; }
    .admin-btn-danger:hover { background: #fef2f2; }
    .status-paid { color: #16a34a; }
    .status-pending { color: #ca8a04; }
    .status-shipped { color: #2563eb; }
    .status-delivered { color: #6b7280; }
    .muted { color: var(--admin-muted); }
  </style>
</head>
<body>
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <span class="admin-brand">VOIDHAUS Admin</span>
      <nav class="admin-nav">
        {links.map(l => (
          <a href={l.href} class:list={[{ active: active === l.id }]}>{l.label}</a>
        ))}
      </nav>
    </aside>
    <main class="admin-content">
      <h1 class="admin-page-title">{title.replace(' — Admin — VOIDHAUS', '')}</h1>
      <slot />
    </main>
  </div>
</body>
</html>
