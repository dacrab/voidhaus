---
import '@styles/admin.css';

interface Props {
  title: string;
  active: 'dashboard' | 'products' | 'orders' | 'coupons' | 'messages';
}
const { title, active } = Astro.props;

const links = [
  { href: '/admin', label: 'Dashboard', id: 'dashboard' },
  { href: '/admin/products', label: 'Products', id: 'products' },
  { href: '/admin/orders', label: 'Orders', id: 'orders' },
  { href: '/admin/coupons', label: 'Coupons', id: 'coupons' },
  { href: '/admin/messages', label: 'Messages', id: 'messages' },
] as const;
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>{title} — Admin — VOIDHAUS</title>
</head>
<body class="m-0 bg-zinc-50 text-zinc-900 font-sans antialiased">
  <div class="grid grid-cols-[240px_1fr] min-h-screen">
    <aside class="fixed top-0 left-0 bottom-0 w-[240px] bg-zinc-900 text-white p-6 flex flex-col gap-8 overflow-y-auto z-10">
      <span class="text-[0.6rem] tracking-[0.18em] uppercase opacity-40 font-medium">VOIDHAUS Admin</span>
      <nav class="flex flex-col gap-0.5">
        {links.map(l => (
          <a
            href={l.href}
            class:list={[
              "text-[0.85rem] px-3 py-2 rounded-md no-underline transition-all",
              active === l.id
                ? "bg-white/10 text-white opacity-100"
                : "text-white opacity-50 hover:opacity-80 hover:bg-white/5"
            ]}
          >{l.label}</a>
        ))}
      </nav>
    </aside>

    <main class="col-start-2 p-10">
      <h1 class="text-2xl font-semibold tracking-tight mb-8">{title}</h1>
      <slot />
    </main>
  </div>
</body>
</html>
