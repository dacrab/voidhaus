# =============================================================================
# Secrets are managed by Doppler (https://dashboard.doppler.com/workplace/projects)
# Run `doppler setup` to link this repo if not already configured.
# Run `doppler run -- <command>` to inject secrets automatically.
#
# If you don't use Doppler, copy this file to .env and fill in the values below.
# =============================================================================

# Convex (database/backend). CONVEX_SITE_URL (*.convex.site) hosts the HTTP
# actions, e.g. the internal /fulfill endpoint the Stripe webhook calls.
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site

# Stripe
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Shared secret between the SvelteKit webhook route and the Convex /fulfill
# httpAction. Also set it (and ADMIN_TOKEN) as Convex deployment env vars.
INTERNAL_WEBHOOK_SECRET=your-internal-webhook-secret

# Admin token required by the seed mutations in convex/seed.ts.
ADMIN_TOKEN=your-admin-access-token

# Resend (email)
RESEND_API_KEY=re_your-api-key

# Vercel deploy hook, called by convex/emails.ts after product changes to
# trigger a rebuild. Convex deployment env var (not read by SvelteKit).
VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/your-hook-id

# Sentry (optional — disable by leaving unset)
# PUBLIC_ prefix exposes the DSN to the client for browser error reporting.
PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token
